{% extends "assets/template.twig" %}

{% block content %}

{# ── Executive KPI Row ── #}
<div class="row" id="analyticsKPIs">
    <div class="col-lg-3 col-md-6 col-12">
        <div class="info-box bg-gradient-primary">
            <span class="info-box-icon"><i class="fas fa-chart-line"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Umsatz (MTD)</span>
                <span class="info-box-number" id="kpiRevenueMTD">-</span>
                <div class="progress"><div class="progress-bar" id="kpiMTDBar" style="width: 0%"></div></div>
                <span class="progress-description" id="kpiMTDChange">Lade...</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-12">
        <div class="info-box bg-gradient-success">
            <span class="info-box-icon"><i class="fas fa-euro-sign"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Umsatz (YTD)</span>
                <span class="info-box-number" id="kpiRevenueYTD">-</span>
                <div class="progress"><div class="progress-bar" id="kpiYTDBar" style="width: 0%"></div></div>
                <span class="progress-description" id="kpiYTDChange">Lade...</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-12">
        <div class="info-box bg-gradient-warning">
            <span class="info-box-icon"><i class="fas fa-file-invoice"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Offene Rechnungen</span>
                <span class="info-box-number" id="kpiOpenInvoices">-</span>
                <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                <span class="progress-description" id="kpiOpenCount">-</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-12">
        <div class="info-box bg-gradient-danger">
            <span class="info-box-icon"><i class="fas fa-exclamation-circle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Ueberfaellig</span>
                <span class="info-box-number" id="kpiOverdue">-</span>
                <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                <span class="progress-description">Sofortige Aufmerksamkeit</span>
            </div>
        </div>
    </div>
</div>

{# ── Charts Row: Revenue Trend + A/R Aging ── #}
<div class="row">
    <div class="col-lg-8">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-area"></i> Umsatzentwicklung (30 Tage)</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" id="toggleMonthlyChart" title="12-Monats-Ansicht">
                        <i class="fas fa-calendar-alt"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="revenueTrendChart" height="280"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-warning card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-layer-group"></i> Forderungen (Aging)</h3>
            </div>
            <div class="card-body">
                <canvas id="arAgingChart" height="280"></canvas>
            </div>
        </div>
    </div>
</div>

{# ── Charts Row: Cash Flow + Top Kunden + Asset Utilization ── #}
<div class="row">
    <div class="col-lg-4">
        <div class="card card-success card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-money-bill-wave"></i> Cash Flow Prognose</h3>
            </div>
            <div class="card-body">
                <canvas id="cashFlowChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-info card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-users"></i> Top 5 Kunden (YTD)</h3>
            </div>
            <div class="card-body">
                <canvas id="topClientsChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-secondary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-boxes"></i> Asset Nutzung (Top 10)</h3>
            </div>
            <div class="card-body">
                <canvas id="assetUtilChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

{# ── Quick Stats Row (Projekte) ── #}
<div class="row" id="dashboardStats">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="statTodayProjects">-</h3>
                <p>{{ t('today_projects') }}</p>
            </div>
            <div class="icon"><i class="fas fa-calendar-day"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3 id="statOverdueReturns">-</h3>
                <p>{{ t('overdue_returns') }}</p>
            </div>
            <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3 id="statUnpaidProjects">-</h3>
                <p>{{ t('unpaid_projects') }}</p>
            </div>
            <div class="icon"><i class="fas fa-euro-sign"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3 id="statActiveProjects">-</h3>
                <p>{{ t('active_projects') }}</p>
            </div>
            <div class="icon"><i class="fas fa-folder-open"></i></div>
        </div>
    </div>
</div>

<div class="row">
    {# ── Today's Projects ── #}
    <div class="col-lg-6">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-calendar-day"></i> {{ t('today_projects') }}</h3>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="todayLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>{{ t('project') }}</th>
                            <th>{{ t('client') }}</th>
                            <th>{{ t('status') }}</th>
                            <th>{{ t('time') }}</th>
                        </tr>
                    </thead>
                    <tbody id="todayProjectsBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Overdue Returns ── #}
    <div class="col-lg-6">
        <div class="card card-danger card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-exclamation-triangle"></i> {{ t('overdue_returns') }}</h3>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="overdueLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>{{ t('project') }}</th>
                            <th>{{ t('client') }}</th>
                            <th>{{ t('due_date') }}</th>
                            <th>{{ t('days_overdue') }}</th>
                        </tr>
                    </thead>
                    <tbody id="overdueReturnsBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    {# ── Dunning Suggestions ── #}
    <div class="col-lg-6">
        <div class="card card-warning card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-bell"></i> {{ t('dunning_suggestions') }}</h3>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="dunningLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>{{ t('project') }}</th>
                            <th>{{ t('client') }}</th>
                            <th>{{ t('days_overdue') }}</th>
                            <th>{{ t('suggested_action') }}</th>
                        </tr>
                    </thead>
                    <tbody id="dunningSuggestionsBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Unpaid Projects ── #}
    <div class="col-lg-6">
        <div class="card card-info card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-euro-sign"></i> {{ t('unpaid_projects') }}</h3>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="unpaidLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>{{ t('project') }}</th>
                            <th>{{ t('client') }}</th>
                            <th>{{ t('project_end') }}</th>
                            <th>{{ t('amount') }}</th>
                        </tr>
                    </thead>
                    <tbody id="unpaidProjectsBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# ── Ablaufende Angebote & Ausstehende Freigaben ── #}
<div class="row">
    <div class="col-lg-6">
        <div class="card card-outline card-danger collapsed-card" id="expiringQuotesCard" style="display:none;">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-hourglass-end"></i> Angebote laufen ab</h3>
                <div class="card-tools">
                    <span class="badge badge-danger" id="expiringQuotesCount"></span>
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-plus"></i></button>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped">
                    <thead><tr><th>Angebot</th><th>Projekt</th><th>Kunde</th><th>Ablauf</th><th>Betrag</th></tr></thead>
                    <tbody id="expiringQuotesBody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card card-outline card-info collapsed-card" id="pendingApprovalsCard" style="display:none;">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-share-alt"></i> Ausstehende Freigaben</h3>
                <div class="card-tools">
                    <span class="badge badge-info" id="pendingApprovalsCount"></span>
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-plus"></i></button>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-striped">
                    <thead><tr><th>Dokument</th><th>Kunde</th><th>Erstellt</th><th>Ablauf</th></tr></thead>
                    <tbody id="pendingApprovalsBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# ── Next 7 Days Timeline ── #}
<div class="row">
    <div class="col-12">
        <div class="card card-outline card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-calendar-week"></i> {{ t('next_7_days') }}</h3>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="weekLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>{{ t('project') }}</th>
                            <th>{{ t('client') }}</th>
                            <th>{{ t('status') }}</th>
                            <th>{{ t('project_delivery_start') }}</th>
                            <th>{{ t('project_delivery_end') }}</th>
                            <th>{{ t('project_start') }}</th>
                            <th>{{ t('project_end') }}</th>
                        </tr>
                    </thead>
                    <tbody id="weekProjectsBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# ── Original Widgets + Calendar below ── #}
{% if WIDGETS is defined and WIDGETS is not null %}
<div class="card-columns">
    {% set widgets = WIDGETS.getAllDashboard() %}
    {% for widget in widgets %}
        {% embed 'assets/widgets/' ~ widget ~ '.twig' %}
        {% endembed %}
    {% endfor %}
    {% embed 'assets/widgets/statsWidgetsJS.twig' %}{% endembed %}
</div>
<div class="row">
    <div class="col-md-4 offset-md-4 col-sm-6 offset-sm-3 col-xs-12" id="noWidgetsBox" {% if widgets|length > 0 %}style="display:none;"{% endif %}>
        <div class="card">
            <div class="card-body" style="text-align: center;">
                <i>{{ t('no_widgets') }}</i>
                <br/><br/><a class="btn btn-default btn-sm" href="{{ CONFIG.ROOTURL }}/instances/stats.php">{{ t('add') }}</a>
            </div>
        </div>
    </div>
{% else %}
<div class="row">
{% endif %}
    <div class="col-lg-12">
        <div class="card card-primary">
            {% embed 'assets/widgets/calendar.twig' %}
            {% endembed %}
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    var actionLabels = {
        'payment_reminder': '{{ t("payment_reminder") }}',
        'first_dunning': '{{ t("first_dunning") }}',
        'second_dunning': '{{ t("second_dunning") }}',
        'final_dunning': '{{ t("final_dunning") }}'
    };
    var actionBadges = {
        'payment_reminder': 'info',
        'first_dunning': 'warning',
        'second_dunning': 'danger',
        'final_dunning': 'dark'
    };

    function formatDate(d) {
        if (!d) return '-';
        var dt = new Date(d);
        return ('0'+dt.getDate()).slice(-2) + '.' + ('0'+(dt.getMonth()+1)).slice(-2) + '.' + dt.getFullYear();
    }
    function formatDateTime(d) {
        if (!d) return '-';
        var dt = new Date(d);
        return ('0'+dt.getDate()).slice(-2) + '.' + ('0'+(dt.getMonth()+1)).slice(-2) + '.' + dt.getFullYear() + ' ' + ('0'+dt.getHours()).slice(-2) + ':' + ('0'+dt.getMinutes()).slice(-2);
    }
    function formatMoney(val) {
        return parseFloat(val || 0).toFixed(2).replace('.', ',') + ' \u20AC';
    }
    function daysAgo(d) {
        if (!d) return 0;
        return Math.floor((Date.now() - new Date(d).getTime()) / 86400000);
    }

    ajaxcall('dashboard/overview.php', {}, function(data) {
        if (!data.response) return;
        var r = data.response;

        // Stats
        $('#statTodayProjects').text(r.today_projects ? r.today_projects.length : 0);
        $('#statOverdueReturns').text(r.overdue_returns ? r.overdue_returns.length : 0);
        $('#statUnpaidProjects').text(r.unpaid_projects ? r.unpaid_projects.length : 0);
        $('#statActiveProjects').text(r.stats ? r.stats.active_projects : 0);

        // Today's projects
        var html = '';
        if (r.today_projects && r.today_projects.length > 0) {
            r.today_projects.forEach(function(p) {
                html += '<tr>';
                html += '<td><a href="{{ CONFIG.ROOTURL }}/project/?id=' + p.projects_id + '">' + p.projects_name + '</a></td>';
                html += '<td>' + (p.clients_name || '-') + '</td>';
                html += '<td><span class="badge" style="background-color:' + (p.projectsStatuses_backgroundColour || '#6c757d') + ';color:' + (p.projectsStatuses_foregroundColour || '#fff') + '">' + (p.projectsStatuses_name || '-') + '</span></td>';
                html += '<td>' + formatDateTime(p.projects_dates_use_start) + '</td>';
                html += '</tr>';
            });
        } else {
            html = '<tr><td colspan="4" class="text-center text-muted">{{ t("no_projects_today") }}</td></tr>';
        }
        $('#todayProjectsBody').html(html);
        $('#todayLoading').hide();

        // Overdue returns
        html = '';
        if (r.overdue_returns && r.overdue_returns.length > 0) {
            r.overdue_returns.forEach(function(p) {
                var days = daysAgo(p.projects_dates_deliver_end);
                html += '<tr>';
                html += '<td><a href="{{ CONFIG.ROOTURL }}/project/?id=' + p.projects_id + '">' + p.projects_name + '</a></td>';
                html += '<td>' + (p.clients_name || '-') + '</td>';
                html += '<td>' + formatDate(p.projects_dates_deliver_end) + '</td>';
                html += '<td><span class="badge badge-' + (days > 7 ? 'danger' : 'warning') + '">' + days + ' {{ t("days") }}</span></td>';
                html += '</tr>';
            });
        } else {
            html = '<tr><td colspan="4" class="text-center text-muted">{{ t("no_overdue_returns") }}</td></tr>';
        }
        $('#overdueReturnsBody').html(html);
        $('#overdueLoading').hide();

        // Dunning suggestions
        html = '';
        if (r.dunning_suggestions && r.dunning_suggestions.length > 0) {
            r.dunning_suggestions.forEach(function(s) {
                html += '<tr>';
                html += '<td><a href="{{ CONFIG.ROOTURL }}/project/?id=' + s.projects_id + '">' + s.projects_name + '</a></td>';
                html += '<td>' + (s.clients_name || '-') + '</td>';
                html += '<td><span class="badge badge-warning">' + s.days_overdue + ' {{ t("days") }}</span></td>';
                html += '<td><span class="badge badge-' + (actionBadges[s.suggested_action] || 'secondary') + '">' + (actionLabels[s.suggested_action] || '-') + '</span></td>';
                html += '</tr>';
            });
        } else {
            html = '<tr><td colspan="4" class="text-center text-muted">{{ t("no_dunning_suggestions") }}</td></tr>';
        }
        $('#dunningSuggestionsBody').html(html);
        $('#dunningLoading').hide();

        // Unpaid projects
        html = '';
        if (r.unpaid_projects && r.unpaid_projects.length > 0) {
            r.unpaid_projects.forEach(function(p) {
                html += '<tr>';
                html += '<td><a href="{{ CONFIG.ROOTURL }}/project/?id=' + p.projects_id + '">' + p.projects_name + '</a></td>';
                html += '<td>' + (p.clients_name || '-') + '</td>';
                html += '<td>' + formatDate(p.projects_dates_use_end) + '</td>';
                html += '<td>' + formatMoney(p.projectsFinanceCache_grandTotal / 100) + '</td>';
                html += '</tr>';
            });
        } else {
            html = '<tr><td colspan="4" class="text-center text-muted">{{ t("no_unpaid_projects") }}</td></tr>';
        }
        $('#unpaidProjectsBody').html(html);
        $('#unpaidLoading').hide();

        // Next 7 days
        html = '';
        if (r.upcoming_projects && r.upcoming_projects.length > 0) {
            r.upcoming_projects.forEach(function(p) {
                html += '<tr>';
                html += '<td><a href="{{ CONFIG.ROOTURL }}/project/?id=' + p.projects_id + '">' + p.projects_name + '</a></td>';
                html += '<td>' + (p.clients_name || '-') + '</td>';
                html += '<td><span class="badge" style="background-color:' + (p.projectsStatuses_backgroundColour || '#6c757d') + ';color:' + (p.projectsStatuses_foregroundColour || '#fff') + '">' + (p.projectsStatuses_name || '-') + '</span></td>';
                html += '<td>' + formatDateTime(p.projects_dates_deliver_start) + '</td>';
                html += '<td>' + formatDateTime(p.projects_dates_deliver_end) + '</td>';
                html += '<td>' + formatDateTime(p.projects_dates_use_start) + '</td>';
                html += '<td>' + formatDateTime(p.projects_dates_use_end) + '</td>';
                html += '</tr>';
            });
        } else {
            html = '<tr><td colspan="7" class="text-center text-muted">{{ t("no_upcoming_projects") }}</td></tr>';
        }
        $('#weekProjectsBody').html(html);
        $('#weekLoading').hide();

        // Expiring quotes
        if (r.expiring_quotes && r.expiring_quotes.length > 0) {
            html = '';
            r.expiring_quotes.forEach(function(q) {
                var badgeClass = q.days_left <= 2 ? 'danger' : 'warning';
                html += '<tr>';
                html += '<td>' + (q.doc_number || '-') + '</td>';
                html += '<td><a href="{{ CONFIG.ROOTURL }}/project/?id=' + q.projects_id + '">' + (q.projects_name || '-') + '</a></td>';
                html += '<td>' + (q.clients_name || '-') + '</td>';
                html += '<td><span class="badge badge-' + badgeClass + '">' + q.days_left + ' Tage</span></td>';
                html += '<td>' + formatMoney(q.gross_amount) + '</td>';
                html += '</tr>';
            });
            $('#expiringQuotesBody').html(html);
            $('#expiringQuotesCount').text(r.expiring_quotes.length);
            $('#expiringQuotesCard').show().find('.collapsed-card').removeClass('collapsed-card');
        }

        // Pending approvals
        if (r.pending_approvals && r.pending_approvals.length > 0) {
            html = '';
            r.pending_approvals.forEach(function(a) {
                html += '<tr>';
                html += '<td>' + (a.doc_number || '-') + '</td>';
                html += '<td>' + (a.client_name || '-') + '</td>';
                html += '<td>' + formatDate(a.created_at) + '</td>';
                html += '<td>' + formatDate(a.expires_at) + '</td>';
                html += '</tr>';
            });
            $('#pendingApprovalsBody').html(html);
            $('#pendingApprovalsCount').text(r.pending_approvals.length);
            $('#pendingApprovalsCard').show().find('.collapsed-card').removeClass('collapsed-card');
        }

    }, false);

    // ── Executive Dashboard: Analytics Charts ──
    var chartScript = document.createElement('script');
    chartScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js';
    chartScript.onload = function() {
        loadAnalyticsDashboard();
    };
    document.head.appendChild(chartScript);

    function formatEuro(val) {
        return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(val);
    }
    function formatEuroShort(val) {
        if (val >= 1000000) return (val / 1000000).toFixed(1) + ' Mio \u20AC';
        if (val >= 1000) return (val / 1000).toFixed(1) + 'k \u20AC';
        return val.toFixed(0) + ' \u20AC';
    }

    var analyticsCharts = {};
    var analyticsData = null;
    var showMonthly = false;

    function loadAnalyticsDashboard() {
        ajaxcall('dashboard/analytics.php', {}, function(resp) {
            if (!resp.response) {
                $('#analyticsKPIs .info-box-number').text('n/a');
                return;
            }
            analyticsData = resp.response;
            renderKPIs(analyticsData.kpis);
            renderRevenueTrend(analyticsData.revenue_trend);
            renderArAging(analyticsData.ar_aging);
            renderCashFlow(analyticsData.cashflow_forecast);
            renderTopClients(analyticsData.top_clients);
            renderAssetUtil(analyticsData.asset_utilization);
        }, false);
    }

    function renderKPIs(kpis) {
        if (!kpis) return;
        $('#kpiRevenueMTD').text(formatEuro(kpis.revenue_mtd || 0));
        $('#kpiRevenueYTD').text(formatEuro(kpis.revenue_ytd || 0));
        $('#kpiOpenInvoices').text(formatEuro(kpis.open_invoices_total || 0));
        $('#kpiOverdue').text(formatEuro(kpis.overdue_total || 0));

        var mtdChange = kpis.revenue_mtd_change || 0;
        var ytdChange = kpis.revenue_ytd_change || 0;
        var mtdIcon = mtdChange >= 0 ? '<i class="fas fa-arrow-up"></i>' : '<i class="fas fa-arrow-down"></i>';
        var ytdIcon = ytdChange >= 0 ? '<i class="fas fa-arrow-up"></i>' : '<i class="fas fa-arrow-down"></i>';
        $('#kpiMTDChange').html(mtdIcon + ' ' + mtdChange.toFixed(1) + '% gg. Vormonat');
        $('#kpiYTDChange').html(ytdIcon + ' ' + ytdChange.toFixed(1) + '% gg. Vorjahr');
        $('#kpiOpenCount').text((kpis.open_invoices_count || 0) + ' Rechnungen offen');

        // Progress bars (visual only)
        var mtdPct = kpis.revenue_last_month > 0 ? Math.min(100, (kpis.revenue_mtd / kpis.revenue_last_month) * 100) : 50;
        $('#kpiMTDBar').css('width', mtdPct + '%');
        $('#kpiYTDBar').css('width', '60%');
    }

    function renderRevenueTrend(data) {
        if (!data || data.length === 0) return;
        var ctx = document.getElementById('revenueTrendChart').getContext('2d');
        analyticsCharts.revenueTrend = new Chart(ctx, {
            type: 'line',
            data: {
                labels: data.map(function(d) { return d.label; }),
                datasets: [{
                    label: 'Umsatz',
                    data: data.map(function(d) { return d.revenue; }),
                    borderColor: '#007bff',
                    backgroundColor: 'rgba(0,123,255,0.1)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 2,
                    pointHoverRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) { return formatEuro(ctx.parsed.y); }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: function(v) { return formatEuroShort(v); } }
                    },
                    x: {
                        ticks: { maxTicksLimit: 10 }
                    }
                }
            }
        });
    }

    function renderMonthlyRevenue(data) {
        if (!data || data.length === 0) return;
        var ctx = document.getElementById('revenueTrendChart').getContext('2d');
        analyticsCharts.revenueTrend = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(function(d) { return d.label; }),
                datasets: [{
                    label: 'Monatsumsatz',
                    data: data.map(function(d) { return d.revenue; }),
                    backgroundColor: 'rgba(0,123,255,0.7)',
                    borderColor: '#007bff',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) { return formatEuro(ctx.parsed.y); }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: function(v) { return formatEuroShort(v); } }
                    }
                }
            }
        });
    }

    // Toggle between 30-day trend and 12-month view
    $('#toggleMonthlyChart').on('click', function() {
        if (!analyticsData) return;
        showMonthly = !showMonthly;
        if (analyticsCharts.revenueTrend) {
            analyticsCharts.revenueTrend.destroy();
        }
        var header = $(this).closest('.card-header').find('.card-title');
        if (showMonthly) {
            header.html('<i class="fas fa-chart-bar"></i> Monatsumsatz (12 Monate)');
            renderMonthlyRevenue(analyticsData.monthly_revenue);
        } else {
            header.html('<i class="fas fa-chart-area"></i> Umsatzentwicklung (30 Tage)');
            renderRevenueTrend(analyticsData.revenue_trend);
        }
    });

    function renderArAging(data) {
        if (!data || data.length === 0) return;
        var colors = ['#28a745', '#ffc107', '#fd7e14', '#dc3545'];
        var ctx = document.getElementById('arAgingChart').getContext('2d');
        analyticsCharts.arAging = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: data.map(function(d) { return d.label; }),
                datasets: [{
                    data: data.map(function(d) { return d.total; }),
                    backgroundColor: colors,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { size: 11 } } },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ctx.label + ': ' + formatEuro(ctx.parsed) + ' (' + (data[ctx.dataIndex] ? data[ctx.dataIndex].count : 0) + ' Rg.)';
                            }
                        }
                    }
                }
            }
        });
    }

    function renderCashFlow(data) {
        if (!data || data.length === 0) return;
        var ctx = document.getElementById('cashFlowChart').getContext('2d');
        analyticsCharts.cashFlow = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(function(d) { return d.label; }),
                datasets: [
                    {
                        label: 'Erwartet',
                        data: data.map(function(d) { return d.expected_income; }),
                        backgroundColor: 'rgba(40,167,69,0.7)'
                    },
                    {
                        label: 'Ueberfaellig',
                        data: data.map(function(d) { return d.overdue; }),
                        backgroundColor: 'rgba(220,53,69,0.7)'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { size: 11 } } },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) { return ctx.dataset.label + ': ' + formatEuro(ctx.parsed.y); }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: function(v) { return formatEuroShort(v); } }
                    }
                }
            }
        });
    }

    function renderTopClients(data) {
        if (!data || data.length === 0) return;
        var ctx = document.getElementById('topClientsChart').getContext('2d');
        analyticsCharts.topClients = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(function(d) { return d.name.length > 20 ? d.name.substring(0, 18) + '...' : d.name; }),
                datasets: [{
                    label: 'Umsatz YTD',
                    data: data.map(function(d) { return d.revenue; }),
                    backgroundColor: ['#17a2b8', '#138496', '#0f6674', '#0b4852', '#072a30']
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) { return formatEuro(ctx.parsed.x) + ' (' + (data[ctx.dataIndex] ? data[ctx.dataIndex].invoices : 0) + ' Rg.)'; }
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: { callback: function(v) { return formatEuroShort(v); } }
                    }
                }
            }
        });
    }

    function renderAssetUtil(data) {
        if (!data || data.length === 0) return;
        var ctx = document.getElementById('assetUtilChart').getContext('2d');
        analyticsCharts.assetUtil = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(function(d) { return d.name.length > 18 ? d.name.substring(0, 16) + '...' : d.name; }),
                datasets: [{
                    label: 'Nutzungsrate %',
                    data: data.map(function(d) { return d.avg_utilization; }),
                    backgroundColor: data.map(function(d) {
                        if (d.avg_utilization >= 80) return '#28a745';
                        if (d.avg_utilization >= 50) return '#ffc107';
                        return '#dc3545';
                    }),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                var d = data[ctx.dataIndex];
                                return d ? d.avg_utilization.toFixed(1) + '% (' + d.usage_count + '/' + d.asset_count + ' Assets)' : '';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: { callback: function(v) { return v + '%'; } }
                    },
                    x: {
                        ticks: { font: { size: 10 } }
                    }
                }
            }
        });
    }
});
</script>
{% endblock %}
