{% extends "login/login_template.twig" %}
{% block content %}
    {% if googleAuthAvailable %}
    <a href="{{CONFIG.ROOTURL}}/login/oauth/google.php" class="btn btn-default btn-lg m-2 border shadow-sm"><img src="{{ CONFIG.ROOTURL}}/static-assets/img/login/google.svg" alt="" role="presentation" style="height: 1.2em; vertical-align: text-top;" /> Anmelden{% if signupEnabled %} oder Registrieren{% endif %} mit Google</a><br/>
    {% endif %}
    {% if microsoftAuthAvailable %}
    <a href="{{CONFIG.ROOTURL}}/login/oauth/microsoft.php" class="btn btn-default btn-lg m-2 border shadow-sm"><img src="{{ CONFIG.ROOTURL}}/static-assets/img/login/microsoft.svg" alt="" role="presentation" style="height: 1.2em; vertical-align: text-top;" /> Anmelden{% if signupEnabled %} oder Registrieren{% endif %} mit Microsoft</a><br/>
    {% endif %}
    {% if signupEnabled %}
    <a href="?signup" class="btn btn-default btn-lg m-2 border shadow-sm"><img src="{{ CONFIG.ROOTURL}}/static-assets/img/logoicon.png" alt="" role="presentation" style="height: 1.2em; vertical-align: text-top;" /> Neues {{ CONFIG.PROJECT_NAME }}-Konto erstellen</a>
    <p>oder</p>
    {% endif %}
    <div class="spinner-border" role="status" id="loadingOverlay" style="display: none;">
        <span class="sr-only">Laden...</span>
    </div>
    <form id="loginForm">
        <div id="errorMessageBox" class="alert alert-danger"></div>
		<input class="form-control form-control-lg" id="emailInput" autocomplete="username" placeholder="Benutzername oder E-Mail" type="text" required style="margin-top: 10px; margin-bottom: 10px;" autofocus>
        <input class="form-control form-control-lg" id="passwordInput" placeholder="Passwort" autocomplete="current-password" type="password" required style="margin-top: 10px; margin-bottom: 10px;">
		<div style="width: 100%; text-align:right;">
            <button type="button" class="btn btn-default" id="passwordResetButton">Passwort zuruecksetzen</button>
            <button class="btn btn-secondary" type="submit" value="Submit">Anmelden</button>
		</div>
	</form>
	<script>
        $("#loginForm").submit(function(e){
            e.preventDefault();
            $("#loginForm").hide();
            $("#loadingOverlay").show();
            $.ajax({
                url: "../api/login/login.php",
                type: "POST",
                dataType: 'json',
                data: {"formInput" : $("#emailInput").val(),"password": $("#passwordInput").val()},
                success: function(result) {
                    if (result.result) {
                        window.location.href = result.response.redirect;
                    } else {
                        $("#loginForm").show();
                        $("#loadingOverlay").hide();
                        $("#errorMessageBox").html(result.error.message);
                        $("#errorMessageBox").show();
                    }
                },
                error: function(){
                    $("#loginForm").show();
                    $("#loadingOverlay").hide();
                    $("#errorMessageBox").html("Bitte laden Sie die Seite neu und pruefen Sie Ihre Internetverbindung.");
                    $("#errorMessageBox").show();
                }
            });
        });
        $('#passwordResetButton').click(function(){
            if ($("#emailInput").val().length <= 0) {
                $("#errorMessageBox").html("Bitte geben Sie Ihren Benutzernamen oder Ihre E-Mail-Adresse ein, um Ihr Passwort zurueckzusetzen.");
                $("#errorMessageBox").show();
                return;
            }
            $("#errorMessageBox").hide();
            $("#loginForm").hide();
            $("#loadingOverlay").show();
            $.ajax({
                url: "../api/login/forgotPassword.php",
                type: "POST",
                dataType: 'json',
                data: {"formInput" : $("#emailInput").val()},
                success: function(result) {
                    $("#loginForm").show();
                    $("#loadingOverlay").hide();
                    if (result.result) {
                        $("#errorMessageBox").html("Falls ein Konto mit dieser E-Mail-Adresse existiert, wurde ein Link zum Zuruecksetzen des Passworts gesendet. Bitte pruefen Sie Ihren Posteingang.");
                        $("#errorMessageBox").show();
                    } else {
                        $("#errorMessageBox").html("Bitte kontaktieren Sie den Support fuer ein neues Passwort.");
                        $("#errorMessageBox").show();
                    }
                }, error: function(){
                    $("#loginForm").show();
                    $("#loadingOverlay").hide();
                    $("#errorMessageBox").html("Bitte laden Sie die Seite neu und pruefen Sie Ihre Internetverbindung.");
                    $("#errorMessageBox").show();
                }
            });

        });
	</script>
{% endblock %}
