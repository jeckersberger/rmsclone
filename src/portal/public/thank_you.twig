{% extends "layout.twig" %}

{% block title %}Thank You - {{ config.portal_title|default('Booking Portal') }}{% endblock %}

{% block content %}
<div style="max-width: 600px; margin: 3rem auto; text-align: center;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">✓</div>

    <div style="background: white; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 2rem;">
        <h1 style="margin-bottom: 0.5rem;">Inquiry Submitted</h1>
        <p style="color: #6b7280; font-size: 1.1rem; margin-bottom: 2rem;">
            Thank you for your booking inquiry!
        </p>

        <div style="background: #dcfce7; border: 1px solid #bbf7d0; border-radius: 0.5rem; padding: 1.5rem; margin-bottom: 2rem; text-align: left;">
            <h3 style="margin-bottom: 1rem;">What happens next?</h3>
            <ul style="list-style: none; padding: 0;">
                {% if config.require_admin_approval %}
                    <li style="padding: 0.5rem 0;">
                        <strong style="color: #065f46;">1.</strong> Our team will review your inquiry
                    </li>
                    <li style="padding: 0.5rem 0;">
                        <strong style="color: #065f46;">2.</strong> We'll send you a quote within 24 hours
                    </li>
                    <li style="padding: 0.5rem 0;">
                        <strong style="color: #065f46;">3.</strong> Confirm your booking and arrange payment
                    </li>
                {% else %}
                    <li style="padding: 0.5rem 0;">
                        <strong style="color: #065f46;">1.</strong> Your booking is under review
                    </li>
                    <li style="padding: 0.5rem 0;">
                        <strong style="color: #065f46;">2.</strong> We'll confirm availability and pricing
                    </li>
                    <li style="padding: 0.5rem 0;">
                        <strong style="color: #065f46;">3.</strong> Complete payment to finalize
                    </li>
                {% endif %}
            </ul>
        </div>

        <p style="color: #6b7280; margin-bottom: 2rem;">
            Inquiry ID: <code style="background: #f9fafb; padding: 0.25rem 0.75rem; border-radius: 0.25rem;">#{{ inquiry_id }}</code>
        </p>

        <p style="color: #6b7280; margin-bottom: 2rem;">
            You'll receive a confirmation email shortly. Keep this inquiry ID for your records.
        </p>

        <a href="/portal/" class="btn btn-primary" style="padding: 0.75rem 2rem;">
            Continue Shopping
        </a>
    </div>
</div>
{% endblock %}
