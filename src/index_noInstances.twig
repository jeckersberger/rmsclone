{% extends "assets/template.twig" %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-4 col-md-6 col-sm-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    Willkommen bei {{ CONFIG.PROJECT_NAME }}
                </h3>
            </div>
            <div class="card-body">
                <p>AdamRMS ist ein kostenloses, quelloffenes Verleih-Management-System</p>
                <a href="https://adam-rms.com/" class="btn btn-default" target="_blank">Mehr erfahren</a>
                <hr />
                <p>{{ CONFIG.PROJECT_NAME }} hat separate Bereiche fuer verschiedene Unternehmen. Um loszulegen, muessen Sie einem Unternehmen beitreten{% if CONFIG["NEW_INSTANCE_ENABLED"] == "Enabled" or "INSTANCES:CREATE"|serverPermissions %} oder ein neues erstellen{% endif %}.</p>
            </div>
        </div>
        {% include 'assets/templates/joinInstance.twig' %}
    </div>
    {% if CONFIG["NEW_INSTANCE_ENABLED"] == "Enabled" or "INSTANCES:CREATE"|serverPermissions %}
    <div class="col-lg-4 col-md-6 col-sm-12">      
        {% include 'assets/templates/newInstance.twig' %}
    </div>
    {% endif %}
</div>
{% endblock %}
