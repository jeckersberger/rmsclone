                sel.appendChild(optGroup);
            }
        }, false);
    }

    /**
     * TID Pairing: Ordnet eine gescannte TID einem Geraet/Artikel zu.
     * Die TID wird beim Scannen im pair_tag-Modus automatisch ins Input geschrieben.
     */
    function pairTid() {
        var tid = document.getElementById('pairTidInput').value.trim();
        var sel = document.getElementById('pairEntitySelector');

        if (!tid) { showResult('Bitte zuerst einen RFID-Tag scannen (TID fehlt)', 'warning'); return; }
        if (!sel.value) { showResult('Bitte Geraet oder Instanz auswaehlen', 'warning'); return; }

        var parts = sel.value.split(':');
        var entityType = parts[0];
        var entityId = parts[1];

        ajaxcall('rfid/scan.php', {
            action: 'pair_tid',
            entity_type: entityType,
            entity_id: entityId,
            tid: tid
        }, function(response) {
            if (response.result) {
                playSound('success');
                var label = sel.options[sel.selectedIndex].textContent;
                showResult('<i class="fas fa-check-circle"></i> TID erfolgreich zugeordnet: ' + label, 'success');
                addToHistory(tid, 'TID zugeordnet → ' + label, 'success');
                document.getElementById('pairTidInput').value = '';
                document.getElementById('pairTidStatus').innerHTML = '';
            } else {
                playSound('error');
                showResult('Fehler: ' + (response.response ? response.response.message : 'Zuordnung fehlgeschlagen'), 'error');
            }
        }, true);
    }

    function unpairTid() {
        var sel = document.getElementById('pairEntitySelector');
        if (!sel.value) { showResult('Bitte Geraet oder Instanz auswaehlen', 'warning'); return; }

        var parts = sel.value.split(':');
        var entityType = parts[0];
        var entityId = parts[1];

        ajaxcall('rfid/scan.php', {
            action: 'unpair_tid',
            entity_type: entityType,
            entity_id: entityId
        }, function(response) {
            if (response.result) {
                playSound('success');
                showResult('<i class="fas fa-check-circle"></i> TID-Zuordnung entfernt', 'success');
                addToHistory(entityType + ':' + entityId, 'TID-Zuordnung entfernt', 'info');
            } else {
                playSound('error');
                showResult('Fehler: ' + (response.response ? response.response.message : 'Entfernen fehlgeschlagen'), 'error');
            }
        }, true);
    }

    // ══════════════════════════════════════
    // Label Print Functions
    // ══════════════════════════════════════
    function printLabel() {
        var selectorVal = document.getElementById('printEntitySelector').value;
        if (!selectorVal) { showResult('Bitte Asset oder Artikel waehlen', 'warning'); return; }

        var parts = selectorVal.split(':');
        var entityType = parts[0];
        var entityId = parts[1];

        if (entityType === 'asset') {
            // Existing asset label print
            ajaxcall('rfid/label.php', {
                action: 'preview',
                asset_id: entityId
            }, function(response) {
                if (response.result && response.response) {
                    var r = response.response;
                    showLabelPreview(r.type_name, r.asset_tag, r.barcode_data, r.rfid_tag);
                    showResult('Label-Vorschau erstellt', 'success');
                } else {
                    showResult('Fehler beim Erstellen der Label-Vorschau', 'error');
                }
            }, true);
        } else if (entityType === 'stock_item') {
            // Stock item label - preview for all instances
            ajaxcall('rfid/label.php', {
                action: 'preview_stock',
                stock_item_id: entityId
            }, function(response) {
                if (response.result && response.response) {
                    var r = response.response;
                    showLabelPreview(r.item_name, r.category, r.sku, r.instance_count + ' Instanzen');
                    showResult('Artikel-Label-Vorschau erstellt', 'success');
                } else {
                    showResult('Fehler beim Erstellen der Label-Vorschau', 'error');
                }
            }, true);
        }
    }

    function showLabelPreview(line1, line2, line3, line4) {
        var preview = document.getElementById('labelPreview');
        var content = document.getElementById('labelPreviewContent');
        preview.style.display = 'block';
        var lines = [];
        lines.push('+------------------------------+');
        lines.push('|  ' + (line1 || '').substring(0, 26).padEnd(26) + '  |');
        lines.push('|  ' + (line2 || '').substring(0, 26).padEnd(26) + '  |');
        lines.push('|  ||||||||||||||||||||||||||||  |');
        lines.push('|  ' + (line3 || '').substring(0, 26).padEnd(26) + '  |');
        if (line4) {
            lines.push('|  ' + String(line4).substring(0, 26).padEnd(26) + '  |');
        }
        lines.push('+------------------------------+');
        content.textContent = lines.join('\n');
    }

    function printLabelDirect() {
        var selectorVal = document.getElementById('printEntitySelector').value;
        var printerIp = document.getElementById('printerIp').value.trim();

        if (!selectorVal) { showResult('Bitte Asset oder Artikel waehlen', 'warning'); return; }

        var parts = selectorVal.split(':');
        var entityType = parts[0];
        var entityId = parts[1];

        var params = {
            action: 'print',
            printer_ip: printerIp || ''
        };

        if (entityType === 'asset') {
            params.asset_id = entityId;
        } else {
            params.stock_item_id = entityId;
            params.action = 'print_stock';
        }

        ajaxcall('rfid/label.php', params, function(response) {
            if (response.result) {
                playSound('success');
                showResult('<i class="fas fa-check-circle"></i> Label-Druckauftrag gesendet!', 'success');
                addToHistory('PRINT', 'Label gedruckt', 'success');
            } else {
                playSound('error');
                showResult('Druckfehler: ' + (response.response ? response.response.message : 'Drucker nicht erreichbar'), 'error');
            }
        }, true);
    }

    // ══════════════════════════════════════
    // RFID Input Handler
    // ══════════════════════════════════════
    document.getElementById('rfidInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            handleScan(this.value);
        }
    });

    // Initialize
    setMode('checkout');
    document.getElementById('rfidInput').focus();
</script>
{% endblock %}
