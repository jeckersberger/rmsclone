{% extends "assets/template.twig" %}

{% block content %}
<style>
    .rfid-container {
        max-width: 800px;
        margin: 20px auto;
        padding: 0 10px;
    }

    .rfid-mode-selector {
        display: flex;
        gap: 10px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .mode-btn {
        flex: 1;
        min-width: 150px;
        padding: 20px;
        font-size: 18px;
        font-weight: bold;
        border: 2px solid #ddd;
        background: #f9f9f9;
        cursor: pointer;
        border-radius: 5px;
        transition: all 0.2s;
    }

    .mode-btn:hover {
        background: #f0f0f0;
        border-color: #999;
    }

    .mode-btn.active {
        background: #007bff;
        color: white;
        border-color: #0056b3;
    }

    .rfid-input-section {
        margin-bottom: 30px;
        text-align: center;
    }

    .rfid-input {
        font-size: 18px;
        padding: 15px;
        width: 100%;
        max-width: 400px;
        border: 2px solid #ddd;
        border-radius: 5px;
        margin-bottom: 10px;
        text-align: center;
    }

    .rfid-input:focus {
        outline: none;
        border-color: #007bff;
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
    }

    .project-selector {
        font-size: 18px;
        padding: 15px;
        width: 100%;
        max-width: 400px;
        border: 2px solid #ddd;
        border-radius: 5px;
        margin-bottom: 10px;
        display: none;
    }

    .project-selector.visible {
        display: block;
    }

    .result-display {
        min-height: 150px;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 20px;
        font-size: 18px;
        font-weight: bold;
        display: none;
        text-align: center;
    }

    .result-display.visible {
        display: block;
    }

    .result-display.success {
        background: #d4edda;
        color: #155724;
        border: 2px solid #28a745;
    }

    .result-display.error {
        background: #f8d7da;
        color: #721c24;
        border: 2px solid #dc3545;
    }

    .result-display.warning {
        background: #fff3cd;
        color: #856404;
        border: 2px solid #ffc107;
    }

    .result-asset-info {
        margin-top: 10px;
        font-size: 16px;
        font-weight: normal;
    }

    .scan-history {
        margin-top: 30px;
    }

    .scan-history h3 {
        font-size: 20px;
        margin-bottom: 15px;
    }

    .scan-list {
        max-height: 400px;
        overflow-y: auto;
        border: 2px solid #ddd;
        border-radius: 5px;
        background: #f9f9f9;
    }

    .scan-item {
        padding: 15px;
        border-bottom: 1px solid #ddd;
        font-size: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .scan-item:last-child {
        border-bottom: none;
    }

    .scan-item.success {
        background: #e8f5e9;
        border-left: 4px solid #4caf50;
    }

    .scan-item.error {
        background: #ffebee;
        border-left: 4px solid #f44336;
    }

    .scan-timestamp {
        font-size: 14px;
        color: #666;
        margin-top: 5px;
    }

    .inventory-results {
        margin-top: 30px;
        padding: 20px;
        background: #f9f9f9;
        border-radius: 5px;
        display: none;
    }

    .inventory-results.visible {
        display: block;
    }

    .inventory-section {
        margin-bottom: 20px;
    }

    .inventory-section h4 {
        font-size: 18px;
        margin-bottom: 10px;
        border-bottom: 2px solid #007bff;
        padding-bottom: 5px;
    }

    .inventory-list {
        max-height: 300px;
        overflow-y: auto;
    }

    .inventory-item {
        padding: 10px;
        margin-bottom: 5px;
        background: white;
        border-radius: 3px;
        border-left: 4px solid #007bff;
    }

    .status-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 3px;
        font-size: 12px;
        font-weight: bold;
        margin-left: 10px;
    }

    .status-badge.available {
        background: #4caf50;
        color: white;
    }

    .status-badge.checked-out {
        background: #ff9800;
        color: white;
    }

    @media (max-width: 600px) {
        .rfid-container {
            margin: 10px auto;
            padding: 5px;
        }

        .mode-btn {
            min-width: 100px;
            padding: 15px;
            font-size: 16px;
        }

        .rfid-input, .project-selector {
            font-size: 16px;
            padding: 12px;
        }
    }
</style>

<div class="rfid-container">
    <h1>RFID Scanner</h1>

    <div class="rfid-mode-selector">
        <button class="mode-btn active" onclick="setMode('checkout')"><i class="fas fa-sign-out-alt"></i> Ausleihe</button>
        <button class="mode-btn" onclick="setMode('checkin')"><i class="fas fa-sign-in-alt"></i> Rueckgabe</button>
        <button class="mode-btn" onclick="setMode('inventory')"><i class="fas fa-clipboard-list"></i> Inventur</button>
        <button class="mode-btn" onclick="setMode('write_tag')"><i class="fas fa-pen"></i> Tag schreiben</button>
        <button class="mode-btn" onclick="setMode('print_label')"><i class="fas fa-print"></i> Label drucken</button>
    </div>

    <div class="rfid-input-section">
        <label for="rfidInput" style="font-size: 18px; display: block; margin-bottom: 10px;">Scan Asset:</label>
        <input 
            type="text" 
            id="rfidInput" 
            class="rfid-input" 
            placeholder="Scan RFID tag..." 
            autofocus
        />

        <select id="projectSelector" class="project-selector visible">
            <option value="">-- Select Project --</option>
        </select>

        <button 
            id="startInventoryBtn" 
            onclick="startInventory()" 
            style="display: none; font-size: 16px; padding: 12px 24px; margin-top: 10px; background: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; min-height: 48px;"
        >
            Start Inventory
        </button>

        <button 
            id="completeInventoryBtn" 
            onclick="completeInventory()" 
            style="display: none; font-size: 16px; padding: 12px 24px; margin-top: 10px; margin-left: 10px; background: #28a745; color: white; border: none; border-radius: 5px; cursor: pointer; min-height: 48px;"
        >
            Complete Inventory
        </button>
    </div>

    {# ── Tag Write Section ── #}
    <div id="writeTagSection" style="display:none; margin-bottom: 20px;">
        <div class="card card-warning card-outline">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-pen"></i> RFID-Tag beschreiben</h3></div>
            <div class="card-body">
                <p style="font-size:16px;">1. Asset auswaehlen &rarr; 2. Neuen EPC eingeben oder generieren &rarr; 3. Tag scannen &rarr; Tag wird beschrieben</p>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:15px;">
                    <select id="writeAssetSelector" class="project-selector" style="display:block; flex:2;">
                        <option value="">-- Asset auswaehlen --</option>
                    </select>
                    <input type="text" id="writeEpcInput" class="rfid-input" style="flex:1; max-width:none;" placeholder="EPC (z.B. RMS-0001)" />
                    <button onclick="generateEpc()" style="padding:12px 20px; font-size:16px; background:#ffc107; border:none; border-radius:5px; cursor:pointer; min-height:48px; white-space:nowrap;">
                        <i class="fas fa-magic"></i> Auto-EPC
                    </button>
                </div>
                <p style="font-size:14px; color:#666;">Aktueller Tag (scannen zum Lesen): <strong id="currentTagDisplay">-</strong></p>
                <button onclick="writeTag()" style="padding:15px 30px; font-size:18px; font-weight:bold; background:#28a745; color:white; border:none; border-radius:5px; cursor:pointer; min-height:56px; width:100%;">
                    <i class="fas fa-save"></i> Tag beschreiben &amp; Asset zuweisen
                </button>
            </div>
        </div>
    </div>

    {# ── Label Print Section ── #}
    <div id="printLabelSection" style="display:none; margin-bottom: 20px;">
        <div class="card card-info card-outline">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-print"></i> Label drucken (Zebra LP2824)</h3></div>
            <div class="card-body">
                <p style="font-size:16px;">Asset auswaehlen und Label drucken. Der Drucker muss als Netzwerkdrucker oder via USB angeschlossen sein.</p>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:15px;">
                    <select id="printAssetSelector" class="project-selector" style="display:block; flex:2;">
                        <option value="">-- Asset auswaehlen --</option>
                    </select>
                    <button onclick="printLabel()" style="padding:15px 30px; font-size:18px; font-weight:bold; background:#17a2b8; color:white; border:none; border-radius:5px; cursor:pointer; min-height:56px; white-space:nowrap;">
                        <i class="fas fa-print"></i> Label drucken
                    </button>
                </div>
                <div id="labelPreview" style="display:none; margin-top:15px; padding:20px; background:white; border:2px dashed #ccc; border-radius:5px; text-align:center;">
                    <div style="font-family:monospace; font-size:14px; background:#f5f5f5; padding:15px; border-radius:3px; text-align:left; white-space:pre;" id="labelPreviewContent"></div>
                </div>
                <div style="margin-top:10px;">
                    <label style="font-size:14px; margin-right:10px;">Drucker-IP (fuer Netzwerkdruck):</label>
                    <input type="text" id="printerIp" value="" placeholder="z.B. 192.168.1.100" style="padding:8px; border:1px solid #ccc; border-radius:3px; width:200px;" />
                    <button onclick="printLabelDirect()" style="padding:8px 16px; font-size:14px; background:#6c757d; color:white; border:none; border-radius:3px; cursor:pointer; margin-left:5px;">
                        <i class="fas fa-network-wired"></i> Direkt senden
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="resultDisplay" class="result-display"></div>

    <div class="inventory-results" id="inventoryResults">
        <h3>Inventory Results</h3>

        <div class="inventory-section">
            <h4>Found Assets (<span id="foundCount">0</span>)</h4>
            <div class="inventory-list" id="foundAssetsList"></div>
        </div>

        <div class="inventory-section">
            <h4>Missing Assets (<span id="missingCount">0</span>)</h4>
            <div class="inventory-list" id="missingAssetsList"></div>
        </div>

        <div class="inventory-section">
            <h4>Unknown Tags (<span id="unknownCount">0</span>)</h4>
            <div class="inventory-list" id="unknownTagsList"></div>
        </div>
    </div>

    <div class="scan-history">
        <h3>Scan History (Last 20)</h3>
        <div class="scan-list" id="scanHistoryList"></div>
    </div>
</div>

<script>
    let currentMode = 'checkout';
    let inventorySessionId = null;
    let scanHistory = [];

    function setMode(mode) {
        currentMode = mode;

        // Update active button
        document.querySelectorAll('.mode-btn').forEach(btn => {
            btn.classList.remove('active');
        });
        event.target.classList.add('active');

        // Update UI based on mode
        const projectSelector = document.getElementById('projectSelector');
        const startBtn = document.getElementById('startInventoryBtn');
        const completeBtn = document.getElementById('completeInventoryBtn');
        const resultDisplay = document.getElementById('resultDisplay');
        const inventoryResults = document.getElementById('inventoryResults');

        if (mode === 'checkout') {
            projectSelector.classList.add('visible');
            startBtn.style.display = 'none';
            completeBtn.style.display = 'none';
            inventoryResults.classList.remove('visible');
            loadProjects();
        } else if (mode === 'checkin') {
            projectSelector.classList.remove('visible');
            startBtn.style.display = 'none';
            completeBtn.style.display = 'none';
            inventoryResults.classList.remove('visible');
        } else if (mode === 'inventory') {
            projectSelector.classList.remove('visible');
            startBtn.style.display = 'inline-block';
            completeBtn.style.display = 'inline-block';
            inventorySessionId = null;
            scanHistory = [];
            resultDisplay.classList.remove('visible');
            inventoryResults.classList.remove('visible');
        }

        // Clear input and focus
        document.getElementById('rfidInput').value = '';
        document.getElementById('rfidInput').focus();
    }

    function loadProjects() {
        ajaxcall('assets/projects.php', { action: 'list' }, function(response) {
            if (response.success) {
                const selector = document.getElementById('projectSelector');
                selector.innerHTML = '<option value="">-- Select Project --</option>';
                
                if (response.projects && response.projects.length > 0) {
                    response.projects.forEach(project => {
                        const option = document.createElement('option');
                        option.value = project.projects_id;
                        option.textContent = project.projects_name;
                        selector.appendChild(option);
                    });
                }
            }
        }, true);
    }

    function startInventory() {
        ajaxcall('rfid/scan.php', { action: 'start_inventory' }, function(response) {
            if (response.success) {
                inventorySessionId = response.session_id;
                scanHistory = [];
                showResult('Inventory session started', 'success');
                document.getElementById('rfidInput').focus();
            } else {
                showResult('Failed to start inventory: ' + (response.message || 'Unknown error'), 'error');
            }
        }, true);
    }

    function completeInventory() {
        if (!inventorySessionId) {
            showResult('No active inventory session', 'error');
            return;
        }

        ajaxcall('rfid/scan.php', { 
            action: 'complete_inventory',
            session_id: inventorySessionId 
        }, function(response) {
            if (response.success) {
                showInventoryResults(response);
                inventorySessionId = null;
            } else {
                showResult('Failed to complete inventory: ' + (response.message || 'Unknown error'), 'error');
            }
        }, true);
    }

    function handleScan(rfidTag) {
        rfidTag = rfidTag.trim();
        if (!rfidTag) return;

        if (currentMode === 'inventory') {
            if (!inventorySessionId) {
                showResult('No active inventory session', 'error');
                return;
            }
            handleInventoryScan(rfidTag);
        } else if (currentMode === 'checkout') {
            const projectId = document.getElementById('projectSelector').value;
            if (!projectId) {
                showResult('Please select a project', 'warning');
                return;
            }
            handleCheckoutScan(rfidTag, projectId);
        } else if (currentMode === 'checkin') {
            handleCheckinScan(rfidTag);
        }

        document.getElementById('rfidInput').value = '';
        document.getElementById('rfidInput').focus();
    }

    function handleCheckoutScan(rfidTag, projectId) {
        ajaxcall('rfid/scan.php', {
            action: 'scan',
            rfid_tag: rfidTag,
            scan_action: 'checkout',
            project_id: projectId
        }, function(response) {
            if (response.success) {
                playSound('success');
                showResult(
                    'Checked out: ' + response.asset.assets_name,
                    'success',
                    response.asset
                );
                addToHistory(rfidTag, response.asset.assets_name, 'success');
            } else {
                playSound('error');
                showResult(response.message || 'Checkout failed', 'error');
                addToHistory(rfidTag, response.message, 'error');
            }
        }, true);
    }

    function handleCheckinScan(rfidTag) {
        ajaxcall('rfid/scan.php', {
            action: 'scan',
            rfid_tag: rfidTag,
            scan_action: 'checkin'
        }, function(response) {
            if (response.success) {
                playSound('success');
                showResult(
                    'Checked in: ' + response.asset.assets_name,
                    'success',
                    response.asset
                );
                addToHistory(rfidTag, response.asset.assets_name, 'success');
            } else {
                playSound('error');
                showResult(response.message || 'Checkin failed', 'error');
                addToHistory(rfidTag, response.message, 'error');
            }
        }, true);
    }

    function handleInventoryScan(rfidTag) {
        ajaxcall('rfid/scan.php', {
            action: 'inventory_scan',
            session_id: inventorySessionId,
            rfid_tag: rfidTag
        }, function(response) {
            if (response.success) {
                playSound('success');
                showResult(
                    'Recorded: ' + response.asset.assets_name,
                    'success',
                    response.asset
                );
                addToHistory(rfidTag, response.asset.assets_name, 'success');
            } else {
                playSound('error');
                showResult('Unknown tag', 'warning');
                addToHistory(rfidTag, 'Unknown', 'error');
            }
        }, true);
    }

    function showResult(message, type, asset) {
        const resultDisplay = document.getElementById('resultDisplay');
        resultDisplay.className = 'result-display visible ' + type;
        
        let html = message;
        if (asset) {
            html += '<div class="result-asset-info">';
            html += '<strong>' + asset.assets_name + '</strong><br/>';
            html += 'Type: ' + asset.type_name + '<br/>';
            html += 'Status: <span class="status-badge ' + asset.status + '">' + asset.status.replace('_', ' ').toUpperCase() + '</span>';
            html += '</div>';
        }
        
        resultDisplay.innerHTML = html;
    }

    function addToHistory(tag, name, status) {
        const now = new Date();
        const time = now.toLocaleTimeString();
        
        scanHistory.unshift({
            tag: tag,
            name: name,
            status: status,
            time: time
        });
        
        // Keep only last 20
        if (scanHistory.length > 20) {
            scanHistory.pop();
        }
        
        updateHistoryDisplay();
    }

    function updateHistoryDisplay() {
        const list = document.getElementById('scanHistoryList');
        list.innerHTML = '';
        
        scanHistory.forEach(item => {
            const div = document.createElement('div');
            div.className = 'scan-item ' + item.status;
            div.innerHTML = '<div>' +
                '<strong>' + item.name + '</strong><br/>' +
                '<small class="scan-timestamp">' + item.time + '</small>' +
                '</div>' +
                '<div style="color: ' + (item.status === 'success' ? '#4caf50' : '#f44336') + ';">' +
                (item.status === 'success' ? '✓' : '✗') +
                '</div>';
            list.appendChild(div);
        });
    }

    function showInventoryResults(data) {
        document.getElementById('inventoryResults').classList.add('visible');
        
        // Found assets
        const foundList = document.getElementById('foundAssetsList');
        foundList.innerHTML = '';
        document.getElementById('foundCount').textContent = data.found_assets.length;
        
        data.found_assets.forEach(scan => {
            const div = document.createElement('div');
            div.className = 'inventory-item';
            div.textContent = scan.assets_name || 'Unknown asset';
            foundList.appendChild(div);
        });
        
        // Missing assets
        const missingList = document.getElementById('missingAssetsList');
        missingList.innerHTML = '';
        document.getElementById('missingCount').textContent = data.missing_assets.length;
        
        data.missing_assets.forEach(asset => {
            const div = document.createElement('div');
            div.className = 'inventory-item';
            div.style.borderLeftColor = '#f44336';
            div.textContent = asset.assets_name || 'Unknown asset';
            missingList.appendChild(div);
        });
        
        // Unknown tags
        const unknownList = document.getElementById('unknownTagsList');
        unknownList.innerHTML = '';
        document.getElementById('unknownCount').textContent = data.unknown_tags.length;
        
        data.unknown_tags.forEach(tag => {
            const div = document.createElement('div');
            div.className = 'inventory-item';
            div.style.borderLeftColor = '#ff9800';
            div.textContent = tag;
            unknownList.appendChild(div);
        });
    }

    function playSound(type) {
        try {
            const audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            
            if (type === 'success') {
                oscillator.frequency.value = 800;
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.1);
            } else {
                oscillator.frequency.value = 400;
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.2);
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.2);
            }
        } catch (e) {
            // Audio not available in this context
        }
    }

    // ── Tag Write Functions ──
    function loadAssets(targetSelector) {
        ajaxcall('rfid/scan.php', { action: 'list_assets' }, function(response) {
            if (response.result && response.response && response.response.assets) {
                var sel = document.getElementById(targetSelector);
                sel.innerHTML = '<option value="">-- Asset auswaehlen --</option>';
                response.response.assets.forEach(function(a) {
                    var opt = document.createElement('option');
                    opt.value = a.assets_id;
                    opt.textContent = (a.assetTypes_name || '') + ' ' + (a.assets_tag ? '#' + a.assets_tag : '') + ' (ID:' + a.assets_id + ')';
                    opt.dataset.tag = a.assets_tag || '';
                    opt.dataset.rfid = a.rfid_tag || '';
                    opt.dataset.type = a.assetTypes_name || '';
                    sel.appendChild(opt);
                });
            }
        }, false);
    }

    function generateEpc() {
        var sel = document.getElementById('writeAssetSelector');
        var opt = sel.options[sel.selectedIndex];
        if (!sel.value) {
            showResult('Bitte zuerst ein Asset auswaehlen', 'warning');
            return;
        }
        var epc = 'RMS-' + String(sel.value).padStart(6, '0');
        document.getElementById('writeEpcInput').value = epc;
    }

    function writeTag() {
        var assetId = document.getElementById('writeAssetSelector').value;
        var newEpc = document.getElementById('writeEpcInput').value.trim();
        var currentTag = document.getElementById('rfidInput').value.trim();

        if (!assetId) { showResult('Bitte Asset auswaehlen', 'warning'); return; }
        if (!newEpc) { showResult('Bitte EPC eingeben oder generieren', 'warning'); return; }

        // If the Chafon scanner is used in keyboard mode, the "current tag" field
        // contains the last scanned tag. We use it to identify which physical tag to write.
        // The actual write happens on the device side (Android SDK).
        // Here we register the EPC assignment in the system.
        ajaxcall('rfid/scan.php', {
            action: 'assign_tag',
            asset_id: assetId,
            rfid_tag: newEpc
        }, function(response) {
            if (response.result) {
                playSound('success');
                showResult('<i class="fas fa-check-circle"></i> Tag "' + newEpc + '" erfolgreich zugewiesen!<br><small>Jetzt mit dem Chafon-Scanner den EPC auf den physischen Tag schreiben (Write EPC in Chafon-App).</small>', 'success');
                addToHistory(newEpc, 'Tag zugewiesen (Asset #' + assetId + ')', 'success');
                document.getElementById('currentTagDisplay').textContent = newEpc;
            } else {
                playSound('error');
                showResult('Fehler: ' + (response.response ? response.response.message : 'Unbekannt'), 'error');
            }
        }, true);
    }

    // ── Label Print Functions ──
    function printLabel() {
        var assetId = document.getElementById('printAssetSelector').value;
        if (!assetId) { showResult('Bitte Asset auswaehlen', 'warning'); return; }

        ajaxcall('rfid/label.php', {
            action: 'preview',
            asset_id: assetId
        }, function(response) {
            if (response.result && response.response) {
                var r = response.response;
                var preview = document.getElementById('labelPreview');
                var content = document.getElementById('labelPreviewContent');
                preview.style.display = 'block';

                // Show human-readable preview
                var lines = [];
                lines.push('┌──────────────────────────────┐');
                lines.push('│  ' + (r.type_name || '').substring(0, 26).padEnd(26) + '  │');
                lines.push('│  ' + (r.asset_tag || '').substring(0, 26).padEnd(26) + '  │');
                lines.push('│  ████████████████████████████  │');
                lines.push('│  ' + (r.barcode_data || '').substring(0, 26).padEnd(26) + '  │');
                if (r.rfid_tag) {
                    lines.push('│  RFID: ' + r.rfid_tag.substring(0, 20).padEnd(20) + '  │');
                }
                lines.push('└──────────────────────────────┘');
                content.textContent = lines.join('\n');

                showResult('Label-Vorschau erstellt. Klicke "Direkt senden" fuer Netzwerkdruck oder nutze den Browser-Druck.', 'success');
            } else {
                showResult('Fehler beim Erstellen der Label-Vorschau', 'error');
            }
        }, true);
    }

    function printLabelDirect() {
        var assetId = document.getElementById('printAssetSelector').value;
        var printerIp = document.getElementById('printerIp').value.trim();

        if (!assetId) { showResult('Bitte Asset auswaehlen', 'warning'); return; }

        ajaxcall('rfid/label.php', {
            action: 'print',
            asset_id: assetId,
            printer_ip: printerIp || ''
        }, function(response) {
            if (response.result) {
                playSound('success');
                showResult('<i class="fas fa-check-circle"></i> Label-Druckauftrag gesendet!', 'success');
                addToHistory('PRINT', 'Label gedruckt (Asset #' + assetId + ')', 'success');
            } else {
                playSound('error');
                showResult('Druckfehler: ' + (response.response ? response.response.message : 'Drucker nicht erreichbar'), 'error');
            }
        }, true);
    }

    // ── Mode: write_tag and print_label ──
    var origSetMode = setMode;
    setMode = function(mode) {
        // Hide new sections by default
        document.getElementById('writeTagSection').style.display = 'none';
        document.getElementById('printLabelSection').style.display = 'none';

        // Update active button
        document.querySelectorAll('.mode-btn').forEach(function(btn) { btn.classList.remove('active'); });
        if (event && event.target) event.target.classList.add('active');

        var projectSelector = document.getElementById('projectSelector');
        var startBtn = document.getElementById('startInventoryBtn');
        var completeBtn = document.getElementById('completeInventoryBtn');
        var resultDisplay = document.getElementById('resultDisplay');
        var inventoryResults = document.getElementById('inventoryResults');
        var rfidInput = document.getElementById('rfidInput');

        projectSelector.classList.remove('visible');
        startBtn.style.display = 'none';
        completeBtn.style.display = 'none';
        inventoryResults.classList.remove('visible');
        resultDisplay.classList.remove('visible');

        currentMode = mode;

        if (mode === 'checkout') {
            projectSelector.classList.add('visible');
            rfidInput.style.display = '';
            rfidInput.placeholder = 'RFID-Tag scannen...';
            loadProjects();
        } else if (mode === 'checkin') {
            rfidInput.style.display = '';
            rfidInput.placeholder = 'RFID-Tag scannen...';
        } else if (mode === 'inventory') {
            rfidInput.style.display = '';
            rfidInput.placeholder = 'RFID-Tag scannen...';
            startBtn.style.display = 'inline-block';
            completeBtn.style.display = 'inline-block';
            inventorySessionId = null;
        } else if (mode === 'write_tag') {
            rfidInput.style.display = '';
            rfidInput.placeholder = 'Tag scannen zum Lesen der aktuellen ID...';
            document.getElementById('writeTagSection').style.display = 'block';
            loadAssets('writeAssetSelector');
        } else if (mode === 'print_label') {
            rfidInput.style.display = 'none';
            document.getElementById('printLabelSection').style.display = 'block';
            loadAssets('printAssetSelector');
            document.getElementById('labelPreview').style.display = 'none';
        }

        if (rfidInput.style.display !== 'none') {
            rfidInput.value = '';
            rfidInput.focus();
        }
    };

    // When scanning in write_tag mode, show the scanned tag ID
    var origHandleScan = handleScan;
    handleScan = function(rfidTag) {
        if (currentMode === 'write_tag') {
            document.getElementById('currentTagDisplay').textContent = rfidTag;
            showResult('Tag gelesen: ' + rfidTag, 'success');
            playSound('success');
            document.getElementById('rfidInput').value = '';
            document.getElementById('rfidInput').focus();
            return;
        }
        origHandleScan(rfidTag);
    };

    // Handle RFID input - the scanner sends tags as keyboard input
    document.getElementById('rfidInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            handleScan(this.value);
        }
    });

    // Load initial state
    setMode('checkout');
    document.getElementById('rfidInput').focus();
</script>
{% endblock %}
