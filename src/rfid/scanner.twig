{% extends "assets/template.twig" %}

{% block content %}
<style>
    .rfid-container {
        max-width: 800px;
        margin: 20px auto;
        padding: 0 10px;
    }

    .rfid-mode-selector {
        display: flex;
        gap: 8px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .mode-btn {
        flex: 1;
        min-width: 120px;
        padding: 16px 10px;
        font-size: 15px;
        font-weight: bold;
        border: 2px solid #ddd;
        background: #f9f9f9;
        cursor: pointer;
        border-radius: 5px;
        transition: all 0.2s;
        text-align: center;
    }

    .mode-btn:hover {
        background: #f0f0f0;
        border-color: #999;
    }

    .mode-btn.active {
        background: #007bff;
        color: white;
        border-color: #0056b3;
    }

    .mode-btn.active-orange {
        background: #fd7e14;
        color: white;
        border-color: #e8590c;
    }

    .rfid-input-section {
        margin-bottom: 30px;
        text-align: center;
    }

    .rfid-input {
        font-size: 18px;
        padding: 15px;
        width: 100%;
        max-width: 400px;
        border: 2px solid #ddd;
        border-radius: 5px;
        margin-bottom: 10px;
        text-align: center;
    }

    .rfid-input:focus {
        outline: none;
        border-color: #007bff;
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
    }

    .project-selector {
        font-size: 18px;
        padding: 15px;
        width: 100%;
        max-width: 400px;
        border: 2px solid #ddd;
        border-radius: 5px;
        margin-bottom: 10px;
        display: none;
    }

    .project-selector.visible {
        display: block;
    }

    .result-display {
        min-height: 120px;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 20px;
        font-size: 18px;
        font-weight: bold;
        display: none;
        text-align: center;
    }

    .result-display.visible {
        display: block;
    }

    .result-display.success {
        background: #d4edda;
        color: #155724;
        border: 2px solid #28a745;
    }

    .result-display.error {
        background: #f8d7da;
        color: #721c24;
        border: 2px solid #dc3545;
    }

    .result-display.warning {
        background: #fff3cd;
        color: #856404;
        border: 2px solid #ffc107;
    }

    .result-asset-info {
        margin-top: 10px;
        font-size: 16px;
        font-weight: normal;
    }

    .entity-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 11px;
        font-weight: bold;
        margin-right: 6px;
        vertical-align: middle;
    }

    .entity-badge.asset {
        background: #6f42c1;
        color: white;
    }

    .entity-badge.stock {
        background: #20c997;
        color: white;
    }

    .status-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 3px;
        font-size: 12px;
        font-weight: bold;
        margin-left: 10px;
    }

    .status-badge.available {
        background: #4caf50;
        color: white;
    }

    .status-badge.checked_out, .status-badge.checked-out {
        background: #ff9800;
        color: white;
    }

    .scan-history {
        margin-top: 30px;
    }

    .scan-history h3 {
        font-size: 20px;
        margin-bottom: 15px;
    }

    .scan-list {
        max-height: 400px;
        overflow-y: auto;
        border: 2px solid #ddd;
        border-radius: 5px;
        background: #f9f9f9;
    }

    .scan-item {
        padding: 12px 15px;
        border-bottom: 1px solid #ddd;
        font-size: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .scan-item:last-child {
        border-bottom: none;
    }

    .scan-item.success {
        background: #e8f5e9;
        border-left: 4px solid #4caf50;
    }

    .scan-item.error {
        background: #ffebee;
        border-left: 4px solid #f44336;
    }

    .scan-timestamp {
        font-size: 13px;
        color: #666;
        margin-top: 3px;
    }

    .inventory-results {
        margin-top: 30px;
        padding: 20px;
        background: #f9f9f9;
        border-radius: 5px;
        display: none;
    }

    .inventory-results.visible {
        display: block;
    }

    .inventory-section {
        margin-bottom: 20px;
    }

    .inventory-section h4 {
        font-size: 18px;
        margin-bottom: 10px;
        border-bottom: 2px solid #007bff;
        padding-bottom: 5px;
    }

    .inventory-list {
        max-height: 300px;
        overflow-y: auto;
    }

    .inventory-item {
        padding: 10px;
        margin-bottom: 5px;
        background: white;
        border-radius: 3px;
        border-left: 4px solid #007bff;
    }

    /* ── Box Scan Styles ── */
    .box-scan-section {
        display: none;
        margin-bottom: 20px;
    }

    .box-scan-section.visible {
        display: block;
    }

    .box-tag-counter {
        font-size: 48px;
        font-weight: bold;
        color: #007bff;
        text-align: center;
        margin: 15px 0;
    }

    .box-tag-counter small {
        font-size: 18px;
        color: #666;
        display: block;
    }

    .box-results {
        display: none;
    }

    .box-results.visible {
        display: block;
    }

    .box-group {
        margin-bottom: 15px;
        border: 1px solid #dee2e6;
        border-radius: 5px;
        overflow: hidden;
    }

    .box-group-header {
        padding: 12px 15px;
        font-weight: bold;
        font-size: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .box-group-header.assets {
        background: #e8d5f5;
        color: #4a1a7a;
    }

    .box-group-header.stock {
        background: #d1f2eb;
        color: #0b5345;
    }

    .box-group-header.unknown {
        background: #fce4ec;
        color: #880e4f;
    }

    .box-group-items {
        padding: 0;
        list-style: none;
        margin: 0;
    }

    .box-group-items li {
        padding: 8px 15px;
        border-top: 1px solid #eee;
        font-size: 14px;
        display: flex;
        justify-content: space-between;
    }

    .box-group-items li:nth-child(even) {
        background: #fafafa;
    }

    .box-action-bar {
        display: flex;
        gap: 10px;
        margin-top: 15px;
        flex-wrap: wrap;
    }

    .box-action-bar button {
        flex: 1;
        min-width: 150px;
        padding: 12px;
        font-size: 16px;
        font-weight: bold;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        min-height: 48px;
    }

    .location-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 12px;
        font-weight: 600;
        color: white;
        background: #6c757d;
    }

    @media (max-width: 600px) {
        .rfid-container {
            margin: 10px auto;
            padding: 5px;
        }

        .mode-btn {
            min-width: 90px;
            padding: 12px 6px;
            font-size: 13px;
        }

        .rfid-input, .project-selector {
            font-size: 16px;
            padding: 12px;
        }

        .box-tag-counter {
            font-size: 36px;
        }
    }
</style>

<div class="rfid-container">
    <h1><i class="fas fa-broadcast-tower"></i> RFID Scanner</h1>

    <div class="rfid-mode-selector">
        <button class="mode-btn active" data-mode="checkout"><i class="fas fa-sign-out-alt"></i> Ausleihe</button>
        <button class="mode-btn" data-mode="checkin"><i class="fas fa-sign-in-alt"></i> Rueckgabe</button>
        <button class="mode-btn" data-mode="box_scan"><i class="fas fa-box-open"></i> Kisten-Scan</button>
        <button class="mode-btn" data-mode="inventory"><i class="fas fa-clipboard-list"></i> Inventur</button>
        <button class="mode-btn" data-mode="pair_tag"><i class="fas fa-link"></i> Tag zuordnen</button>
        <button class="mode-btn" data-mode="relocate"><i class="fas fa-dolly"></i> Umlagern</button>
        <button class="mode-btn" data-mode="print_label"><i class="fas fa-print"></i> Label drucken</button>
    </div>

    <div class="rfid-input-section">
        <label for="rfidInput" style="font-size: 18px; display: block; margin-bottom: 10px;" id="rfidInputLabel">RFID-Tag scannen:</label>
        <input
            type="text"
            id="rfidInput"
            class="rfid-input"
            placeholder="RFID-Tag scannen..."
            autofocus
        />

        <select id="projectSelector" class="project-selector">
            <option value="">-- Projekt waehlen --</option>
        </select>

        <button
            id="startInventoryBtn"
            onclick="startInventory()"
            style="display: none; font-size: 16px; padding: 12px 24px; margin-top: 10px; background: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; min-height: 48px;"
        >
            <i class="fas fa-play"></i> Inventur starten
        </button>

        <button
            id="completeInventoryBtn"
            onclick="completeInventory()"
            style="display: none; font-size: 16px; padding: 12px 24px; margin-top: 10px; margin-left: 10px; background: #28a745; color: white; border: none; border-radius: 5px; cursor: pointer; min-height: 48px;"
        >
            <i class="fas fa-check"></i> Inventur abschliessen
        </button>
    </div>

    {# ── Box Scan Section (Kisten-Scan) ── #}
    <div id="boxScanSection" class="box-scan-section">
        <div class="card card-warning card-outline">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-box-open"></i> Kisten-Scan</h3></div>
            <div class="card-body">
                <p style="font-size:16px;">Scanne alle Tags in einer Kiste. Die Ergebnisse werden automatisch nach Geraeten und Artikeln gruppiert.</p>

                <div class="box-tag-counter">
                    <span id="boxTagCount">0</span>
                    <small>Tags gescannt</small>
                </div>

                <div style="text-align:center; margin-bottom:15px;">
                    <button onclick="clearBoxScan()" style="padding:8px 20px; font-size:14px; background:#dc3545; color:white; border:none; border-radius:5px; cursor:pointer;">
                        <i class="fas fa-trash"></i> Zuruecksetzen
                    </button>
                    <button onclick="processBoxScan()" style="padding:8px 20px; font-size:14px; background:#28a745; color:white; border:none; border-radius:5px; cursor:pointer; margin-left:10px;">
                        <i class="fas fa-search"></i> Auswerten
                    </button>
                </div>

                <div id="boxResults" class="box-results">
                    <div id="boxSummary" style="text-align:center; margin-bottom:15px; padding:10px; background:#e3f2fd; border-radius:5px; font-size:16px;"></div>
                    <div id="boxGroupsContainer"></div>

                    <div class="box-action-bar" id="boxActionBar" style="display:none;">
                        <button onclick="boxCheckoutAll()" style="background:#007bff; color:white;">
                            <i class="fas fa-sign-out-alt"></i> Alle ausleihen
                        </button>
                        <button onclick="boxCheckinAll()" style="background:#28a745; color:white;">
                            <i class="fas fa-sign-in-alt"></i> Alle zurueckgeben
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── TID Pairing Section ── #}
    <div id="pairTagSection" style="display:none; margin-bottom: 20px;">
        <div class="card card-success card-outline">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-link"></i> RFID-Tag zuordnen (TID Pairing)</h3></div>
            <div class="card-body">
                <p style="font-size:16px;">1. RFID-Tag scannen (TID wird automatisch gelesen) &rarr; 2. Geraet/Instanz auswaehlen &rarr; 3. Zuordnen</p>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:15px;">
                    <input type="text" id="pairTidInput" class="rfid-input" style="flex:1; max-width:none;" placeholder="TID wird beim Scannen automatisch eingetragen..." readonly />
                    <select id="pairEntitySelector" class="project-selector" style="display:block; flex:2;">
                        <option value="">-- Geraet / Instanz waehlen --</option>
                    </select>
                </div>
                <div style="display:flex; gap:10px;">
                    <button onclick="pairTid()" style="padding:15px 30px; font-size:18px; font-weight:bold; background:#28a745; color:white; border:none; border-radius:5px; cursor:pointer; min-height:56px; flex:1;">
                        <i class="fas fa-link"></i> Tag zuordnen
                    </button>
                    <button onclick="unpairTid()" style="padding:15px 20px; font-size:16px; background:#dc3545; color:white; border:none; border-radius:5px; cursor:pointer; min-height:56px;">
                        <i class="fas fa-unlink"></i> Zuordnung entfernen
                    </button>
                </div>
                <div id="pairTidStatus" style="margin-top:10px; font-size:14px; color:#666;"></div>
            </div>
        </div>
    </div>

    {# ── Label Print Section ── #}
    <div id="printLabelSection" style="display:none; margin-bottom: 20px;">
        <div class="card card-info card-outline">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-print"></i> Label drucken (Zebra LP2824)</h3></div>
            <div class="card-body">
                <p style="font-size:16px;">Asset oder Artikel auswaehlen und Label drucken.</p>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:15px;">
                    <select id="printEntitySelector" class="project-selector" style="display:block; flex:2;">
                        <option value="">-- Asset / Artikel waehlen --</option>
                    </select>
                    <button onclick="printLabel()" style="padding:15px 30px; font-size:18px; font-weight:bold; background:#17a2b8; color:white; border:none; border-radius:5px; cursor:pointer; min-height:56px; white-space:nowrap;">
                        <i class="fas fa-print"></i> Label drucken
                    </button>
                </div>
                <div id="labelPreview" style="display:none; margin-top:15px; padding:20px; background:white; border:2px dashed #ccc; border-radius:5px; text-align:center;">
                    <div style="font-family:monospace; font-size:14px; background:#f5f5f5; padding:15px; border-radius:3px; text-align:left; white-space:pre;" id="labelPreviewContent"></div>
                </div>
                <div style="margin-top:10px;">
                    <label style="font-size:14px; margin-right:10px;">Drucker-IP (fuer Netzwerkdruck):</label>
                    <input type="text" id="printerIp" value="" placeholder="z.B. 192.168.1.100" style="padding:8px; border:1px solid #ccc; border-radius:3px; width:200px;" />
                    <button onclick="printLabelDirect()" style="padding:8px 16px; font-size:14px; background:#6c757d; color:white; border:none; border-radius:3px; cursor:pointer; margin-left:5px;">
                        <i class="fas fa-network-wired"></i> Direkt senden
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# ── Relocate Section ── #}
    <div id="relocateSection" style="display:none; margin-bottom: 20px;">
        <div class="card card-success card-outline">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-dolly"></i> Geraete / Artikel umlagern</h3></div>
            <div class="card-body">
                <p style="font-size:16px;">Lagerort waehlen und dann Tags scannen — jedes gescannte Geraet/Artikel wird dem Lagerort zugewiesen.</p>
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:15px;">
                    <select id="locationSelector" class="project-selector" style="display:block; flex:2;">
                        <option value="">-- Lagerort waehlen --</option>
                    </select>
                    <input type="text" id="locationCustom" class="rfid-input" style="flex:1; max-width:none;" placeholder="Oder Freitext-Standort eingeben..." />
                </div>
                <div style="margin-bottom:10px;">
                    <input type="text" id="locationNotes" class="rfid-input" style="width:100%; max-width:none;" placeholder="Notizen (optional)..." />
                </div>
                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <button onclick="relocateBulk()" style="padding:12px 24px; font-size:16px; background:#28a745; color:white; border:none; border-radius:5px; cursor:pointer; min-height:48px;">
                        <i class="fas fa-boxes"></i> Kiste umlagern (<span id="relocateTagCount">0</span> Tags)
                    </button>
                    <button onclick="clearRelocateTags()" style="padding:12px 24px; font-size:16px; background:#dc3545; color:white; border:none; border-radius:5px; cursor:pointer; min-height:48px;">
                        <i class="fas fa-trash"></i> Zuruecksetzen
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="resultDisplay" class="result-display"></div>

    <div class="inventory-results" id="inventoryResults">
        <h3>Inventur-Ergebnis</h3>

        <div class="inventory-section">
            <h4><i class="fas fa-check-circle" style="color:#4caf50"></i> Gefunden (<span id="foundCount">0</span>)</h4>
            <div class="inventory-list" id="foundAssetsList"></div>
        </div>

        <div class="inventory-section">
            <h4><i class="fas fa-exclamation-triangle" style="color:#f44336"></i> Fehlend (<span id="missingCount">0</span>)</h4>
            <div class="inventory-list" id="missingAssetsList"></div>
        </div>

        <div class="inventory-section">
            <h4><i class="fas fa-question-circle" style="color:#ff9800"></i> Unbekannt (<span id="unknownCount">0</span>)</h4>
            <div class="inventory-list" id="unknownTagsList"></div>
        </div>
    </div>

    <div class="scan-history">
        <h3>Scan-Verlauf (letzte 20)</h3>
        <div class="scan-list" id="scanHistoryList"></div>
    </div>
</div>

<script>
    var companyCode = '{{ companyCode }}';
    var currentMode = 'checkout';
    var inventorySessionId = null;
    var scanHistory = [];
    var boxScannedTags = [];  // Collected tags for box scan

    // ══════════════════════════════════════
    // Mode Management
    // ══════════════════════════════════════
    function setMode(mode) {
        currentMode = mode;

        // Update active buttons
        document.querySelectorAll('.mode-btn').forEach(function(btn) {
            btn.classList.remove('active', 'active-orange');
        });
        var activeBtn = document.querySelector('.mode-btn[data-mode="' + mode + '"]');
        if (activeBtn) {
            activeBtn.classList.add(mode === 'box_scan' ? 'active-orange' : 'active');
        }

        // Hide all optional sections
        var projectSelector = document.getElementById('projectSelector');
        var startBtn = document.getElementById('startInventoryBtn');
        var completeBtn = document.getElementById('completeInventoryBtn');
        var resultDisplay = document.getElementById('resultDisplay');
        var inventoryResults = document.getElementById('inventoryResults');
        var rfidInput = document.getElementById('rfidInput');
        var rfidLabel = document.getElementById('rfidInputLabel');

        projectSelector.classList.remove('visible');
        startBtn.style.display = 'none';
        completeBtn.style.display = 'none';
        inventoryResults.classList.remove('visible');
        resultDisplay.classList.remove('visible');
        document.getElementById('pairTagSection').style.display = 'none';
        document.getElementById('printLabelSection').style.display = 'none';
        document.getElementById('boxScanSection').classList.remove('visible');
        document.getElementById('relocateSection').style.display = 'none';

        rfidInput.style.display = '';
        rfidLabel.style.display = '';

        switch (mode) {
            case 'checkout':
                projectSelector.classList.add('visible');
                rfidInput.placeholder = 'RFID-Tag scannen (Geraet oder Artikel)...';
                rfidLabel.textContent = 'Ausleihe - Tag scannen:';
                loadProjects();
                break;

            case 'checkin':
                rfidInput.placeholder = 'RFID-Tag scannen (Geraet oder Artikel)...';
                rfidLabel.textContent = 'Rueckgabe - Tag scannen:';
                break;

            case 'box_scan':
                projectSelector.classList.add('visible');
                rfidInput.placeholder = 'Tags sammeln - einfach scannen...';
                rfidLabel.textContent = 'Kisten-Scan - alle Tags scannen:';
                document.getElementById('boxScanSection').classList.add('visible');
                loadProjects();
                break;

            case 'inventory':
                rfidInput.placeholder = 'RFID-Tag scannen...';
                rfidLabel.textContent = 'Inventur - Tag scannen:';
                startBtn.style.display = 'inline-block';
                completeBtn.style.display = 'inline-block';
                inventorySessionId = null;
                break;

            case 'pair_tag':
                rfidInput.placeholder = 'RFID-Tag scannen (TID wird gelesen)...';
                rfidLabel.textContent = 'Tag zuordnen - Tag scannen:';
                document.getElementById('pairTagSection').style.display = 'block';
                loadEntitiesForPair();
                break;

            case 'relocate':
                rfidInput.placeholder = 'Tag scannen zum Umlagern...';
                rfidLabel.textContent = 'Umlagern - Tag scannen:';
                document.getElementById('relocateSection').style.display = 'block';
                loadLocations();
                break;

            case 'print_label':
                rfidInput.style.display = 'none';
                rfidLabel.style.display = 'none';
                document.getElementById('printLabelSection').style.display = 'block';
                loadEntitiesForPrint();
                document.getElementById('labelPreview').style.display = 'none';
                break;
        }

        if (rfidInput.style.display !== 'none') {
            rfidInput.value = '';
            rfidInput.focus();
        }
    }

    // Bind mode buttons
    document.querySelectorAll('.mode-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            setMode(this.dataset.mode);
        });
    });

    // ══════════════════════════════════════
    // Universal Scan Handler
    // ══════════════════════════════════════
    function handleScan(rfidTag) {
        rfidTag = rfidTag.trim();
        if (!rfidTag) return;

        // Pair tag mode: put scanned TID into the pair input and do a lookup
        if (currentMode === 'pair_tag') {
            document.getElementById('pairTidInput').value = rfidTag;
            // Look up if TID is already assigned
            ajaxcall('rfid/scan.php', { action: 'lookup_tid', tid: rfidTag }, function(response) {
                var statusEl = document.getElementById('pairTidStatus');
                if (response.result && response.response && response.response.found) {
                    var ent = response.response.entity || response.response;
                    statusEl.innerHTML = '<i class="fas fa-exclamation-triangle" style="color:#ffc107;"></i> TID bereits zugeordnet: <strong>' + (ent.display_name || 'Unbekannt') + '</strong>';
                } else {
                    statusEl.innerHTML = '<i class="fas fa-info-circle" style="color:#28a745;"></i> TID noch nicht zugeordnet — bereit zum Pairing.';
                }
            }, true);
            showResult('TID gelesen: ' + rfidTag, 'success');
            playSound('success');
            document.getElementById('rfidInput').value = '';
            document.getElementById('rfidInput').focus();
            return;
        }

        // Box scan mode: collect tags
        if (currentMode === 'box_scan') {
            addToBoxScan(rfidTag);
            document.getElementById('rfidInput').value = '';
            document.getElementById('rfidInput').focus();
            return;
        }

        // Inventory mode
        if (currentMode === 'inventory') {
            if (!inventorySessionId) {
                showResult('Bitte zuerst Inventur starten', 'error');
                return;
            }
            handleInventoryScan(rfidTag);
            document.getElementById('rfidInput').value = '';
            document.getElementById('rfidInput').focus();
            return;
        }

        // Relocate mode: single scan assigns location immediately
        if (currentMode === 'relocate') {
            handleRelocateScan(rfidTag);
            document.getElementById('rfidInput').value = '';
            document.getElementById('rfidInput').focus();
            return;
        }

        // Checkout / Checkin: use universal scan
        if (currentMode === 'checkout') {
            var projectId = document.getElementById('projectSelector').value;
            if (!projectId) {
                showResult('Bitte Projekt waehlen', 'warning');
                return;
            }
            handleUniversalScan(rfidTag, 'checkout', projectId);
        } else if (currentMode === 'checkin') {
            handleUniversalScan(rfidTag, 'checkin', null);
        }

        document.getElementById('rfidInput').value = '';
        document.getElementById('rfidInput').focus();
    }

    function handleUniversalScan(rfidTag, scanAction, projectId) {
        var params = {
            action: 'universal_scan',
            rfid_tag: rfidTag,
            scan_action: scanAction
        };
        if (projectId) params.project_id = projectId;

        ajaxcall('rfid/scan.php', params, function(response) {
            if (response.result) {
                var r = response.response;
                playSound('success');
                var entityType = r.entity_type;
                var entity = r.entity;
                var displayName = entity ? (entity.display_name || entity.assets_name || entity.item_name || 'Unbekannt') : 'Unbekannt';
                var isForeign = entity && entity.is_foreign;

                var typeBadge = '';
                if (entityType.startsWith('partner_')) {
                    var baseType = entityType.replace('partner_', '');
                    typeBadge = '<span class="entity-badge" style="background:#ff6b6b;color:white;padding:2px 8px;border-radius:3px;font-size:12px;margin-right:4px;">'
                        + (entity.owner_name || 'Partner') + '</span> ';
                    typeBadge += baseType === 'asset'
                        ? '<span class="entity-badge asset">Geraet</span>'
                        : baseType === 'stock_instance'
                            ? '<span class="entity-badge stock">Artikel</span>'
                            : '<span class="entity-badge" style="background:#6c757d;color:white;padding:2px 8px;border-radius:3px;font-size:12px;">Fremd</span>';
                } else {
                    typeBadge = entityType === 'asset'
                        ? '<span class="entity-badge asset">Geraet</span>'
                        : entityType === 'stock_instance'
                            ? '<span class="entity-badge stock">Artikel</span>'
                            : '<span class="entity-badge" style="background:#6c757d;color:white;padding:2px 8px;border-radius:3px;font-size:12px;">Fremd</span>';
                }

                if (isForeign) {
                    showResult(
                        typeBadge + ' <strong>Achtung: Fremdgerät!</strong> ' + displayName +
                        '<br><small>Gehört: ' + (entity.owner_name || 'Partner') + '</small>',
                        'warning'
                    );
                } else {
                    showResult(
                        typeBadge + ' ' + (scanAction === 'checkout' ? 'Ausgeliehen' : 'Zurueckgegeben') + ': ' + displayName,
                        'success'
                    );
                }
                addToHistory(rfidTag, typeBadge + ' ' + displayName, 'success');
            } else {
                playSound('error');
                var msg = response.response ? response.response.message : 'Scan fehlgeschlagen';
                showResult(msg, 'error');
                addToHistory(rfidTag, msg, 'error');
            }
        }, true);
    }

    // ══════════════════════════════════════
    // Box Scan (Kisten-Scan)
    // ══════════════════════════════════════
    function addToBoxScan(rfidTag) {
        // Deduplicate
        if (boxScannedTags.indexOf(rfidTag) !== -1) {
            playSound('error');
            showResult('Tag bereits gescannt: ' + rfidTag, 'warning');
            return;
        }

        boxScannedTags.push(rfidTag);
        document.getElementById('boxTagCount').textContent = boxScannedTags.length;
        playSound('success');
        showResult('Tag erfasst: ' + rfidTag + ' (' + boxScannedTags.length + ' gesamt)', 'success');
        addToHistory(rfidTag, 'Kiste: Tag #' + boxScannedTags.length, 'success');
    }

    function clearBoxScan() {
        boxScannedTags = [];
        document.getElementById('boxTagCount').textContent = '0';
        document.getElementById('boxResults').classList.remove('visible');
        document.getElementById('boxActionBar').style.display = 'none';
        showResult('Kisten-Scan zurueckgesetzt', 'warning');
    }

    function processBoxScan() {
        if (boxScannedTags.length === 0) {
            showResult('Keine Tags gescannt', 'warning');
            return;
        }

        ajaxcall('rfid/scan.php', {
            action: 'box_scan',
            rfid_tags: JSON.stringify(boxScannedTags)
        }, function(response) {
            if (response.result && response.response.result) {
                var data = response.response.result;
                renderBoxResults(data);
                playSound('success');
            } else {
                showResult('Fehler beim Auswerten', 'error');
                playSound('error');
            }
        }, true);
    }

    function renderBoxResults(data) {
        var container = document.getElementById('boxGroupsContainer');
        container.innerHTML = '';

        var summary = data.summary;
        document.getElementById('boxSummary').innerHTML =
            '<strong>' + summary.total_scanned + ' Tags</strong> gescannt: ' +
            '<span class="entity-badge asset">Geraete: ' + summary.total_assets + '</span> ' +
            '<span class="entity-badge stock">Artikel: ' + summary.total_stock + ' (' + summary.stock_types + ' Typen)</span> ' +
            (summary.total_unknown > 0 ? '<span style="color:#dc3545;">Unbekannt: ' + summary.total_unknown + '</span>' : '');

        // Assets group
        if (data.assets && data.assets.length > 0) {
            var group = document.createElement('div');
            group.className = 'box-group';
            group.innerHTML = '<div class="box-group-header assets"><span><i class="fas fa-microchip"></i> Geraete</span><span>' + data.assets.length + ' Stueck</span></div>';
            var ul = document.createElement('ul');
            ul.className = 'box-group-items';
            data.assets.forEach(function(a) {
                var li = document.createElement('li');
                var statusClass = a.status === 'available' ? 'available' : 'checked_out';
                li.innerHTML = '<span>' + a.type_name + ' - ' + (a.assets_name || '#' + a.assets_id) + '</span>' +
                    '<span class="status-badge ' + statusClass + '">' + (a.status === 'available' ? 'Verfuegbar' : 'Ausgeliehen') + '</span>';
                ul.appendChild(li);
            });
            group.appendChild(ul);
            container.appendChild(group);
        }

        // Stock groups
        if (data.stock && data.stock.length > 0) {
            data.stock.forEach(function(sg) {
                var group = document.createElement('div');
                group.className = 'box-group';
                group.innerHTML = '<div class="box-group-header stock"><span><i class="fas fa-link"></i> ' +
                    (sg.item_category ? sg.item_category + ' / ' : '') + sg.item_name +
                    '</span><span>' + sg.count + 'x</span></div>';
                var ul = document.createElement('ul');
                ul.className = 'box-group-items';
                sg.instances.forEach(function(inst) {
                    var li = document.createElement('li');
                    var statusClass = inst.status === 'available' ? 'available' : 'checked_out';
                    li.innerHTML = '<span>#' + inst.instance_number + ' <small style="color:#999;">' + inst.rfid_tag + '</small></span>' +
                        '<span class="status-badge ' + statusClass + '">' + (inst.status === 'available' ? 'Verfuegbar' : 'Ausgeliehen') + '</span>';
                    ul.appendChild(li);
                });
                group.appendChild(ul);
                container.appendChild(group);
            });
        }

        // Unknown tags
        if (data.unknown && data.unknown.length > 0) {
            var group = document.createElement('div');
            group.className = 'box-group';
            group.innerHTML = '<div class="box-group-header unknown"><span><i class="fas fa-question-circle"></i> Unbekannte Tags</span><span>' + data.unknown.length + '</span></div>';
            var ul = document.createElement('ul');
            ul.className = 'box-group-items';
            data.unknown.forEach(function(tag) {
                var li = document.createElement('li');
                li.innerHTML = '<span style="font-family:monospace;">' + tag + '</span><span style="color:#999;">Nicht zugeordnet</span>';
                ul.appendChild(li);
            });
            group.appendChild(ul);
            container.appendChild(group);
        }

        document.getElementById('boxResults').classList.add('visible');
        document.getElementById('boxActionBar').style.display = 'flex';
    }

