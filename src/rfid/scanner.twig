                var name = response.asset ? (response.asset.assets_name || response.asset.display_name || 'Erfasst') : 'Erfasst';
                showResult('Erfasst: ' + name, 'success');
                addToHistory(rfidTag, name, 'success');
            } else {
                playSound('error');
                showResult('Unbekannter Tag: ' + rfidTag, 'warning');
                addToHistory(rfidTag, 'Unbekannt', 'error');
            }
        }, true);
