    function showResult(message, type) {
        var resultDisplay = document.getElementById('resultDisplay');
        resultDisplay.className = 'result-display visible ' + type;
        resultDisplay.innerHTML = message;
    }

    function addToHistory(tag, name, status) {
        var now = new Date();
        scanHistory.unshift({
            tag: tag,
            name: name,
            status: status,
            time: now.toLocaleTimeString()
        });
        if (scanHistory.length > 20) scanHistory.pop();
        updateHistoryDisplay();
    }

    function updateHistoryDisplay() {
        var list = document.getElementById('scanHistoryList');
        list.innerHTML = '';
        scanHistory.forEach(function(item) {
            var div = document.createElement('div');
            div.className = 'scan-item ' + item.status;
            div.innerHTML = '<div>' +
                '<strong>' + item.name + '</strong><br/>' +
                '<small class="scan-timestamp">' + item.time + ' &middot; ' + item.tag + '</small>' +
                '</div>' +
                '<div style="color:' + (item.status === 'success' ? '#4caf50' : '#f44336') + '; font-size:20px;">' +
                (item.status === 'success' ? '&#10003;' : '&#10007;') +
                '</div>';
            list.appendChild(div);
        });
    }

    function showInventoryResults(data) {
        document.getElementById('inventoryResults').classList.add('visible');

        var foundList = document.getElementById('foundAssetsList');
        foundList.innerHTML = '';
        document.getElementById('foundCount').textContent = data.found_assets.length;
        data.found_assets.forEach(function(scan) {
            var div = document.createElement('div');
            div.className = 'inventory-item';
            div.textContent = scan.assets_name || scan.rfid_tag || 'Unbekannt';
            foundList.appendChild(div);
        });

        var missingList = document.getElementById('missingAssetsList');
        missingList.innerHTML = '';
        document.getElementById('missingCount').textContent = data.missing_assets.length;
        data.missing_assets.forEach(function(asset) {
            var div = document.createElement('div');
            div.className = 'inventory-item';
            div.style.borderLeftColor = '#f44336';
            div.textContent = asset.assets_name || 'Unbekannt';
            missingList.appendChild(div);
        });

        var unknownList = document.getElementById('unknownTagsList');
        unknownList.innerHTML = '';
        document.getElementById('unknownCount').textContent = data.unknown_tags.length;
        data.unknown_tags.forEach(function(tag) {
            var div = document.createElement('div');
            div.className = 'inventory-item';
            div.style.borderLeftColor = '#ff9800';
            div.textContent = tag;
            unknownList.appendChild(div);
        });
    }

    function playSound(type) {
        try {
            var audioContext = new (window.AudioContext || window.webkitAudioContext)();
            var oscillator = audioContext.createOscillator();
            var gainNode = audioContext.createGain();
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            if (type === 'success') {
                oscillator.frequency.value = 800;
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.1);
            } else {
                oscillator.frequency.value = 400;
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.2);
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.2);
            }
        } catch (e) { /* Audio not available */ }
    }

    // ══════════════════════════════════════
    // Relocate (Umlagern) Functions
    // ══════════════════════════════════════
    var relocateScannedTags = [];

    function loadLocations() {
        ajaxcall('locations.php', { action: 'list_locations' }, function(response) {
            if (response.result && response.response && response.response.locations) {
                var sel = document.getElementById('locationSelector');
                sel.innerHTML = '<option value="">-- Lagerort waehlen --</option>';
                response.response.locations.forEach(function(loc) {
                    var opt = document.createElement('option');
                    opt.value = loc.id;
                    opt.textContent = loc.name + (loc.description ? ' (' + loc.description + ')' : '');
                    opt.dataset.color = loc.color || '#6c757d';
                    opt.dataset.icon = loc.icon || 'fas fa-warehouse';
                    sel.appendChild(opt);
                });
            }
        }, false);
    }

    function getLocationParams() {
        var locationId = document.getElementById('locationSelector').value;
        var locationCustom = document.getElementById('locationCustom').value.trim();
        var notes = document.getElementById('locationNotes').value.trim();

        if (!locationId && !locationCustom) {
            showResult('Bitte Lagerort waehlen oder Freitext eingeben', 'warning');
            return null;
        }

        var params = {};
        if (locationId) params.location_id = locationId;
        if (locationCustom) params.location_custom = locationCustom;
        if (notes) params.notes = notes;
        return params;
    }

    function handleRelocateScan(rfidTag) {
        var params = getLocationParams();
        if (!params) return;

        // Also collect for bulk display
        if (relocateScannedTags.indexOf(rfidTag) === -1) {
            relocateScannedTags.push(rfidTag);
            document.getElementById('relocateTagCount').textContent = relocateScannedTags.length;
        }

        params.action = 'scan_assign';
        params.rfid_tag = rfidTag;

        ajaxcall('locations.php', params, function(response) {
            if (response.result && response.response && response.response.success) {
                var r = response.response;
                var entityType = r.entity_type;
                var entity = r.entity;
                var displayName = entity ? (entity.display_name || entity.assets_name || entity.item_name || 'Unbekannt') : 'Unbekannt';
                var locationName = r.location ? (r.location.name || r.location.location_custom || 'Unbekannt') : 'Unbekannt';
                var typeBadge = entityType === 'asset'
                    ? '<span class="entity-badge asset">Geraet</span>'
                    : '<span class="entity-badge stock">Artikel</span>';

                playSound('success');
                showResult(
                    typeBadge + ' ' + displayName + ' &rarr; <i class="fas fa-map-marker-alt"></i> ' + locationName,
                    'success'
                );
                addToHistory(rfidTag, typeBadge + ' ' + displayName + ' → ' + locationName, 'success');
            } else {
                playSound('error');
                var msg = (response.response && response.response.message) ? response.response.message : 'Umlagern fehlgeschlagen';
                showResult(msg, 'error');
                addToHistory(rfidTag, msg, 'error');
            }
        }, true);
    }

    function relocateBulk() {
        if (relocateScannedTags.length === 0) {
            showResult('Keine Tags gescannt', 'warning');
            return;
        }

        var params = getLocationParams();
        if (!params) return;

        params.action = 'bulk_assign';
        params.rfid_tags = JSON.stringify(relocateScannedTags);

        ajaxcall('locations.php', params, function(response) {
            if (response.result && response.response) {
                var r = response.response;
                playSound('success');
                showResult(
                    '<i class="fas fa-check-circle"></i> ' + r.success + ' von ' + r.total + ' Geraeten/Artikeln umgelagert' +
                    (r.errors > 0 ? ' (' + r.errors + ' Fehler)' : ''),
                    r.errors > 0 ? 'warning' : 'success'
                );
            } else {
                playSound('error');
                showResult('Fehler beim Sammel-Umlagern', 'error');
            }
        }, true);
    }

    function clearRelocateTags() {
        relocateScannedTags = [];
        document.getElementById('relocateTagCount').textContent = '0';
        showResult('Umlagern zurueckgesetzt', 'warning');
    }

    // ══════════════════════════════════════
    // Tag Write Functions
    // ══════════════════════════════════════
    function loadEntitiesForPair() {
        var sel = document.getElementById('pairEntitySelector');
        sel.innerHTML = '<option value="">-- Geraet / Instanz waehlen --</option>';

        // Load assets
        ajaxcall('rfid/scan.php', { action: 'list_assets' }, function(response) {
            if (response.result && response.response && response.response.assets) {
                var optGroup = document.createElement('optgroup');
                optGroup.label = 'Geraete (Assets)';
                response.response.assets.forEach(function(a) {
                    var opt = document.createElement('option');
                    opt.value = 'asset:' + a.assets_id;
                    opt.textContent = (a.assetTypes_name || '') + ' #' + (a.assets_tag || a.assets_id);
                    if (a.rfid_tag) opt.textContent += ' [EPC: ' + a.rfid_tag + ']';
                    opt.dataset.entityType = 'asset';
                    opt.dataset.entityId = a.assets_id;
                    optGroup.appendChild(opt);
                });
                sel.appendChild(optGroup);
            }
        }, false);

        // Load stock items, then instances for each
        ajaxcall('stock/items.php', { action: 'list_items' }, function(response) {
            if (response.success && response.items) {
                var optGroup = document.createElement('optgroup');
                optGroup.label = 'Artikel-Instanzen (Stock)';
                var pending = response.items.length;
                if (pending === 0) return;

                response.items.forEach(function(item) {
                    ajaxcall('stock/items.php', { action: 'list_instances', item_id: item.id }, function(instResponse) {
                        if (instResponse.success && instResponse.instances) {
                            instResponse.instances.forEach(function(inst) {
                                var opt = document.createElement('option');
                                opt.value = 'stock_instance:' + inst.id;
                                opt.textContent = item.name + ' #' + String(inst.instance_number).padStart(4, '0');
                                if (inst.rfid_tag) opt.textContent += ' [EPC: ' + inst.rfid_tag + ']';
                                opt.dataset.entityType = 'stock_instance';
                                opt.dataset.entityId = inst.id;
                                opt.dataset.instanceNumber = inst.instance_number;
                                optGroup.appendChild(opt);
                            });
                        }
                        pending--;
                        if (pending <= 0 && optGroup.children.length > 0) {
                            sel.appendChild(optGroup);
                        }
                    }, false);
                });
            }
        }, false);
    }

    function loadEntitiesForPrint() {
        var sel = document.getElementById('printEntitySelector');
        sel.innerHTML = '<option value="">-- Asset / Artikel waehlen --</option>';

        // Load assets
        ajaxcall('rfid/scan.php', { action: 'list_assets' }, function(response) {
            if (response.result && response.response && response.response.assets) {
                var optGroup = document.createElement('optgroup');
                optGroup.label = 'Geraete (Assets)';
                response.response.assets.forEach(function(a) {
                    var opt = document.createElement('option');
                    opt.value = 'asset:' + a.assets_id;
