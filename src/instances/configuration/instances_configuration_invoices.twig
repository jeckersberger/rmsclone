{% extends "assets/template.twig" %}
{% block content %}
{% include 'instances/configuration/_settings_nav.twig' with { active: 'invoices' } %}
<div class="row">
    <div class="col-12 col-md-8 offset-md-2">
        <div class="card ">
                <div class="card-header">
                    <h3 class="card-title">{{ t('project_invoice_footer') }}</h3>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="instances_quoteTerms">{{ t('quotation_footer') }}</label>
                        <textarea class="form-control" id="instances_quoteTerms" placeholder="Text hier eingeben" style="width: 100%; height: 200px; font-size: 14px; line-height: 18px; border: 1px solid #dddddd; padding: 10px;">{{ USERDATA.instance.instances_quoteTerms }}</textarea>
                    </div>
                    <div class="form-group">
                        <label for="instances_termsAndPayment">{{ t('invoice_footer') }}</label>
                        <textarea class="form-control" id="instances_termsAndPayment" placeholder="Text hier eingeben" style="width: 100%; height: 200px; font-size: 14px; line-height: 18px; border: 1px solid #dddddd; padding: 10px;">{{ USERDATA.instance.instances_termsAndPayment }}</textarea>
                    </div>
                </div>
                <div class="card-footer">
                    {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
                    <button id="saveTermsAndPayment" class="btn btn-primary">{{ t('save') }}</button>
                    {% endif %}
                </div>
            <script>
                $(document).ready(function() {
                    {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
                    $('#saveTermsAndPayment').on('click', function() {
                        ajaxcall("instances/editInstance.php", {
                            'formData': [
                                { 'name': 'instances_termsAndPayment','value':$('#instances_termsAndPayment').val() },
                                { 'name': 'instances_quoteTerms','value':$('#instances_quoteTerms').val() }
                            ]
                        }, function (data) {
                            location.reload();
                        }, false);
                    });
                    {% endif %}
                });
            </script>
        </div>
   </div>
</div>
{% endblock %}
