{% extends "assets/template.twig" %}

{% block content %}
	<div class="row">
	<div class="col-lg-12 col-md-12">
		<div class="card">
			<div class="card-header">
				<ul class="nav nav-pills">
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/navigation.php"><i class="fas fa-arrow-left"></i> Zurück zu Einstellungen</span></a></li>
					{% if "BUSINESS:USERS:VIEW:LIST"|instancePermissions %}
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/users.php">Benutzer</a></li>
					{% endif %}
					{% if "BUSINESS:ROLES_AND_PERMISSIONS:VIEW"|instancePermissions %}
					<li class="nav-item"><a class="nav-link active" href="{{CONFIG.ROOTURL}}/instances/permissions.php">Berechtigungen</a></li>
					{% endif %}
					{% if "BUSINESS:USER_SIGNUP_CODES:VIEW"|instancePermissions %}
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/signupCodes.php">Beitrittscodes</a></li>
					{% endif %}
					{% if "BUSINESS:SETTINGS:EDIT:TRUSTED_DOMAINS"|instancePermissions %}
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/trustedDomains.php">Vertrauenswürdige Domains</a></li>
					{% endif %}
				</ul>
			</div>
		</div>
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Unternehmensberechtigungen</h3>
				{% if "BUSINESS:ROLES_AND_PERMISSIONS:CREATE"|instancePermissions %}
				<div class="card-tools pull-right">
					<button type="button" class="btn btn-sm btn-success mr-2" id="applyRoleTemplates"><i class="fa fa-magic"></i> Standard-Rollen anlegen</button>
					<button type="button" class="btn btn-tool" id="addNewInstancePosition"><i class="fa fa-plus"></i>
					</button>
				</div>
				{% endif %}
			</div>
			{% if "BUSINESS:ROLES_AND_PERMISSIONS:CREATE"|instancePermissions %}
			<div class="card-body pb-0 pt-2" id="roleTemplatesPanel" style="display:none; background:#f8f9fa; border-bottom:1px solid #dee2e6;">
				<p class="mb-2"><strong>Rollenvorlagen:</strong> Legen Sie vordefinierte Rollen mit passenden Berechtigungen an. Bestehende Rollen werden nicht ueberschrieben.</p>
				<div class="row mb-2" id="roleTemplatesList"></div>
			</div>
			{% endif %}
			<div class="card-body table-responsive p-0" style="overflow-x: auto; height: 800px;">
				<table class="table table-head-fixed" >
					<thead>
						<tr>
							<th style="font-weight: normal; width:30%">Code</th>
							<th style="font-weight: normal;">Kategorie</th>
							<th style="font-weight: normal;">Tabelle</th>
							<th style="font-weight: normal;">Typ</th>
							<th style="font-weight: normal;">Element</th>
							{% for position in positions %}
							<th style="width: 1px;">{{position.instancePositions_displayName}}</th>
							{% endfor %}
						</tr>
					</thead>
					<tbody>
						{% for action in actions %}
							{% if action.Category != currentCategory %}
							<tr style="border-top:2px solid black !important">
							{% elseif action.Table != currentTable %}
							<tr style="border-top:2px dashed black !important">
							{% else %}
							<tr>
							{% endif %}
								<td class="text-wrap" style="max-width: 200px;">
									{{ action.key }}
									{% if action.Comment %}<br/>{{ action.Comment }}{% endif %}
									{% if action.Caution %}<br/><span class="badge badge-danger">{{ action.Caution }}</span>{% endif %}
								</td>
								{% if action.Category != currentCategory %} <td rowspan="{{ actionTypeCounts[action.Category]['Count'] }}">{{ action.Category }}</td> {% set currentCategory = action.Category %}{% set currentTable = null %}{% endif %}
								{% if action.Table != currentTable %} <td rowspan="{{ actionTypeCounts[action.Category]['Tables'][action.Table]['Count'] }}">{{ action.Table }}</td> {% set currentTable = action.Table %}{% set currentType = null %}{% endif %}
								{% if action.Type != currentType %} <td rowspan="{{ actionTypeCounts[action.Category]['Tables'][action.Table]['Types'][action.Type] }}">{{ action.Type }}</td> {% set currentType = action.Type %}{% endif %}
								<td>{{ action.Detail }}</td>
								{% for position in positions %}
									{% set positioncannotbecausedep = "false" %}
									<td>
										{% for dependentactionid in action.Dependencies %}
											{% if dependentactionid != "" and dependentactionid not in position.instancePositions_actions|split(',') %}
												<span class="badge badge-warning" title="Erfordert {{ dependentactionid }} als Voraussetzung">*</span>
												{% set positioncannotbecausedep = "true" %}
											{% endif %}
										{% endfor %}

										{% if "BUSINESS:ROLES_AND_PERMISSIONS:EDIT"|instancePermissions %}
											<input type="checkbox" data-permissionid="{{action.key}}" data-cautiontext="{{ action.Caution|escape("html_attr") }}" data-positionid="{{position.instancePositions_id}}" {% if action.key in position.instancePositions_actions|split(',') %}checked{% endif %}  {% if positioncannotbecausedep == "true" %}disabled{% endif %} />
										{% else %}
											{% if action.key in position.instancePositions_actions|split(',') %}
												<div class="custom-control custom-switch custom-switch-off-danger custom-switch-on-success">
													<input type="checkbox" checked disabled class="custom-control-input">
													<label class="custom-control-label"></label>
												</div>
											{% else %}
												<div class="custom-control custom-switch custom-switch-off-danger custom-switch-on-success">
													<input type="checkbox" disabled class="custom-control-input">
													<label class="custom-control-label"></label>
												</div>
											{% endif %}
										{% endif %}
									</td>
								{% endfor %}
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
			<div class="overlay" id="loading">
				<i class="fas fa-sync fa-spin fa-3x"></i>
			</div>
		</div>
	</div>
</div>
{% if "BUSINESS:ROLES_AND_PERMISSIONS:EDIT"|instancePermissions %}
<script>
$(document).ready(function() {

	function updatePermission(checkbox){
		let permissionid = $(checkbox).data("permissionid");
		$("#loading").show();
		if($(checkbox).is(":checked")) {
			var get = "addpermission=" + permissionid;
		} else {
			var get = "removepermission=" + permissionid;
		}
		$.ajax({
			url: "{{CONFIG.ROOTURL}}/api/permissions/instancePermissionsEditor.php?" + get + "&position=" + $(checkbox).data("positionid"),
			cache : false,
			success: function(result){
				if (result == '1') {
					$("#loading").hide();
                    location.reload();
				} else {
					bootbox.alert(result + "Vorgang konnte nicht abgeschlossen werden! Bitte versuchen Sie es erneut!", function() {
						location.reload();
					});
				}
			}
		});
	}

	$("#loading").hide();
	$(':checkbox').change(function() {
		let checkbox = $(this);
		let permissionid = checkbox.data("permissionid")
		let cautionText = checkbox.data("cautiontext")
		//show a popup if this is a signup code permission
		if (checkbox.is(":checked") && cautionText !== null && cautionText.length > 0) {
			bootbox.confirm({
				title: "Warnung - mögliche Rechteerweiterung",
				message: cautionText + "<br /><br />Diese Berechtigung ist normalerweise nur für Administratoren aktiviert. Sind Sie sicher, dass Sie sie aktivieren möchten?",
				buttons: {
					confirm: {
						label: 'Ja',
					},
					cancel: {
						label: 'Nein',
					},
				},
				callback: function (result) {
					if (result){
						updatePermission(checkbox);
					} else {
						location.reload();
					}
				}
			})
		} else {
			updatePermission(checkbox);
		}	
	});
});
</script>
{% else %}
<script>
	$(document).ready(function() {
		$("#loading").hide();
	});
</script>
{% endif %}

	{% if "BUSINESS:ROLES_AND_PERMISSIONS:CREATE"|instancePermissions %}
	<script>
		$(document).ready(function() {
			$("#addNewInstancePosition").on("click", function () {
				bootbox.prompt("Rollengruppennamen eingeben", function(result){
					if (result) {
						ajaxcall("permissions/newInstancePosition.php", {"name": result}, function() {
							location.reload();
						}, true);
					}
				});
			});

			// Rollenvorlagen
			$("#applyRoleTemplates").on("click", function() {
				var panel = $("#roleTemplatesPanel");
				if (panel.is(":visible")) {
					panel.slideUp();
					return;
				}

				// Vorlagen laden
				$.ajax({
					url: "{{CONFIG.ROOTURL}}/api/permissions/roleTemplates.php",
					type: "GET",
					dataType: "json",
					success: function(response) {
						if (response.result && response.response.templates) {
							var html = '';
							var templates = response.response.templates;
							for (var i = 0; i < templates.length; i++) {
								var t = templates[i];
								html += '<div class="col-lg-2 col-md-4 col-6 mb-2">';
								html += '<div class="card card-outline card-primary h-100 mb-0">';
								html += '<div class="card-body p-2 text-center">';
								html += '<h6 class="mb-1">' + t.name + '</h6>';
								html += '<small class="text-muted d-block mb-2">' + t.description + '</small>';
								html += '<small class="badge badge-info mb-2">' + t.permissionCount + ' Berechtigungen</small><br>';
								html += '<button class="btn btn-xs btn-outline-primary applyOneTemplate" data-key="' + t.key + '">Anlegen</button>';
								html += '</div></div></div>';
							}
							html += '<div class="col-12 mb-2">';
							html += '<button class="btn btn-sm btn-primary" id="applyAllTemplates"><i class="fa fa-check-double"></i> Alle Rollen anlegen</button>';
							html += '</div>';
							$("#roleTemplatesList").html(html);
							panel.slideDown();
						}
					}
				});
			});

			// Einzelne Vorlage anlegen
			$(document).on("click", ".applyOneTemplate", function() {
				var btn = $(this);
				var key = btn.data("key");
				btn.prop("disabled", true).text("...");
				$.ajax({
					url: "{{CONFIG.ROOTURL}}/api/permissions/applyRoleTemplates.php",
					type: "POST",
					data: { template: key },
					dataType: "json",
					success: function(response) {
						if (response.result) {
							btn.removeClass("btn-outline-primary").addClass("btn-success").html('<i class="fa fa-check"></i> Angelegt');
							setTimeout(function() { location.reload(); }, 800);
						} else {
							btn.prop("disabled", false).text("Fehler");
							bootbox.alert(response.error ? response.error.message : "Fehler beim Anlegen");
						}
					}
				});
			});

			// Alle Vorlagen anlegen
			$(document).on("click", "#applyAllTemplates", function() {
				var btn = $(this);
				bootbox.confirm({
					title: "Alle Standard-Rollen anlegen?",
					message: "Es werden 6 Rollenvorlagen angelegt: Administrator, Buchhaltung, Projektleiter, Lager/Technik, Mitarbeiter, Externer Zugang.<br><br>Bereits vorhandene Rollen mit gleichem Namen werden nicht ueberschrieben.",
					buttons: {
						confirm: { label: 'Ja, alle anlegen', className: 'btn-primary' },
						cancel: { label: 'Abbrechen' }
					},
					callback: function(result) {
						if (result) {
							btn.prop("disabled", true).html('<i class="fa fa-spinner fa-spin"></i> Wird angelegt...');
							$.ajax({
								url: "{{CONFIG.ROOTURL}}/api/permissions/applyRoleTemplates.php",
								type: "POST",
								dataType: "json",
								success: function(response) {
									if (response.result) {
										var r = response.response;
										bootbox.alert(r.created + " Rollen angelegt, " + r.skipped + " uebersprungen.", function() {
											location.reload();
										});
									} else {
										btn.prop("disabled", false).html('<i class="fa fa-check-double"></i> Alle Rollen anlegen');
										bootbox.alert("Fehler: " + (response.error ? response.error.message : "Unbekannt"));
									}
								}
							});
						}
					}
				});
			});
		});
	</script>
	{% endif %}
{% endblock %}
