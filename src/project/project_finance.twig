<div class="row">
	<div class="col-lg-6 col-md-6 col-sm-12">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">{{ t('overview') }}</h3>
			</div>
			<div class="card-body p-0">
				<table class="table">
					<tr>
						<td style="width: 35%;">
							{{ t('equipment_subtotal') }}
						</td>
						<td style="width: 15%;text-align: right;">
							{{ FINANCIALS.prices.subTotal|money }}
						</td>
						<td style="width: 35%;">
							{{ t('sales') }}
						</td>
						<td style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.sales.total|money }}
						</td>
					</tr>
					<tr>
						<td style="width: 35%;">
							{% if FINANCIALS.prices.discounts|moneyPositive %}{{ t('discounts') }}{% else %}{{ t('adjustments') }}
							{% endif %}
						</td>
						<td style="width: 15%;text-align: right;">
							{% if FINANCIALS.prices.discounts|moneyPositive %}&#8209;{{ FINANCIALS.prices.discounts|money }}{% else %}-
							{% endif %}
						</td>
						<td style="width: 35%;">
							{{ t('staffing') }}
						</td>
						<td style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.staff.total|money }}
						</td>
					</tr>
					<tr>
						<td style="width: 35%;">
							<b>{{ t('equipment_total') }}</b>
						</td>
						<td style="width: 15%;text-align: right;">
							{{ FINANCIALS.prices.total|money }}
						</td>
						<td style="width: 35%;">
							{{ t('additional_hires') }}
						</td>
						<td style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.subHire.total|money }}
						</td>
					</tr>
					<tr style="background-color: rgba(0,0,0,.03);">
                        <td style="width: 35%;"></td>
						<td style="width: 15%;text-align: right;"></td>
						<td style="width: 35%;">
							<b>{{ t('subtotal') }}</b>
						</td>
						<td style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.subTotal|money }}
						</td>
					</tr>
                    <tr>
						<td style="width: 35%;"></td>
						<td style="width: 10%;"></td>
						<td style="width: 40%;">
							{{ t('payments_received') }}
						</td>
						<td style="width: 15%;text-align: right;">
							&#8209;{{ FINANCIALS.payments.received.total|money }}
						</td>
					</tr>
					<tr>
						<td style="width: 35%;"></td>
						<td style="width: 15%;text-align: right;"></td>
						<td style="width: 35%;">
							<b>{{ t('grand_total_outstanding') }}</b>
						</td>
						<td style="width: 15%;text-align: right;">
							{{ FINANCIALS.payments.total|money }}
						</td>
					</tr>
				</table>
			</div>
			<div class="card-footer">
				<div class="btn-group float-left">
					<button type="button" class="btn btn-outline-info btn-sm" id="btnAiProjectSummary" onclick="aiProjectSummary()" title="KI-Zusammenfassung"><i class="fas fa-robot"></i> Zusammenfassung</button>
					<button type="button" class="btn btn-outline-success btn-sm" id="btnAiQuoteAssist" onclick="aiQuoteAssist()" title="KI-Angebot"><i class="fas fa-robot"></i> Angebot-Hilfe</button>
				</div>
				<div class="btn-group float-right">
					<a href="{{ CONFIG.LINKS_USERGUIDEURL }}projects/finance" target="_blank" type="button" class="btn btn-info">{{ t('help') }}</a>

					{% if "PROJECTS:PROJECT_PAYMENTS:CREATE"|instancePermissions %}
						<button type="button" class="btn btn-default newPayment" data-type="1">{{ t('add_payment_received') }}</button>
						<button type="button" class="btn btn-default dropdown-toggle dropdown-icon" data-toggle="dropdown">
							<span class="sr-only">Toggle Dropdown</span>
							<div class="dropdown-menu" role="menu">
								<a class="dropdown-item newPayment" data-type="2" href="#">{{ t('add_sales_item') }}</a>
								<a class="dropdown-item newPayment" data-type="3" href="#">{{ t('add_additional_hire') }}</a>
								<a class="dropdown-item newPayment" data-type="4" href="#">{{ t('add_staff_cost') }}</a>
							</div>
						</button>
					{% endif %}
				</div>
			</div>
		</div>

	</div>
	<div class="col-lg-6 col-md-6 col-sm-12">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">{{ t('invoice_notes') }}</h3>
			</div>
			<div class="card-body">
				{% if project.projects_invoiceNotes|nl2br %}
					{{ project.projects_invoiceNotes|nl2br }}
				{% else %}
					<i>{{ t('none_set') }}</i>
				{% endif %}
			</div>
            {% if "PROJECTS:EDIT:INVOICE_NOTES"|instancePermissions %}
			<div class="card-footer">
				<div class="btn-group float-right">
                    <button type="button" class="btn btn-default editProjectInvoiceNotes" title="{{ t('edit') }}">{{ t('edit_invoice_notes') }}</button>
				</div>
			</div>
            {% endif %}
		</div>
        <div class="card">
			<div class="card-header">
				<h3 class="card-title">{{ t('delivery_notes') }}</h3>
			</div>
			<div class="card-body">
				{% if project.projects_deliveryNotes|nl2br %}
					{{ project.projects_deliveryNotes|nl2br }}
				{% else %}
					<i>{{ t('none_set') }}</i>
				{% endif %}
			</div>
            {% if "PROJECTS:EDIT:DELIVERY_NOTES"|instancePermissions %}
			<div class="card-footer">
				<div class="btn-group float-right">
                    <button type="button" class="btn btn-default editProjectDeliveryNotes" title="{{ t('edit') }}">{{ t('edit_delivery_notes') }}</button>
				</div>
			</div>
            {% endif %}
		</div>
	</div>
</div>
<div class="row">
	<div class="col-lg-6 col-md-6 col-sm-12">
		{% if FINANCIALS.payments.sales.ledger %}
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">{{ t('sales') }}</h3>
				</div>
				<div class="card-body p-0">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>{{ t('quantity') }}</th>
								<th style="width: 100%;">{{ t('description') }}</th>
								<th>{{ t('amount') }}</th>
								<th>{{ t('total') }}</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% set currentSupplier = "" %}
							{% for payment in FINANCIALS.payments.sales.ledger %}
								{% if currentSupplier != payment.payments_supplier %}
									{% set currentSupplier = payment.payments_supplier %}
									{% if payment.payments_supplier != "" %}
										<tr>
											<td colspan="99" style="background-color: #F5F5F5;">
												<b>{{ payment.payments_supplier }}</b>
											</td>
										</tr>
									{% endif %}
								{% endif %}
								<tr>
									<td style="width: 10px;">{{ payment.payments_quantity }}x</td>
									<td>{{ payment.payments_comment|nl2br }}</td>
									<td style="width:100px;">{{ payment.payments_amount|money }}</td>
									<td style="width:100px;text-align: right;">{{ payment.payments_amountTotal|money }}</td>
									<td>
										{% if  CONFIG.FILES_ENABLED == "Enabled" and "PROJECTS:PROJECT_PAYMENTS:VIEW:FILE_ATTACHMENTS"|instancePermissions %}
											<button data-toggle="modal" data-target="#filesModal{{ payment.payments_id }}" type="button" class="btn btn-outline-secondary btn-sm">{{ (payment.files|length > 0 ? payment.files|length ~ '&nbsp;' : '')|raw }}<i class="fas fa-paperclip" style="display:inline;"></i>
											</button>
										{% endif %}
										{% if "PROJECTS:PROJECT_PAYMENTS:DELETE"|instancePermissions %}
											<button title="{{ t('delete') }}" class="btn btn-sm btn-danger deletePaymentButton" data-paymentid="{{ payment.payments_id }}">
												<i class="fa fa-trash"></i>
											</button>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% endif %}
		{% if FINANCIALS.payments.subHire.ledger %}
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">{{ t('additional_hires') }}</h3>
				</div>
				<div class="card-body p-0">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>{{ t('quantity') }}</th>
								<th style="width: 100%;">{{ t('description') }}</th>
								<th>{{ t('amount') }}</th>
								<th>{{ t('total') }}</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% set currentSupplier = "" %}
							{% for payment in FINANCIALS.payments.subHire.ledger %}
								{% if currentSupplier != payment.payments_supplier %}
									{% set currentSupplier = payment.payments_supplier %}
									{% if payment.payments_supplier != "" %}
										<tr>
											<td colspan="99" style="background-color: #F5F5F5;">
												<b>{{ payment.payments_supplier }}</b>
											</td>
										</tr>
									{% endif %}
								{% endif %}
								<tr>
									<td style="width: 10px;">{{ payment.payments_quantity }}x</td>
									<td>{{ payment.payments_comment|nl2br }}</td>
									<td style="width:100px;">{{ payment.payments_amount|money }}</td>
									<td style="width:100px;text-align: right;">{{ payment.payments_amountTotal|money }}</td>
									<td>
										{% if CONFIG.FILES_ENABLED == "Enabled" and "PROJECTS:PROJECT_PAYMENTS:VIEW:FILE_ATTACHMENTS"|instancePermissions %}
											<button data-toggle="modal" data-target="#filesModal{{ payment.payments_id }}" type="button" class="btn btn-outline-secondary btn-sm">{{ (payment.files|length > 0 ? payment.files|length ~ '&nbsp;' : '')|raw }}<i class="fas fa-paperclip" style="display:inline;"></i>
											</button>
										{% endif %}
										{% if "PROJECTS:PROJECT_PAYMENTS:DELETE"|instancePermissions %}
											<button title="{{ t('delete') }}" class="btn btn-sm btn-danger deletePaymentButton" data-paymentid="{{ payment.payments_id }}">
												<i class="fa fa-trash"></i>
											</button>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% endif %}
		{% if FINANCIALS.payments.staff.ledger %}
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">{{ t('staffing') }}</h3>
				</div>
				<div class="card-body p-0">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>{{ t('quantity') }}</th>
								<th>{{ t('supplier') }}</th>
								<th style="width: 100%;">{{ t('description') }}</th>
								<th>{{ t('amount') }}</th>
								<th>{{ t('total') }}</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% for payment in FINANCIALS.payments.staff.ledger %}
								<tr>
									<td style="width: 10px;">{{ payment.payments_quantity }}x</td>
									<td>{{ payment.payments_supplier|nbsp}}</td>
									<td>{{ payment.payments_comment|nl2br }}</td>
									<td style="width:100px;">{{ payment.payments_amount|money }}</td>
									<td style="width:100px;text-align: right;">{{ payment.payments_amountTotal|money }}</td>
									<td>
										{% if CONFIG.FILES_ENABLED == "Enabled" and "PROJECTS:PROJECT_PAYMENTS:VIEW:FILE_ATTACHMENTS"|instancePermissions %}
											<button data-toggle="modal" data-target="#filesModal{{ payment.payments_id }}" type="button" class="btn btn-outline-secondary btn-sm">{{ (payment.files|length > 0 ? payment.files|length ~ '&nbsp;' : '')|raw }}<i class="fas fa-paperclip" style="display:inline;"></i>
											</button>
										{% endif %}
										{% if "PROJECTS:PROJECT_PAYMENTS:DELETE"|instancePermissions %}
											<button title="{{ t('delete') }}" class="btn btn-sm btn-danger deletePaymentButton" data-paymentid="{{ payment.payments_id }}">
												<i class="fa fa-trash"></i>
											</button>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% endif %}
	</div>
	<div class="col-lg-6 col-md-6 col-sm-12">
		{% if FINANCIALS.payments.received.ledger %}
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">{{ t('payments_received') }}</h3>
				</div>
				<div class="card-body p-0">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>{{ t('reference') }}</th>
								<th>{{ t('date') }}</th>
								<th>{{ t('method') }}</th>
								<th>{{ t('comment') }}</th>
								<th>{{ t('amount') }}</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% for payment in FINANCIALS.payments.received.ledger %}
								<tr>
									<td>{{ payment.payments_reference }}</td>
									<td>{{ payment.payments_date|dateDe('d.m.Y H:i') }}</td>
									<td>{{ payment.payments_method }}</td>
									<td>{{ payment.payments_comment|nl2br }}</td>
									<td>{{ payment.payments_amount|money }}</td>
									<td>
										{% if  CONFIG.FILES_ENABLED == "Enabled" and "PROJECTS:PROJECT_PAYMENTS:VIEW:FILE_ATTACHMENTS"|instancePermissions %}
											<button data-toggle="modal" data-target="#filesModal{{ payment.payments_id }}" type="button" class="btn btn-outline-secondary btn-sm">{{ (payment.files|length > 0 ? payment.files|length ~ '&nbsp;' : '')|raw }}<i class="fas fa-paperclip" style="display:inline;"></i>
											</button>
										{% endif %}
										{% if "PROJECTS:PROJECT_PAYMENTS:DELETE"|instancePermissions %}
											<button title="{{ t('delete') }}" class="btn btn-sm btn-danger deletePaymentButton" data-paymentid="{{ payment.payments_id }}">
												<i class="fa fa-trash"></i>
											</button>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% endif %}
	</div>
</div>
<script>
function aiProjectSummary() {
    var btn = $('#btnAiProjectSummary');
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Generiere...');
    ajaxcall('ai/projectSummary.php', { project_id: {{ project.projects_id }} }, function(data) {
        btn.prop('disabled', false).html('<i class="fas fa-robot"></i> Zusammenfassung');
        if (data.response && data.response.summary) {
            bootbox.alert({
                title: '<i class="fas fa-robot text-info"></i> KI-Zusammenfassung',
                message: '<div style="white-space:pre-wrap;font-size:14px;">' + data.response.summary + '</div>'
            });
        }
    }, function() {
        btn.prop('disabled', false).html('<i class="fas fa-robot"></i> Zusammenfassung');
    });
}

function aiQuoteAssist() {
    var btn = $('#btnAiQuoteAssist');
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Generiere...');
    ajaxcall('ai/quoteAssist.php', { project_id: {{ project.projects_id }} }, function(data) {
        btn.prop('disabled', false).html('<i class="fas fa-robot"></i> Angebot-Hilfe');
        if (data.response && data.response.suggestions) {
            bootbox.alert({
                title: '<i class="fas fa-robot text-info"></i> Angebotsvorschlag',
                message: '<div style="white-space:pre-wrap;font-size:14px;">' + data.response.suggestions + '</div>'
            });
        }
    }, function() {
        btn.prop('disabled', false).html('<i class="fas fa-robot"></i> Angebot-Hilfe');
    });
}
</script>
