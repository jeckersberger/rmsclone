{# Document Lifecycle panel - embedded in project_index.twig #}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-file-invoice"></i> {{ t('document_lifecycle') }}</h3>
                <div class="card-tools">
                    <button class="btn btn-sm btn-outline-secondary" id="previewDocBtn"><i class="fas fa-eye"></i> Vorschau</button>
                    <button class="btn btn-sm btn-outline-warning" id="partialInvoiceBtn"><i class="fas fa-receipt"></i> Abschlagsrechnung</button>
                    <button class="btn btn-sm btn-primary" id="createDocBtn"><i class="fas fa-plus"></i> {{ t('create_document') }}</button>
                </div>
            </div>
            <div class="card-body p-0" id="docLifecycleBody">
                <div class="overlay" id="docLoadingOverlay"><i class="fas fa-sync fa-spin fa-3x"></i></div>
                <table class="table table-striped table-sm" id="docTable">
                    <thead>
                        <tr>
                            <th>{{ t('doc_number') }}</th>
                            <th>{{ t('doc_type') }}</th>
                            <th>{{ t('status') }}</th>
                            <th>{{ t('net_amount') }}</th>
                            <th>{{ t('gross_amount') }}</th>
                            <th>{{ t('date') }}</th>
                            <th>{{ t('due_date') }} / G&uuml;ltig bis</th>
                            <th>{{ t('actions') }}</th>
                        </tr>
                    </thead>
                    <tbody id="docTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# Document Chain Modal #}
<div class="modal fade" id="docChainModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">{{ t('document_chain') }}</h4>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body" id="docChainBody"></div>
        </div>
    </div>
</div>

{# PDF Preview Modal #}
<div class="modal fade" id="previewModal">
    <div class="modal-dialog modal-xl" style="max-width: 900px;">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><i class="fas fa-eye"></i> Dokumentvorschau</h4>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="previewIframe" style="width:100%; height:80vh; border:none;"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Schlie&szlig;en</button>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    var projectId = {{ project.projects_id }};
    var instanceId = {{ USERDATA.instance.instances_id }};

    var docTypeLabels = {
        'quote': '{{ t("quote") }}',
        'order_confirmation': '{{ t("order_confirmation") }}',
        'invoice': '{{ t("invoice") }}',
        'partial_invoice': 'Abschlagsrechnung',
        'credit_note': '{{ t("credit_note") }}',
        'cancellation': '{{ t("cancellation_doc") }}'
    };
    var statusLabels = {
        'draft': '{{ t("status_draft") }}',
        'sent': '{{ t("status_sent") }}',
        'accepted': '{{ t("status_accepted") }}',
        'rejected': '{{ t("status_rejected") }}',
        'paid': '{{ t("status_paid") }}',
        'overdue': '{{ t("status_overdue") }}',
        'reminded': '{{ t("status_reminded") }}',
        'cancelled': '{{ t("status_cancelled") }}',
        'expired': 'Abgelaufen'
    };
    var statusBadges = {
        'draft': 'secondary', 'sent': 'info', 'accepted': 'success',
        'rejected': 'danger', 'paid': 'success', 'overdue': 'warning',
        'reminded': 'warning', 'cancelled': 'dark', 'expired': 'danger'
    };

    function loadDocuments() {
        ajaxcall('documentLifecycle/list.php', {project_id: projectId}, function(data) {
            var html = '';
            if (data.response && data.response.documents) {
                data.response.documents.forEach(function(doc) {
                    html += '<tr>';
                    html += '<td>' + (doc.doc_number || '-') + '</td>';
                    var typeLabel = docTypeLabels[doc.doc_type] || doc.doc_type;
                    if (doc.doc_type === 'partial_invoice' && doc.partial_invoice_number) {
                        typeLabel += ' #' + doc.partial_invoice_number;
                        if (doc.partial_invoice_pct) typeLabel += ' (' + doc.partial_invoice_pct + '%)';
                    }
                    if (doc.is_final_invoice == 1) {
                        typeLabel = '<strong>Schlussrechnung</strong>';
                    }
                    // Versionsnummer fuer Angebote anzeigen
                    if (doc.doc_type === 'quote' && doc.version) {
                        typeLabel += ' <span class="badge badge-light" title="Version ' + doc.version + '">v' + doc.version + '</span>';
                    }
                    html += '<td>' + typeLabel + '</td>';
                    var statusHtml = '<span class="badge badge-' + (statusBadges[doc.status] || 'secondary') + '">' + (statusLabels[doc.status] || doc.status) + '</span>';
                    if (doc.is_expired) {
                        statusHtml += ' <span class="badge badge-danger" title="Angebot abgelaufen"><i class="fas fa-clock"></i> Abgelaufen</span>';
                    }
                    // Zahlungsstatus-Badge fuer Rechnungen
                    if ((doc.doc_type === 'invoice' || doc.doc_type === 'partial_invoice') && doc.document_exports_paymentStatus) {
                        var payBadges = {'unpaid': 'danger', 'partial': 'warning', 'paid': 'success'};
                        var payLabels = {'unpaid': 'Unbezahlt', 'partial': 'Teilbezahlt', 'paid': 'Bezahlt'};
                        var ps = doc.document_exports_paymentStatus;
                        if (ps !== 'unpaid' || (doc.status !== 'draft' && doc.status !== 'paid')) {
                            statusHtml += ' <span class="badge badge-' + (payBadges[ps] || 'secondary') + '" title="Zahlungsstatus"><i class="fas fa-coins"></i> ' + (payLabels[ps] || ps) + '</span>';
                        }
                    }
                    html += '<td>' + statusHtml + '</td>';
                    html += '<td>' + formatMoney(doc.net_amount) + '</td>';
                    var grossCol = formatMoney(doc.gross_amount);
                    if ((doc.doc_type === 'invoice' || doc.doc_type === 'partial_invoice') && parseFloat(doc.paid_amount || 0) > 0 && doc.status !== 'paid') {
                        var remaining = parseFloat(doc.gross_amount) - parseFloat(doc.paid_amount);
                        grossCol += '<br><small class="text-success">Bezahlt: ' + formatMoney(doc.paid_amount) + '</small>';
                        grossCol += '<br><small class="text-danger">Offen: ' + formatMoney(remaining) + '</small>';
                    }
                    html += '<td>' + grossCol + '</td>';
                    html += '<td>' + (doc.created_at ? doc.created_at.substring(0,10) : '-') + '</td>';
                    var dueDateHtml = doc.due_date || '-';
                    if (doc.doc_type === 'quote' && doc.valid_until) {
                        dueDateHtml = '<small class="text-muted">G&uuml;ltig bis:</small><br>' + doc.valid_until;
                        if (doc.is_expired) {
                            dueDateHtml += ' <span class="text-danger"><i class="fas fa-exclamation-triangle"></i></span>';
                        }
                    }
                    html += '<td>' + dueDateHtml + '</td>';
                    html += '<td>';
                    html += '<div class="btn-group btn-group-sm">';
                    if (doc.s3files_id) {
                        html += '<a href="{{ CONFIG.ROOTURL }}/api/file/?r=true&f=' + doc.s3files_id + '" class="btn btn-default" title="{{ t("download") }}"><i class="fas fa-download"></i></a>';
                        html += '<button class="btn btn-default docEmailBtn" data-s3id="' + doc.s3files_id + '" data-number="' + (doc.doc_number || '') + '" data-type="' + doc.doc_type + '" title="{{ t("send_email") }}"><i class="fas fa-envelope"></i></button>';
                    }
                    if (doc.zugferd_s3files_id) {
                        html += '<a href="{{ CONFIG.ROOTURL }}/api/file/?r=true&f=' + doc.zugferd_s3files_id + '" class="btn btn-outline-info btn-sm" title="ZUGFeRD XML herunterladen"><i class="fas fa-file-code"></i> ZUGFeRD</a>';
                    }
                    html += '<button class="btn btn-default docStatusBtn" data-id="' + doc.id + '" data-type="' + doc.doc_type + '" data-status="' + doc.status + '" title="{{ t("change_status") }}"><i class="fas fa-exchange-alt"></i></button>';
                    if (doc.doc_type === 'quote' && doc.status === 'accepted') {
                        html += '<button class="btn btn-success docQuickConvertBtn" data-id="' + doc.id + '" data-target="order_confirmation" title="{{ t("quick_convert_to_order") }}"><i class="fas fa-arrow-right"></i> {{ t("order_confirmation") }}</button>';
                    } else if (doc.doc_type === 'quote' && doc.status !== 'cancelled' && doc.status !== 'rejected') {
                        html += '<button class="btn btn-outline-success btn-sm docQuickAcceptConvertBtn" data-id="' + doc.id + '" title="{{ t("accept_and_convert") }}"><i class="fas fa-check-double"></i></button>';
                    }
                    if (doc.doc_type === 'order_confirmation') {
                        html += '<button class="btn btn-primary btn-sm docQuickConvertBtn" data-id="' + doc.id + '" data-target="invoice" title="{{ t("quick_convert_to_invoice") }}"><i class="fas fa-arrow-right"></i> {{ t("invoice") }}</button>';
                    }
                    if ((doc.doc_type === 'invoice' || doc.doc_type === 'partial_invoice') && doc.status !== 'paid' && doc.status !== 'cancelled') {
                        html += '<button class="btn btn-success btn-sm docMarkPaidBtn" data-id="' + doc.id + '" data-gross="' + doc.gross_amount + '" data-paid="' + (doc.paid_amount || 0) + '" data-exports-id="' + (doc.document_exports_id || '') + '" title="Zahlung erfassen"><i class="fas fa-euro-sign"></i></button>';
                    }
                    if ((doc.doc_type === 'invoice' || doc.doc_type === 'partial_invoice') && doc.document_exports_id) {
                        html += '<button class="btn btn-outline-info btn-sm docPaymentHistoryBtn" data-exports-id="' + doc.document_exports_id + '" data-number="' + (doc.doc_number || '') + '" data-gross="' + doc.gross_amount + '" title="Zahlungsverlauf anzeigen"><i class="fas fa-list-ol"></i></button>';
                    }
                    if (doc.doc_type === 'quote' || doc.doc_type === 'order_confirmation' || doc.doc_type === 'invoice') {
                        html += '<button class="btn btn-default docConvertBtn" data-id="' + doc.id + '" data-type="' + doc.doc_type + '" title="{{ t("convert_document") }}"><i class="fas fa-arrow-right"></i></button>';
                    }
                    // Neue Version und Versionshistorie fuer Angebote
                    if (doc.doc_type === 'quote' && doc.document_exports_id) {
                        html += '<button class="btn btn-outline-primary btn-sm docNewVersionBtn" data-exports-id="' + doc.document_exports_id + '" title="Neue Version erstellen"><i class="fas fa-copy"></i> Neue Version</button>';
                        if (doc.has_versions) {
                            html += '<button class="btn btn-outline-secondary btn-sm docVersionHistoryBtn" data-exports-id="' + doc.document_exports_id + '" title="Versionshistorie anzeigen"><i class="fas fa-history"></i> ' + doc.version_count + ' Versionen</button>';
                        }
                    }
                    html += '</div>';
                    html += '</td>';
                    html += '</tr>';
                });
            }
            $('#docTableBody').html(html || '<tr><td colspan="8" class="text-center text-muted">{{ t("no_documents") }}</td></tr>');
            $('#docLoadingOverlay').hide();
        }, false);
    }

    function formatMoney(val) {
        return parseFloat(val || 0).toFixed(2).replace('.', ',') + ' \u20AC';
    }

    loadDocuments();

    // Preview document
    $('#previewDocBtn').click(function() {
        bootbox.dialog({
            title: '<i class="fas fa-eye"></i> Dokumentvorschau',
            message: '<form id="previewDocForm">' +
                '<div class="form-group">' +
                '<label>Dokumenttyp</label>' +
                '<select class="form-control" id="previewDocType">' +
                '<option value="quote">{{ t("quote") }}</option>' +
                '<option value="invoice">{{ t("invoice") }}</option>' +
                '</select>' +
                '</div>' +
                '</form>',
            buttons: {
                cancel: { label: 'Abbrechen', className: 'btn-default' },
                confirm: {
                    label: '<i class="fas fa-eye"></i> Vorschau anzeigen',
                    className: 'btn-info',
                    callback: function() {
                        var docType = $('#previewDocType').val();
                        // Build form and submit to iframe
                        var form = $('<form>', {
                            method: 'POST',
                            action: '{{ CONFIG.ROOTURL }}/api/documentLifecycle/preview.php',
                            target: 'previewIframe'
                        });
                        form.append($('<input>', {type: 'hidden', name: 'project_id', value: projectId}));
                        form.append($('<input>', {type: 'hidden', name: 'doc_type', value: docType}));
                        form.append($('<input>', {type: 'hidden', name: 'csrf_token', value: $('meta[name="csrf-token"]').attr('content') || ''}));
                        form.appendTo('body');
                        // Set iframe name attribute
                        $('#previewIframe').attr('name', 'previewIframe');
                        form.submit();
                        form.remove();
                        $('#previewModal').modal('show');
                    }
                }
            }
        });
    });

    // Create document
    $('#createDocBtn').click(function() {
        var defaultValidUntil = new Date();
        defaultValidUntil.setDate(defaultValidUntil.getDate() + 30);
        var validUntilStr = defaultValidUntil.toISOString().substring(0, 10);

        bootbox.dialog({
            title: '{{ t("create_document") }}',
            message: '<form id="createDocForm">' +
                '<div class="form-group">' +
                '<label>Dokumenttyp</label>' +
                '<select class="form-control" id="createDocType">' +
                '<option value="quote">{{ t("quote") }}</option>' +
                '<option value="order_confirmation">{{ t("order_confirmation") }}</option>' +
                '<option value="invoice">{{ t("invoice") }}</option>' +
                '</select>' +
                '</div>' +
                '<div class="form-group" id="validUntilGroup">' +
                '<label>G&uuml;ltig bis</label>' +
                '<input type="date" class="form-control" id="createDocValidUntil" value="' + validUntilStr + '">' +
                '<small class="text-muted">Standard: 30 Tage ab heute</small>' +
                '</div>' +
                '</form>',
            onShown: function() {
                $('#createDocType').change(function() {
                    $('#validUntilGroup').toggle($(this).val() === 'quote');
                });
            },
            buttons: {
                cancel: { label: 'Abbrechen', className: 'btn-default' },
                confirm: {
                    label: '<i class="fas fa-plus"></i> Erstellen',
                    className: 'btn-primary',
                    callback: function() {
                        var docType = $('#createDocType').val();
                        if (!docType) return;
                        if (docType === 'invoice') {
                            showInvoiceOptionsDialog(docType);
                            return;
                        }
                        var url = '{{ CONFIG.ROOTURL }}/project/projectInvoice.php?id=' + projectId + '&type=' + (docType === 'order_confirmation' ? 'invoice' : docType);
                        if (docType === 'quote') {
                            var validUntil = $('#createDocValidUntil').val();
                            if (validUntil) {
                                url += '&valid_until=' + encodeURIComponent(validUntil);
                            }
                        }
                        window.location.href = url;
                    }
                }
            }
        });
    });

    // Invoice creation dialog with Skonto option
    function showInvoiceOptionsDialog(docType) {
        var defaultSkontoRate = {{ USERDATA.instance.instances_skontoRate ?? 0 }};
        var defaultSkontoDays = {{ USERDATA.instance.instances_skontoDays ?? 0 }};

        bootbox.dialog({
            title: '<i class="fas fa-file-invoice"></i> Rechnung erstellen',
            message: '<form id="invoiceOptionsForm">' +
                '<div class="form-group">' +
                '<div class="custom-control custom-checkbox">' +
                '<input type="checkbox" class="custom-control-input" id="skontoEnabled">' +
                '<label class="custom-control-label" for="skontoEnabled"><strong>Skonto gewaehren</strong></label>' +
                '</div>' +
                '</div>' +
                '<div id="skontoFields" style="display:none; margin-left: 20px;">' +
                '<div class="row">' +
                '<div class="col-6"><div class="form-group">' +
                '<label>Skonto-Satz (%)</label>' +
                '<input type="number" step="0.01" min="0" max="100" class="form-control" id="skontoRate" value="' + defaultSkontoRate + '">' +
                '</div></div>' +
                '<div class="col-6"><div class="form-group">' +
                '<label>Skontofrist (Tage)</label>' +
                '<input type="number" min="1" class="form-control" id="skontoDays" value="' + defaultSkontoDays + '">' +
                '</div></div>' +
                '</div>' +
                '</div>' +
                '</form>',
            onShown: function() {
                $('#skontoEnabled').change(function() {
                    $('#skontoFields').toggle(this.checked);
                });
            },
            buttons: {
                cancel: { label: 'Abbrechen', className: 'btn-default' },
                confirm: {
                    label: '<i class="fas fa-file-invoice"></i> Rechnung erstellen',
                    className: 'btn-primary',
                    callback: function() {
                        var url = '{{ CONFIG.ROOTURL }}/project/projectInvoice.php?id=' + projectId + '&type=invoice';
                        if ($('#skontoEnabled').is(':checked')) {
                            url += '&skonto_enabled=1';
                            url += '&skonto_rate=' + encodeURIComponent($('#skontoRate').val());
                            url += '&skonto_days=' + encodeURIComponent($('#skontoDays').val());
                        }
                        window.location.href = url;
                    }
                }
            }
        });
    }

    // Change status
    $(document).on('click', '.docStatusBtn', function() {
        var docId = $(this).data('id');
        var currentStatus = $(this).data('status');
        var transitions = {
            'draft': ['sent'],
            'sent': ['accepted', 'rejected', 'paid', 'overdue', 'cancelled', 'expired'],
            'overdue': ['paid', 'reminded', 'cancelled'],
            'reminded': ['paid', 'overdue', 'cancelled']
        };
        var opts = (transitions[currentStatus] || []).map(function(s) {
            return {text: statusLabels[s] || s, value: s};
        });
        if (opts.length === 0) {
            bootbox.alert('{{ t("no_transitions_available") }}');
            return;
        }
        bootbox.prompt({
            title: '{{ t("change_status") }}',
            inputType: 'select',
            inputOptions: opts,
            callback: function(newStatus) {
                if (newStatus) {
                    ajaxcall('documentLifecycle/changeStatus.php', {doc_id: docId, status: newStatus}, function() {
                        loadDocuments();
                    });
                }
            }
        });
    });

    // Convert document
    $(document).on('click', '.docConvertBtn', function() {
        var docId = $(this).data('id');
        var docType = $(this).data('type');
        var convMap = {
            'quote': [{text: '{{ t("order_confirmation") }}', value: 'order_confirmation'}, {text: '{{ t("invoice") }}', value: 'invoice'}],
            'order_confirmation': [{text: '{{ t("invoice") }}', value: 'invoice'}],
            'invoice': [{text: '{{ t("credit_note") }}', value: 'credit_note'}, {text: '{{ t("cancellation_doc") }}', value: 'cancellation'}]
        };
        var opts = convMap[docType] || [];
        if (opts.length === 0) return;
        bootbox.prompt({
            title: '{{ t("convert_document") }}',
            inputType: 'select',
            inputOptions: opts,
            callback: function(targetType) {
                if (targetType) {
                    ajaxcall('documentLifecycle/convert.php', {doc_id: docId, target_type: targetType}, function() {
                        loadDocuments();
                    });
                }
            }
        });
    });

    // Quick convert (one-click: Angebot -> AB, AB -> Rechnung)
    $(document).on('click', '.docQuickConvertBtn', function() {
        var docId = $(this).data('id');
        var targetType = $(this).data('target');
        var btn = $(this);

        // Bei Konvertierung zu Rechnung: Skonto-Option anbieten
        if (targetType === 'invoice') {
            var defaultSkontoRate = {{ USERDATA.instance.instances_skontoRate ?? 0 }};
            var defaultSkontoDays = {{ USERDATA.instance.instances_skontoDays ?? 0 }};
            bootbox.dialog({
                title: '<i class="fas fa-file-invoice"></i> Rechnung erstellen',
                message: '<div class="form-check mb-2">' +
                    '<input class="form-check-input" type="checkbox" id="convSkontoEnabled">' +
                    '<label class="form-check-label" for="convSkontoEnabled"><strong>Skonto gewaehren</strong></label>' +
                    '</div>' +
                    '<div id="convSkontoFields" style="display:none; margin-left: 20px;">' +
                    '<div class="row">' +
                    '<div class="col-6"><div class="form-group"><label>Skonto-Satz (%)</label>' +
                    '<input type="number" step="0.01" min="0" max="100" class="form-control" id="convSkontoRate" value="' + defaultSkontoRate + '"></div></div>' +
                    '<div class="col-6"><div class="form-group"><label>Skontofrist (Tage)</label>' +
                    '<input type="number" min="1" class="form-control" id="convSkontoDays" value="' + defaultSkontoDays + '"></div></div>' +
                    '</div></div>',
                onShown: function() {
                    $('#convSkontoEnabled').change(function() { $('#convSkontoFields').toggle(this.checked); });
                },
                buttons: {
                    cancel: { label: 'Abbrechen', className: 'btn-default' },
                    confirm: {
                        label: '<i class="fas fa-arrow-right"></i> Rechnung erstellen',
                        className: 'btn-primary',
                        callback: function() {
                            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
                            var params = {source_doc_id: docId, target_type: targetType};
                            if ($('#convSkontoEnabled').is(':checked')) {
                                params.skonto_enabled = '1';
                                params.skonto_rate = $('#convSkontoRate').val();
                                params.skonto_days = $('#convSkontoDays').val();
                            }
                            ajaxcall('documentLifecycle/convert.php', params, function() { loadDocuments(); });
                        }
                    }
                }
            });
        } else {
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
            ajaxcall('documentLifecycle/convert.php', {source_doc_id: docId, target_type: targetType}, function() {
                loadDocuments();
            });
        }
    });

    // Accept quote and convert to order confirmation in one click
    $(document).on('click', '.docQuickAcceptConvertBtn', function() {
        var docId = $(this).data('id');
        bootbox.confirm('{{ t("accept_and_convert_confirm") }}', function(result) {
            if (result) {
                // First set status to accepted
                ajaxcall('documentLifecycle/changeStatus.php', {doc_id: docId, status: 'accepted'}, function() {
                    // Then convert to order confirmation
                    ajaxcall('documentLifecycle/convert.php', {source_doc_id: docId, target_type: 'order_confirmation'}, function() {
                        loadDocuments();
                    });
                });
            }
        });
    });

    // E-Mail versenden
    $(document).on('click', '.docEmailBtn', function() {
        var s3id = $(this).data('s3id');
        var docNumber = $(this).data('number');
        var docType = $(this).data('type');
        bootbox.confirm({
            title: '<i class="fas fa-envelope"></i> {{ t("send_email") }}',
            message: '{{ t("send_email_confirm") }}<br><small class="text-muted">{{ t("send_email_auto_hint") }}</small>',
            callback: function(result) {
                if (result) {
                    ajaxcall('invoiceMail/send.php', {
                        project_id: projectId,
                        s3file_id: s3id,
                        doc_number: docNumber,
                        doc_type: docType
                    }, function(data) {
                        bootbox.alert(data.response ? data.response.message : '{{ t("email_sent_success") }}');
                        loadDocuments();
                    });
                }
            }
        });
    });

    // ═══ Abschlagsrechnung erstellen ═══
    $('#partialInvoiceBtn').click(function() {
        // Erst Uebersicht laden
        ajaxcall('documentLifecycle/partialSummary.php', {project_id: projectId}, function(data) {
            var summary = data.response || {};
            var partials = summary.partials || [];
            var totalPct = parseFloat(summary.total_pct || 0);
            var remainingPct = parseFloat(summary.remaining_pct || 100);
            var hasFinal = summary.has_final;

            if (hasFinal) {
                bootbox.alert('Es existiert bereits eine Schlussrechnung fuer dieses Projekt.');
                return;
            }

            var summaryHtml = '';
            if (partials.length > 0) {
                summaryHtml = '<div class="alert alert-info"><strong>Bisherige Abschlagsrechnungen:</strong><ul class="mb-0">';
                partials.forEach(function(p) {
                    var status = p.status === 'paid' ? '<span class="badge badge-success">Bezahlt</span>' : '<span class="badge badge-warning">Offen</span>';
                    summaryHtml += '<li>' + (p.doc_number || '-') + ' - ' + parseFloat(p.partial_invoice_pct || 0) + '% - ' + formatMoney(p.gross_amount) + ' ' + status + '</li>';
                });
                summaryHtml += '</ul><p class="mb-0 mt-1">Bereits abgerechnet: <strong>' + totalPct + '%</strong> | Verbleibend: <strong>' + remainingPct + '%</strong></p></div>';
            }

            bootbox.dialog({
                title: '<i class="fas fa-receipt"></i> Abschlagsrechnung erstellen',
                message: summaryHtml +
                    '<form id="partialForm">' +
                    '<div class="form-group"><label>Prozentsatz der Gesamtsumme (%)</label>' +
                    '<input type="number" step="0.01" min="0.01" max="' + remainingPct + '" class="form-control" id="partialPct" value="' + Math.min(30, remainingPct) + '">' +
                    '<small class="text-muted">Maximal ' + remainingPct + '% verfuegbar</small></div>' +
                    '</form>',
                buttons: {
                    cancel: { label: 'Abbrechen', className: 'btn-default' },
                    finalInvoice: {
                        label: '<i class="fas fa-file-invoice"></i> Schlussrechnung',
                        className: 'btn-outline-success' + (partials.length === 0 ? ' d-none' : ''),
                        callback: function() {
                            bootbox.confirm('Schlussrechnung erstellen? Alle bisherigen Abschlagsrechnungen werden verrechnet.', function(ok) {
                                if (!ok) return;
                                ajaxcall('documentLifecycle/finalInvoice.php', {project_id: projectId}, function(data) {
                                    var r = data.response;
                                    bootbox.alert(
                                        '<strong>Schlussrechnung erstellt!</strong><br>' +
                                        'Nr: ' + r.doc_number + '<br>' +
                                        'Gesamtbetrag: ' + formatMoney(r.full_gross) + '<br>' +
                                        'Abzuege: -' + formatMoney(r.deducted_gross) + '<br>' +
                                        '<strong>Restbetrag: ' + formatMoney(r.remaining_gross) + '</strong>'
                                    );
                                    loadDocuments();
                                });
                            });
                            return false;
                        }
                    },
                    confirm: {
                        label: '<i class="fas fa-receipt"></i> Abschlagsrechnung erstellen',
                        className: 'btn-warning',
                        callback: function() {
                            var pct = parseFloat($('#partialPct').val());
                            if (pct <= 0 || pct > remainingPct) {
                                bootbox.alert('Ungueltiger Prozentsatz.');
                                return false;
                            }
                            ajaxcall('documentLifecycle/partialInvoice.php', {
                                project_id: projectId,
                                percentage: pct
                            }, function(data) {
                                var r = data.response;
                                bootbox.alert(
                                    '<strong>Abschlagsrechnung #' + r.partial_number + ' erstellt!</strong><br>' +
                                    'Nr: ' + r.doc_number + '<br>' +
                                    'Anteil: ' + r.partial_pct + '%<br>' +
                                    'Betrag: ' + formatMoney(r.gross_amount) + '<br>' +
                                    'Gesamt abgerechnet: ' + r.total_pct_used + '%'
                                );
                                loadDocuments();
                            });
                        }
                    }
                }
            });
        }, false);
    });

    // ═══ Neue Angebots-Version erstellen ═══
    $(document).on('click', '.docNewVersionBtn', function() {
        var exportsId = $(this).data('exports-id');
        bootbox.dialog({
            title: '<i class="fas fa-copy"></i> Neue Angebots-Version erstellen',
            message: '<form id="newVersionForm">' +
                '<div class="form-group">' +
                '<label>&Auml;nderungsnotizen <small class="text-muted">(optional)</small></label>' +
                '<textarea class="form-control" id="versionNotes" rows="3" placeholder="Beschreiben Sie die &Auml;nderungen in dieser Version..."></textarea>' +
                '</div>' +
                '</form>',
            buttons: {
                cancel: { label: 'Abbrechen', className: 'btn-default' },
                confirm: {
                    label: '<i class="fas fa-copy"></i> Version erstellen',
                    className: 'btn-primary',
                    callback: function() {
                        ajaxcall('documentLifecycle/createVersion.php', {
                            document_exports_id: exportsId,
                            version_notes: $('#versionNotes').val()
                        }, function(data) {
                            if (data.response) {
                                bootbox.alert('<strong>' + data.response.message + '</strong>');
                            }
                            loadDocuments();
                        });
                    }
                }
            }
        });
    });

    // ═══ Versionshistorie anzeigen ═══
    $(document).on('click', '.docVersionHistoryBtn', function() {
        var exportsId = $(this).data('exports-id');
        // Versionshistorie ueber einen separaten AJAX-Call laden
        ajaxcall('documentLifecycle/list.php', {project_id: projectId}, function(data) {
            if (!data.response || !data.response.documents) return;

            // Alle Angebote mit passender version_parent_id finden
            var docs = data.response.documents;
            var targetDoc = null;
            for (var i = 0; i < docs.length; i++) {
                if (docs[i].document_exports_id == exportsId) {
                    targetDoc = docs[i];
                    break;
                }
            }

            if (!targetDoc) {
                bootbox.alert('Versionsinformationen nicht gefunden.');
                return;
            }

            var parentId = targetDoc.version_parent_id || exportsId;

            // Alle Versionen dieses Angebots sammeln
            var versions = [];
            for (var i = 0; i < docs.length; i++) {
                var d = docs[i];
                if (d.doc_type === 'quote' && (d.document_exports_id == parentId || d.version_parent_id == parentId)) {
                    versions.push(d);
                }
            }

            // Nach Version sortieren
            versions.sort(function(a, b) { return (a.version || 1) - (b.version || 1); });

            var html = '<table class="table table-sm table-striped">';
            html += '<thead><tr><th>Version</th><th>Dokumentnr.</th><th>Status</th><th>Erstellt am</th><th>Aktionen</th></tr></thead>';
            html += '<tbody>';
            versions.forEach(function(v) {
                var badge = statusBadges[v.status] || 'secondary';
                var label = statusLabels[v.status] || v.status;
                var isCurrent = (v.document_exports_id == exportsId);
                html += '<tr' + (isCurrent ? ' class="table-active"' : '') + '>';
                html += '<td><strong>v' + (v.version || 1) + '</strong>' + (isCurrent ? ' <span class="badge badge-info">Aktuell</span>' : '') + '</td>';
                html += '<td>' + (v.doc_number || '-') + '</td>';
                html += '<td><span class="badge badge-' + badge + '">' + label + '</span></td>';
                html += '<td>' + (v.created_at ? v.created_at.substring(0, 10) : '-') + '</td>';
                html += '<td>';
                if (v.s3files_id) {
                    html += '<a href="{{ CONFIG.ROOTURL }}/api/file/?r=true&f=' + v.s3files_id + '" class="btn btn-sm btn-default" title="Herunterladen"><i class="fas fa-download"></i></a>';
                }
                html += '</td>';
                html += '</tr>';
            });
            html += '</tbody></table>';

            if (versions.length === 0) {
                html = '<p class="text-muted text-center">Keine Versionshistorie vorhanden.</p>';
            }

            bootbox.dialog({
                title: '<i class="fas fa-history"></i> Versionshistorie',
                message: html,
                size: 'large',
                buttons: {
                    ok: { label: 'Schlie&szlig;en', className: 'btn-default' }
                }
            });
        }, false);
    });

    // Zahlung erfassen (erweitert mit PaymentTrackingService)
    $(document).on('click', '.docMarkPaidBtn', function() {
        var docId = $(this).data('id');
        var exportsId = $(this).data('exports-id');
        var gross = parseFloat($(this).data('gross') || 0);
        var alreadyPaid = parseFloat($(this).data('paid') || 0);
        var remaining = (gross - alreadyPaid).toFixed(2);
        var today = new Date().toISOString().substring(0, 10);

        bootbox.dialog({
            title: '<i class="fas fa-euro-sign"></i> Zahlung erfassen',
            message: '<form id="paymentForm">' +
                '<p>Bruttobetrag: <strong>' + formatMoney(gross) + '</strong>' +
                (alreadyPaid > 0 ? '<br>Bereits bezahlt: ' + formatMoney(alreadyPaid) + '<br>Offen: <strong>' + formatMoney(remaining) + '</strong>' : '') + '</p>' +
                '<div class="form-group"><label>Zahlungsbetrag (EUR)</label>' +
                '<input type="number" step="0.01" min="0.01" class="form-control" id="payAmount" value="' + remaining + '"></div>' +
                '<div class="form-group"><label>Zahlungsdatum</label>' +
                '<input type="date" class="form-control" id="payDate" value="' + today + '"></div>' +
                '<div class="form-group"><label>Zahlungsart</label>' +
                '<select class="form-control" id="payMethod">' +
                '<option value="bank_transfer">Ueberweisung</option>' +
                '<option value="sepa">SEPA-Lastschrift</option>' +
                '<option value="cash">Barzahlung</option>' +
                '<option value="paypal">PayPal</option>' +
                '<option value="other">Sonstige</option>' +
                '</select></div>' +
                '<div class="form-group"><label>Referenz <small class="text-muted">(optional)</small></label>' +
                '<input type="text" class="form-control" id="payReference" placeholder="z.B. Ueberweisungsreferenz"></div>' +
                '<div class="form-group"><label>Bemerkungen <small class="text-muted">(optional)</small></label>' +
                '<textarea class="form-control" id="payNotes" rows="2"></textarea></div>' +
                '</form>',
            buttons: {
                cancel: { label: 'Abbrechen', className: 'btn-default' },
                confirm: {
                    label: '<i class="fas fa-check"></i> Zahlung buchen',
                    className: 'btn-success',
                    callback: function() {
                        var payAmount = parseFloat($('#payAmount').val());
                        if (exportsId) {
                            // Neues PaymentTracking-System verwenden
                            ajaxcall('payments/record.php', {
                                document_exports_id: exportsId,
                                amount: payAmount,
                                payment_date: $('#payDate').val(),
                                payment_method: $('#payMethod').val(),
                                reference: $('#payReference').val(),
                                notes: $('#payNotes').val()
                            }, function(data) {
                                if (data.response) {
                                    var r = data.response;
                                    var msg = r.payment_status === 'paid'
                                        ? 'Rechnung vollstaendig bezahlt!'
                                        : 'Teilzahlung erfasst. Bezahlt: ' + formatMoney(r.total_paid) + ' / Offen: ' + formatMoney(r.remaining);
                                    if (r.payment_status === 'partial') {
                                        msg += '<br><small class="text-info"><i class="fas fa-pause-circle"></i> Mahnverfahren wurde automatisch pausiert.</small>';
                                    }
                                    bootbox.alert(msg);
                                }
                                loadDocuments();
                            });
                        } else {
                            // Fallback: altes System
                            ajaxcall('documentLifecycle/markPaid.php', {
                                doc_id: docId,
                                amount: payAmount,
                                reference: $('#payReference').val(),
                                partial: (payAmount < parseFloat(remaining)) ? '1' : '0'
                            }, function(data) {
                                if (data.response) {
                                    var msg = data.response.fully_paid
                                        ? 'Rechnung vollstaendig bezahlt!'
                                        : 'Teilzahlung erfasst. Offen: ' + formatMoney(data.response.remaining);
                                    bootbox.alert(msg);
                                }
                                loadDocuments();
                            });
                        }
                    }
                }
            }
        });
    });

    // ═══ Zahlungsverlauf anzeigen ═══
    $(document).on('click', '.docPaymentHistoryBtn', function() {
        var exportsId = $(this).data('exports-id');
        var docNumber = $(this).data('number');
        var gross = parseFloat($(this).data('gross') || 0);

        ajaxcall('payments/list.php', {document_exports_id: exportsId}, function(data) {
            if (!data.response) return;

            var payments = data.response.payments || [];
            var remaining = parseFloat(data.response.remaining || 0);
            var totalPaid = 0;
            payments.forEach(function(p) { totalPaid += parseFloat(p.amount || 0); });

            var html = '<div class="mb-3">' +
                '<strong>Rechnung:</strong> ' + docNumber + '<br>' +
                '<strong>Bruttobetrag:</strong> ' + formatMoney(gross) + '<br>' +
                '<strong>Bezahlt:</strong> <span class="text-success">' + formatMoney(totalPaid) + '</span><br>' +
                '<strong>Offen:</strong> <span class="' + (remaining > 0 ? 'text-danger' : 'text-success') + '">' + formatMoney(remaining) + '</span>' +
                '</div>';

            // Fortschrittsbalken
            var pct = gross > 0 ? Math.min(100, Math.round(totalPaid / gross * 100)) : 0;
            html += '<div class="progress mb-3" style="height: 20px;">' +
                '<div class="progress-bar bg-success" role="progressbar" style="width: ' + pct + '%" aria-valuenow="' + pct + '" aria-valuemin="0" aria-valuemax="100">' + pct + '%</div>' +
                '</div>';

            if (payments.length > 0) {
                html += '<table class="table table-sm table-striped">';
                html += '<thead><tr><th>Datum</th><th>Betrag</th><th>Zahlungsart</th><th>Referenz</th><th>Aktionen</th></tr></thead>';
                html += '<tbody>';
                payments.forEach(function(p) {
                    html += '<tr>';
                    html += '<td>' + (p.payment_date || '-') + '</td>';
                    html += '<td>' + formatMoney(p.amount) + '</td>';
                    html += '<td>' + (p.payment_method_label || p.payment_method || '-') + '</td>';
                    html += '<td>' + (p.reference || '-') + '</td>';
                    html += '<td><button class="btn btn-sm btn-outline-danger deletePaymentBtn" data-payment-id="' + p.id + '" data-exports-id="' + exportsId + '" title="Zahlung loeschen"><i class="fas fa-trash"></i></button></td>';
                    html += '</tr>';
                });
                html += '</tbody></table>';
            } else {
                html += '<p class="text-muted text-center">Keine Zahlungen erfasst.</p>';
            }

            bootbox.dialog({
                title: '<i class="fas fa-list-ol"></i> Zahlungsverlauf - ' + docNumber,
                message: html,
                size: 'large',
                buttons: {
                    ok: { label: 'Schliessen', className: 'btn-default' }
                }
            });
        }, false);
    });

    // Zahlung loeschen (aus dem Zahlungsverlauf-Dialog)
    $(document).on('click', '.deletePaymentBtn', function() {
        var paymentId = $(this).data('payment-id');
        var btn = $(this);
        bootbox.confirm('Diese Zahlung wirklich loeschen?', function(ok) {
            if (!ok) return;
            ajaxcall('payments/delete.php', {payment_id: paymentId}, function() {
                btn.closest('tr').fadeOut(300, function() { $(this).remove(); });
                loadDocuments();
            });
        });
    });
});
</script>
