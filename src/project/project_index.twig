    {# ══════ NEUES PDF-MODAL (Serverseitig mit Dompdf) ══════ #}
    <div class="modal fade" id="pdfGenerateModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title"></h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="pdfDocType" value="">

                    {# Rabatt #}
                    {% if "PROJECTS:PROJECT_PAYMENTS:VIEW"|instancePermissions and project.projectsTypes_config_finance == 1 %}
                    <div class="form-group">
                        <label>Rabatt (%)</label>
                        <input type="number" class="form-control" id="pdfDiscountPct" value="0" min="0" max="100" step="0.5">
                    </div>
                    {% endif %}

                    {# Miettage #}
                    <div class="form-group">
                        <label>Miettage <small class="text-muted">(0 = automatisch aus Projektdaten)</small></label>
                        <input type="number" class="form-control" id="pdfDurationDays" value="0" min="0">
                    </div>

                    {# Skonto (nur bei Rechnungen sichtbar) #}
                    <div id="pdfSkontoSection" style="display:none;">
                        <hr>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="pdfSkontoEnabled">
                            <label class="form-check-label">
                                <i class="fas fa-percentage"></i> <strong>Skonto gewaehren</strong>
                            </label>
                        </div>
                        <div id="pdfSkontoFields" style="display:none; margin-left: 20px;">
                            <div class="row">
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Skonto-Satz (%)</label>
                                        <input type="number" step="0.01" min="0" max="100" class="form-control" id="pdfSkontoRate"
                                               value="{{ USERDATA.instance.instances_skontoRate ?? '0' }}">
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Skontofrist (Tage)</label>
                                        <input type="number" min="1" class="form-control" id="pdfSkontoDays"
                                               value="{{ USERDATA.instance.instances_skontoDays ?? '0' }}">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    {# E-Mail-Versand #}
                    {% if project.clients_email %}
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="pdfSendEmail">
                        <label class="form-check-label">
                            <i class="fas fa-envelope"></i> Automatisch per E-Mail an <strong>{{ project.clients_email }}</strong> senden
                        </label>
                    </div>
                    {% else %}
                    <div class="alert alert-warning alert-sm py-2">
                        <i class="fas fa-info-circle"></i> Kein E-Mail-Versand moeglich: Kunde hat keine E-Mail-Adresse hinterlegt.
                    </div>
                    {% endif %}

                    {# Status-Bereich (wird nach Generierung angezeigt) #}
                    <div id="pdfGenerateStatus" style="display:none;">
                        <div class="alert" id="pdfGenerateAlert"></div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <a href="{{CONFIG.ROOTURL}}/project/projectInvoice.php?id={{ project.projects_id }}&type=invoice&draft=true&addresses=on&finance=on&prices=on&assets=on&paymentTerms=on" target="_blank" class="btn btn-default" id="pdfDraftBtn">
                        <i class="fas fa-eye"></i> Entwurf (alt)
                    </a>
                    <button type="button" class="btn btn-success" id="pdfGenerateBtn">
                        <i class="fas fa-file-pdf"></i> PDF erstellen
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script>
        $(document).ready(function () {
            // ── PDF-Generierung (neues System: serverseitig mit Dompdf) ──
            $('#pdfGenerateModal').on('show.bs.modal', function (e) {
                // Reset
                $('#pdfGenerateStatus').hide();
                $('#pdfGenerateBtn').prop('disabled', false).html('<i class="fas fa-file-pdf"></i> PDF erstellen');
                $('#pdfSkontoEnabled').prop('checked', false);
                $('#pdfSkontoFields').hide();

                if ($(e.relatedTarget).data('delivery-note')) {
                    $("#pdfGenerateModal .modal-title").text("Lieferschein erstellen");
                    $('#pdfDocType').val("deliveryNote");
                    $('#pdfSkontoSection').hide();
                    $('#pdfDraftBtn').attr('href', '{{CONFIG.ROOTURL}}/project/projectInvoice.php?id={{ project.projects_id }}&type=deliveryNote&draft=true&addresses=on&assets=on');
                } else if ($(e.relatedTarget).data('quote')) {
                    $("#pdfGenerateModal .modal-title").text("Angebot erstellen");
                    $('#pdfDocType').val("quote");
                    $('#pdfSkontoSection').hide();
                    $('#pdfDraftBtn').attr('href', '{{CONFIG.ROOTURL}}/project/projectInvoice.php?id={{ project.projects_id }}&type=quote&draft=true&addresses=on&finance=on&prices=on&assets=on&paymentTerms=on');
                } else {
                    $("#pdfGenerateModal .modal-title").text("Rechnung erstellen");
                    $('#pdfDocType').val("invoice");
                    $('#pdfSkontoSection').show();
                    $('#pdfDraftBtn').attr('href', '{{CONFIG.ROOTURL}}/project/projectInvoice.php?id={{ project.projects_id }}&type=invoice&draft=true&addresses=on&finance=on&prices=on&assets=on&paymentTerms=on');
                }
            });

            // Skonto-Felder ein-/ausblenden
            $('#pdfSkontoEnabled').change(function() {
                $('#pdfSkontoFields').toggle(this.checked);
            });

            // Freigabelink erstellen
            $('.btnCreateApprovalLink').on('click', function(e) {
                e.preventDefault();
                var s3id = $(this).data('s3id');
                bootbox.dialog({
                    title: '<i class="fas fa-share-alt"></i> Freigabelink erstellen',
                    message: '<form id="approvalLinkForm">' +
                        '<div class="form-group">' +
                        '<label>Gueltigkeit (Tage)</label>' +
                        '<input type="number" class="form-control" id="approvalValidityDays" value="30" min="1" max="365">' +
                        '</div>' +
                        '<div class="form-group">' +
                        '<div class="custom-control custom-checkbox">' +
                        '<input type="checkbox" class="custom-control-input" id="approvalSendEmail">' +
                        '<label class="custom-control-label" for="approvalSendEmail">E-Mail an Kunden senden</label>' +
                        '</div>' +
                        '</div>' +
                        '</form>',
                    buttons: {
                        cancel: { label: 'Abbrechen', className: 'btn-default' },
                        confirm: {
                            label: '<i class="fas fa-link"></i> Link erstellen',
                            className: 'btn-success',
                            callback: function() {
                                ajaxcall("projects/createApprovalLink.php", {
                                    id: "{{ project.projects_id }}",
                                    doc_id: 0,
                                    s3files_id: s3id,
                                    validity_days: $('#approvalValidityDays').val(),
                                    send_email: $('#approvalSendEmail').is(':checked') ? '1' : '0'
                                }, function(data) {
                                    if (data.result && data.response) {
                                        bootbox.dialog({
                                            title: '<i class="fas fa-check-circle text-success"></i> Freigabelink erstellt',
                                            message: '<p>Der Link wurde erfolgreich erstellt:</p>' +
                                                '<div class="input-group mb-3">' +
                                                '<input type="text" class="form-control" id="approvalLinkUrl" value="' + data.response.url + '" readonly>' +
                                                '<div class="input-group-append">' +
                                                '<button class="btn btn-outline-primary" type="button" id="copyApprovalLink"><i class="fas fa-copy"></i></button>' +
                                                '</div></div>' +
                                                '<small class="text-muted">Gueltig bis: ' + data.response.expires_at + '</small>',
                                            buttons: {
                                                ok: { label: 'Schliessen', className: 'btn-primary' }
                                            }
                                        });
                                        setTimeout(function() {
                                            $('#copyApprovalLink').on('click', function() {
                                                $('#approvalLinkUrl').select();
                                                document.execCommand('copy');
                                                $(this).html('<i class="fas fa-check"></i>');
                                            });
                                        }, 300);
                                    }
                                }, true);
                                return true;
                            }
                        }
                    }
                });
            });

            // Freigabelinks laden
            function loadApprovalLinks() {
                ajaxcall('projects/listApprovalLinks.php', {id: '{{ project.projects_id }}'}, function(data) {
                    if (!data.response || !data.response.links) return;
                    var links = data.response.links;
                    $('#approvalLinksCount').text(links.length);
                    if (links.length === 0) {
                        $('#approvalLinksBody').html('<tr><td colspan="7" class="text-center text-muted">Keine Freigabelinks vorhanden.</td></tr>');
                        return;
                    }
                    var statusBadges = {pending: 'warning', accepted: 'success', rejected: 'danger', expired: 'secondary'};
                    var statusLabels = {pending: 'Offen', accepted: 'Angenommen', rejected: 'Abgelehnt', expired: 'Abgelaufen'};
                    var html = '';
                    links.forEach(function(l) {
                        html += '<tr>';
                        html += '<td>' + (l.doc_number || '-') + '</td>';
                        html += '<td>' + (l.client_name || '-') + '</td>';
                        html += '<td><span class="badge badge-' + (statusBadges[l.status] || 'secondary') + '">' + (statusLabels[l.status] || l.status) + '</span></td>';
                        html += '<td>' + (l.created_at ? l.created_at.substring(0,10) : '-') + '</td>';
                        html += '<td>' + (l.expires_at ? l.expires_at.substring(0,10) : '-') + '</td>';
                        html += '<td>';
                        if (l.client_signature_name) html += '<em>' + l.client_signature_name + '</em>';
                        if (l.client_comment) html += '<br><small class="text-muted">' + l.client_comment + '</small>';
                        html += '</td>';
                        html += '<td>';
                        var linkUrl = '{{ CONFIG.ROOTURL }}/public/quote.php?token=' + l.token;
                        html += '<button class="btn btn-xs btn-default copyLinkBtn" data-url="' + linkUrl + '" title="Link kopieren"><i class="fas fa-copy"></i></button>';
                        html += '</td>';
                        html += '</tr>';
                    });
                    $('#approvalLinksBody').html(html);
                }, false);
            }
            loadApprovalLinks();

            $(document).on('click', '.copyLinkBtn', function() {
                var url = $(this).data('url');
                var $temp = $('<input>');
                $('body').append($temp);
                $temp.val(url).select();
                document.execCommand('copy');
                $temp.remove();
                $(this).html('<i class="fas fa-check"></i>');
                var btn = $(this);
                setTimeout(function() { btn.html('<i class="fas fa-copy"></i>'); }, 2000);
            });

            // PDF generieren via Server-Side API
            $('#pdfGenerateBtn').on('click', function() {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Wird erstellt...');
                $('#pdfGenerateStatus').hide();

                var postData = {
                    "id": "{{ project.projects_id }}",
                    "type": $('#pdfDocType').val(),
                    "discount_pct": $('#pdfDiscountPct').val() || 0,
                    "duration_days": $('#pdfDurationDays').val() || 0,
                    "send_email": $('#pdfSendEmail').is(':checked') ? '1' : '0'
                };
                if ($('#pdfSkontoEnabled').is(':checked')) {
                    postData.skonto_enabled = '1';
                    postData.skonto_rate = $('#pdfSkontoRate').val();
                    postData.skonto_days = $('#pdfSkontoDays').val();
                }

                ajaxcall("projects/generateDocument.php", postData, function(data) {
                    btn.prop('disabled', false).html('<i class="fas fa-file-pdf"></i> PDF erstellen');

                    if (data.result && data.response) {
                        var msg = '<i class="fas fa-check-circle"></i> <strong>' + data.response.doc_number + '</strong> erfolgreich erstellt!';
                        if (data.response.email && data.response.email.success) {
                            msg += '<br><i class="fas fa-envelope"></i> ' + data.response.email.message;
                        } else if (data.response.email && !data.response.email.success) {
                            msg += '<br><i class="fas fa-exclamation-triangle text-warning"></i> ' + data.response.email.message;
                        }
                        if (data.response.s3files_id) {
                            msg += '<br><a href="{{CONFIG.ROOTURL}}/api/file/?r=true&f=' + data.response.s3files_id + '" target="_blank" class="btn btn-sm btn-primary mt-2"><i class="fas fa-download"></i> PDF herunterladen</a>';
                        }
                        $('#pdfGenerateAlert').removeClass('alert-danger').addClass('alert-success').html(msg);
                        $('#pdfGenerateStatus').show();

                        // Nach 2 Sekunden Seite neu laden um neue Datei in der Liste anzuzeigen
                        setTimeout(function() { location.reload(); }, 3000);
                    } else {
                        var errMsg = (data.error && data.error.message) ? data.error.message : 'Unbekannter Fehler';
                        $('#pdfGenerateAlert').removeClass('alert-success').addClass('alert-danger').html('<i class="fas fa-exclamation-triangle"></i> ' + errMsg);
                        $('#pdfGenerateStatus').show();
                    }
                }, true);
            });
