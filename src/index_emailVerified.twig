{% extends "assets/template.twig" %}

{% block content %}
<div class="row">
  <div class="col-lg-6 offset-lg-3 col-md-12" style="padding: 5px;">
      <div class="card card-default">
          <div class="card-body" style="text-align: center;">
                <h3>E-Mail bestaetigen</h3>
                <p>Bitte pruefen Sie Ihr Postfach ({{USERDATA.users_email}}) auf unsere Bestaetigungs-E-Mail. Manchmal landen unsere E-Mails im Spam-Ordner - falls Sie keine E-Mail von {{ fromEmail }} finden, pruefen Sie bitte Ihren Spam-/Junk-Ordner oder klicken Sie auf die Schaltflaeche unten, um sie erneut zu senden.</p>
                <button id="submitButton" class="btn btn-default">Bestaetigungs-E-Mail erneut senden</button>
                {% if "CONFIG:SET"|serverPermissions %}
                    <a href="{{CONFIG.ROOTURL}}/server/config.php" class="btn btn-default">Server-Konfiguration bearbeiten</a>
                {% endif %}
          </div>
          <div class="card-footer">
            <a href="{{ CONFIG.LINKS_SUPPORTURL }}">Support kontaktieren</a>
          </div>
          <script>
              $(document).ready(function () {
                  $('#submitButton').click(function () {
                    ajaxcall("account/reSendVerificationEmail.php", {}, function (data) {
                        location.reload();
                    });
                  });
              });
          </script>
      </div>
  </div>
</div>
{% endblock %}
