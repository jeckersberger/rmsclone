{% extends "assets/template.twig" %}
{% block content %}
<div class="row">
    {# ── Scanner Panel ── #}
    <div class="col-lg-5">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-barcode"></i> {{ t('inventory_scanner') }}</h3>
            </div>
            <div class="card-body">
                <div id="noSessionPanel">
                    <p class="text-muted">{{ t('inventory_start_desc') }}</p>
                    <div class="form-group">
                        <input type="text" class="form-control" id="sessionTitle" placeholder="{{ t('session_title_placeholder') }}">
                    </div>
                    <button class="btn btn-primary btn-block" id="startSessionBtn"><i class="fas fa-play"></i> {{ t('start_inventory') }}</button>
                </div>
                <div id="activeSessionPanel" style="display:none;">
                    <div class="input-group input-group-lg mb-3">
                        <input type="text" class="form-control" id="scanInput" placeholder="{{ t('scan_barcode') }}" autofocus>
                        <div class="input-group-append">
                            <button class="btn btn-primary" id="scanBtn"><i class="fas fa-barcode"></i></button>
                        </div>
                    </div>
                    <div id="scanFeedback" class="mb-3" style="display:none;"></div>

                    {# Progress #}
                    <div class="progress mb-2" style="height:25px;">
                        <div class="progress-bar bg-success" id="progressBar" role="progressbar" style="width:0%;">0%</div>
                    </div>
                    <div class="d-flex justify-content-between text-sm text-muted mb-3">
                        <span><i class="fas fa-check text-success"></i> {{ t('scanned') }}: <strong id="scannedCount">0</strong></span>
                        <span><i class="fas fa-question text-warning"></i> {{ t('missing') }}: <strong id="missingCount">0</strong></span>
                        <span><i class="fas fa-boxes"></i> {{ t('total') }}: <strong id="totalCount">0</strong></span>
                    </div>

                    <button class="btn btn-success btn-block" id="completeSessionBtn"><i class="fas fa-check-double"></i> {{ t('complete_inventory') }}</button>
                </div>
            </div>
        </div>

        {# ── Recent Scans ── #}
        <div class="card" id="recentScansCard" style="display:none;">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-list"></i> {{ t('recent_scans') }}</h3>
            </div>
            <div class="card-body p-0" style="max-height:300px; overflow-y:auto;">
                <table class="table table-sm">
                    <tbody id="recentScansBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Sessions History ── #}
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-history"></i> {{ t('inventory_sessions') }}</h3>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="sessionsLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>{{ t('title') }}</th>
                            <th>{{ t('status') }}</th>
                            <th>{{ t('scanned') }}</th>
                            <th>{{ t('missing') }}</th>
                            <th>{{ t('date') }}</th>
                        </tr>
                    </thead>
                    <tbody id="sessionsBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    var currentSessionId = null;

    function loadSessions() {
        ajaxcall('inventory/sessions.php', {}, function(data) {
            if (!data.response) return;
            var html = '';
            var sessions = data.response.sessions || [];
            if (sessions.length > 0) {
                sessions.forEach(function(s) {
                    var badge = s.status === 'completed' ? 'success' : (s.status === 'in_progress' ? 'warning' : 'secondary');
                    html += '<tr>';
                    html += '<td>' + (s.title || '-') + '</td>';
                    html += '<td><span class="badge badge-' + badge + '">' + s.status + '</span></td>';
                    html += '<td>' + (s.total_scanned || 0) + '</td>';
                    html += '<td>' + (s.total_missing || '-') + '</td>';
                    html += '<td>' + new Date(s.created_at).toLocaleDateString('de-DE') + '</td>';
                    html += '</tr>';
                });
            } else {
                html = '<tr><td colspan="5" class="text-center text-muted">{{ t("no_sessions") }}</td></tr>';
            }
            $('#sessionsBody').html(html);
            $('#sessionsLoading').hide();
        }, false);
    }
    loadSessions();

    function updateProgress() {
        if (!currentSessionId) return;
        ajaxcall('inventory/progress.php', {session_id: currentSessionId}, function(data) {
            if (!data.response) return;
            var r = data.response;
            $('#scannedCount').text(r.scanned);
            $('#missingCount').text(r.missing);
            $('#totalCount').text(r.total_assets);
            $('#progressBar').css('width', r.progress_pct + '%').text(r.progress_pct + '%');

            // Recent scans
            var html = '';
            (r.items || []).slice(0, 20).forEach(function(item) {
                html += '<tr><td><i class="fas fa-check text-success"></i> ' + (item.assetTypes_name || '') + ' <small class="text-muted">#' + (item.assets_tag || '') + '</small></td></tr>';
            });
            if (html) {
                $('#recentScansBody').html(html);
                $('#recentScansCard').show();
            }
        }, false);
    }

    $('#startSessionBtn').click(function() {
        ajaxcall('inventory/startSession.php', {title: $('#sessionTitle').val()}, function(data) {
            if (data.response && data.response.session_id) {
                currentSessionId = data.response.session_id;
                $('#noSessionPanel').hide();
                $('#activeSessionPanel').show();
                $('#scanInput').focus();
                updateProgress();
            }
        });
    });

    function doScan() {
        var tag = $('#scanInput').val().trim();
        if (!tag || !currentSessionId) return;

        ajaxcall('inventory/scan.php', {session_id: currentSessionId, tag: tag}, function(data) {
            var r = data.response || {};
            var fb = $('#scanFeedback');
            if (r.success) {
                if (r.duplicate) {
                    fb.html('<div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> {{ t("already_scanned") }}: ' + (r.asset.assetTypes_name || '') + '</div>').show();
                } else {
                    fb.html('<div class="alert alert-success"><i class="fas fa-check"></i> ' + (r.asset.assetTypes_name || '') + ' #' + (r.asset.assets_tag || '') + '</div>').show();
                }
            } else {
                fb.html('<div class="alert alert-danger"><i class="fas fa-times"></i> {{ t("asset_not_found") }}: ' + tag + '</div>').show();
            }
            $('#scanInput').val('').focus();
            updateProgress();
        });
    }

    $('#scanBtn').click(doScan);
    $('#scanInput').on('keypress', function(e) { if (e.which === 13) { e.preventDefault(); doScan(); } });

    $('#completeSessionBtn').click(function() {
        bootbox.confirm('{{ t("complete_inventory_confirm") }}', function(r) {
            if (!r) return;
            ajaxcall('inventory/complete.php', {session_id: currentSessionId}, function(data) {
                if (data.response) {
                    var missing = data.response.missing || [];
                    if (missing.length > 0) {
                        var msg = '<h5>{{ t("missing_assets") }} (' + missing.length + '):</h5><ul>';
                        missing.forEach(function(m) {
                            msg += '<li>' + (m.assetTypes_name || '') + ' #' + (m.assets_tag || '') + '</li>';
                        });
                        msg += '</ul>';
                        bootbox.alert(msg);
                    } else {
                        bootbox.alert('<i class="fas fa-check text-success"></i> {{ t("inventory_complete_all_found") }}');
                    }
                    currentSessionId = null;
                    $('#activeSessionPanel').hide();
                    $('#noSessionPanel').show();
                    $('#recentScansCard').hide();
                    loadSessions();
                }
            });
        });
    });
});
</script>
{% endblock %}
