{% extends "assets/template.twig" %}
{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-puzzle-piece"></i> Textbausteine</h3>
                <div class="card-tools">
                    {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
                    <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#addBlockModal"><i class="fas fa-plus"></i> Neuer Baustein</button>
                    {% endif %}
                </div>
            </div>
            <div class="card-body">
                <p class="text-muted">Wiederverwendbare Textbausteine fuer Angebote, Rechnungen und andere Dokumente. Bausteine mit <span class="badge badge-primary">Standard</span> werden automatisch in neue Dokumente eingefuegt.</p>
            </div>
        </div>
    </div>
</div>

{% for cat_key, cat_name in categories %}
    {% set blocks_in_cat = [] %}
    {% for block in textblocks %}
        {% if block.category == cat_key %}
            {% set blocks_in_cat = blocks_in_cat|merge([block]) %}
        {% endif %}
    {% endfor %}

    {% if blocks_in_cat|length > 0 %}
    <div class="row">
        <div class="col-12">
            <div class="card card-outline card-primary">
                <div class="card-header">
                    <h3 class="card-title">{{ cat_name }}</h3>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:25%">Titel</th>
                                <th>Inhalt (Vorschau)</th>
                                <th style="width:12%">Dokumenttypen</th>
                                <th style="width:8%">Standard</th>
                                <th style="width:10%">Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for block in blocks_in_cat %}
                            <tr>
                                <td><strong>{{ block.title }}</strong></td>
                                <td><small class="text-muted">{{ block.content|length > 120 ? block.content[:120] ~ '...' : block.content }}</small></td>
                                <td>
                                    {% for dt in block.doc_types|split(',') %}
                                        <span class="badge badge-info">{{ dt|trim }}</span>
                                    {% endfor %}
                                </td>
                                <td>
                                    {% if block.is_default %}<span class="badge badge-primary">Standard</span>{% endif %}
                                </td>
                                <td>
                                    {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
                                    <button class="btn btn-xs btn-default" onclick="editBlock({{ block.id }}, '{{ block.title|e('js') }}', '{{ block.content|e('js') }}', '{{ block.category }}', '{{ block.doc_types }}', {{ block.sort_order }}, {{ block.is_default }})"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-xs btn-danger" onclick="deleteBlock({{ block.id }}, '{{ block.title|e('js') }}')"><i class="fas fa-trash"></i></button>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
{% endfor %}

{# ══════ MODAL: TEXTBAUSTEIN ERSTELLEN/BEARBEITEN ══════ #}
<div class="modal fade" id="addBlockModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="blockForm">
                <input type="hidden" name="id" id="blockId" value="">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Neuer Textbaustein</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Titel</label>
                        <input type="text" class="form-control" name="title" id="blockTitle" required placeholder="z.B. Standard-Anrede">
                    </div>
                    <div class="form-group">
                        <label>Kategorie</label>
                        <select class="form-control" name="category" id="blockCategory">
                            {% for k, v in categories %}
                            <option value="{{ k }}">{{ v }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Inhalt</label>
                        <textarea class="form-control" name="content" id="blockContent" rows="6" required placeholder="Text mit optionalen Platzhaltern: {client_name}, {project_name}, {date}"></textarea>
                        <small class="text-muted">Platzhalter: {client_name}, {project_name}, {date}, {doc_number}</small>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Dokumenttypen</label>
                                <input type="text" class="form-control" name="doc_types" id="blockDocTypes" value="quote,invoice" placeholder="quote,invoice,delivery_note">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Reihenfolge</label>
                                <input type="number" class="form-control" name="sort_order" id="blockSort" value="0" min="0">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Standard</label><br>
                                <input type="checkbox" name="is_default" id="blockDefault" value="1"> In neue Dokumente einfuegen
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-primary">Speichern</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    $('#addBlockModal').on('hidden.bs.modal', function() {
        $('#blockForm')[0].reset();
        $('#blockId').val('');
        $('#modalTitle').text('Neuer Textbaustein');
    });
    $('#blockForm').on('submit', function(e) {
        e.preventDefault();
        var data = $(this).serializeArray();
        // Checkbox fix
        if (!$('#blockDefault').is(':checked')) data.push({name: 'is_default', value: '0'});
        ajaxcall('textblocks/save.php', data, function() { location.reload(); });
    });
});

function editBlock(id, title, content, category, docTypes, sortOrder, isDefault) {
    $('#blockId').val(id);
    $('#blockTitle').val(title);
    $('#blockContent').val(content);
    $('#blockCategory').val(category);
    $('#blockDocTypes').val(docTypes);
    $('#blockSort').val(sortOrder);
    $('#blockDefault').prop('checked', isDefault == 1);
    $('#modalTitle').text('Textbaustein bearbeiten');
    $('#addBlockModal').modal('show');
}

function deleteBlock(id, title) {
    bootbox.confirm('Textbaustein "' + title + '" wirklich loeschen?', function(result) {
        if (result) ajaxcall('textblocks/delete.php', {id: id}, function() { location.reload(); });
    });
}
</script>
{% endblock %}
