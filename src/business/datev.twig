{% extends "assets/template.twig" %}
{% block content %}
<div class="row">
    <div class="col-lg-8 offset-lg-2">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-file-csv"></i> {{ t('steuer_export') }}</h3>
            </div>
            <div class="card-body">
                <p>{{ t('steuer_export_desc') }}</p>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>{{ t('date_from') }}</label>
                            <input type="date" class="form-control" id="exportFrom" value="{{ "now"|date("Y") }}-01-01">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>{{ t('date_to') }}</label>
                            <input type="date" class="form-control" id="exportTo" value="{{ "now"|date("Y-m-d") }}">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Export-Buttons #}
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-arrow-down fa-3x text-success mb-3"></i>
                        <h4>{{ t('export_einnahmen') }}</h4>
                        <p class="text-muted">{{ t('export_einnahmen_desc') }}</p>
                        <button class="btn btn-success btn-block exportBtn" data-type="einnahmen">
                            <i class="fas fa-download"></i> {{ t('download') }} CSV
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-arrow-up fa-3x text-danger mb-3"></i>
                        <h4>{{ t('export_ausgaben') }}</h4>
                        <p class="text-muted">{{ t('export_ausgaben_desc') }}</p>
                        <button class="btn btn-danger btn-block exportBtn" data-type="ausgaben">
                            <i class="fas fa-download"></i> {{ t('download') }} CSV
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-calculator fa-3x text-info mb-3"></i>
                        <h4>{{ t('export_euer_summary') }}</h4>
                        <p class="text-muted">{{ t('export_euer_summary_desc') }}</p>
                        <div class="form-group">
                            <select class="form-control" id="euerYear" style="width:auto;margin:0 auto;">
                                {% for y in range("now"|date("Y") - 2, "now"|date("Y")) %}
                                    <option value="{{ y }}" {{ y == "now"|date("Y") ? 'selected' : '' }}>{{ y }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button class="btn btn-info btn-block" id="exportEuerBtn">
                            <i class="fas fa-download"></i> {{ t('download') }} CSV
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="fas fa-users fa-3x text-primary mb-3"></i>
                        <h4>{{ t('export_kunden') }}</h4>
                        <p class="text-muted">{{ t('export_kunden_desc') }}</p>
                        <button class="btn btn-primary btn-block exportBtn" data-type="kunden">
                            <i class="fas fa-download"></i> {{ t('download') }} CSV
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {# WISO Hinweis #}
        <div class="card">
            <div class="card-header bg-light">
                <h3 class="card-title"><i class="fas fa-info-circle"></i> {{ t('wiso_hint_title') }}</h3>
            </div>
            <div class="card-body">
                <p>{{ t('wiso_hint_text') }}</p>
                <ol>
                    <li>{{ t('wiso_step1') }}</li>
                    <li>{{ t('wiso_step2') }}</li>
                    <li>{{ t('wiso_step3') }}</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    var baseUrl = '{{ CONFIG.ROOTURL }}/api/datev/export.php';

    $('.exportBtn').click(function() {
        var type = $(this).data('type');
        var from = $('#exportFrom').val();
        var to = $('#exportTo').val();
        window.location.href = baseUrl + '?type=' + type + '&from=' + from + '&to=' + to;
    });

    $('#exportEuerBtn').click(function() {
        var year = $('#euerYear').val();
        window.location.href = baseUrl + '?type=euer&year=' + year;
    });
});
</script>
{% endblock %}
