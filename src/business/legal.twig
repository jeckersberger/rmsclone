{% extends "assets/template.twig" %}
{% block content %}
<div class="row">
    <div class="col-lg-8 offset-lg-2">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-{{ legal_page == 'privacy' ? 'shield-alt' : 'gavel' }}"></i> {{ legal_title }}</h3>
            </div>
            <div class="card-body">
                {% if legal_content %}
                    {{ legal_content|raw }}
                {% else %}
                    <div class="text-center text-muted p-4">
                        <i class="fas fa-info-circle fa-3x mb-3"></i>
                        <p>{% if legal_page == 'privacy' %}Keine Datenschutzerklaerung hinterlegt.{% else %}Kein Impressum hinterlegt.{% endif %}</p>
                        <p><small>Diese Seite kann in den Einstellungen unter "Geschaeftsdaten" konfiguriert werden.</small></p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
