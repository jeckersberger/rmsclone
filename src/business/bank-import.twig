{% extends "assets/template.twig" %}
{% block content %}

{# ══════════════════════════════════════════════════════════ #}
{#  TAB-NAVIGATION                                           #}
{# ══════════════════════════════════════════════════════════ #}
<div class="row">
    <div class="col-12">
        <div class="card card-primary card-outline card-tabs">
            <div class="card-header p-0 pt-1">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-toggle="tab" href="#tabImport">
                            <i class="fas fa-file-upload"></i> Import
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="tab" href="#tabFints">
                            <i class="fas fa-university"></i> FinTS/HBCI
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="tab" href="#tabAccounts">
                            <i class="fas fa-piggy-bank"></i> Bankkonten
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="tab" href="#tabHistory">
                            <i class="fas fa-history"></i> Verlauf
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════════════ #}
{#  TAB 1: DATEI-IMPORT                                      #}
{# ══════════════════════════════════════════════════════════ #}
<div class="tab-content">
<div class="tab-pane fade show active" id="tabImport">

{# Upload-Bereich #}
<div class="row">
    <div class="col-lg-6">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-file-upload"></i> Kontoauszug hochladen</h3>
            </div>
            <div class="card-body">
                <form id="uploadForm" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>Format</label>
                        <select class="form-control" name="format" id="importFormat">
                            <option value="mt940">MT940 (SWIFT)</option>
                            <option value="camt053">CAMT.053 (ISO 20022 XML)</option>
                            <option value="csv">CSV (mit Spalten-Mapping)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Bankkonto (optional)</label>
                        <select class="form-control" name="account_id" id="importAccount">
                            <option value="">-- Kein Konto zuordnen --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Datei</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" name="file" id="importFile" accept=".sta,.mt940,.txt,.xml,.csv">
                            <label class="custom-file-label" for="importFile">Datei auswaehlen...</label>
                        </div>
                    </div>

                    {# CSV-Mapping (nur bei CSV sichtbar) #}
                    <div id="csvMappingSection" style="display:none;">
                        <hr>
                        <h5>CSV-Spalten-Mapping</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group form-group-sm">
                                    <label>Datum (Spalte)</label>
                                    <input type="number" class="form-control form-control-sm" id="csvDate" value="0" min="0">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group form-group-sm">
                                    <label>Betrag (Spalte)</label>
                                    <input type="number" class="form-control form-control-sm" id="csvAmount" value="3" min="0">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group form-group-sm">
                                    <label>Verwendungszweck (Spalte)</label>
                                    <input type="number" class="form-control form-control-sm" id="csvReference" value="5" min="0">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group form-group-sm">
                                    <label>Name Gegenkonto (Spalte)</label>
                                    <input type="number" class="form-control form-control-sm" id="csvName" value="2" min="0">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group form-group-sm">
                                    <label>Trennzeichen</label>
                                    <select class="form-control form-control-sm" id="csvDelimiter">
                                        <option value=";">Semikolon (;)</option>
                                        <option value=",">Komma (,)</option>
                                        <option value="&#9;">Tab</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group form-group-sm">
                                    <label>Datumsformat</label>
                                    <select class="form-control form-control-sm" id="csvDateFormat">
                                        <option value="d.m.Y">TT.MM.JJJJ</option>
                                        <option value="d/m/Y">TT/MM/JJJJ</option>
                                        <option value="Y-m-d">JJJJ-MM-TT</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block" id="uploadBtn">
                        <i class="fas fa-upload"></i> Importieren
                    </button>
                </form>
            </div>
        </div>
    </div>

    {# Import-Ergebnis #}
    <div class="col-lg-6">
        <div class="card" id="importResultCard" style="display:none;">
            <div class="card-header bg-success">
                <h3 class="card-title"><i class="fas fa-check-circle"></i> Import-Ergebnis</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-4 text-center">
                        <h2 id="resultNew" class="text-primary">0</h2>
                        <small>Neue Transaktionen</small>
                    </div>
                    <div class="col-4 text-center">
                        <h2 id="resultMatched" class="text-success">0</h2>
                        <small>Auto-gematcht</small>
                    </div>
                    <div class="col-4 text-center">
                        <h2 id="resultDuplicates" class="text-muted">0</h2>
                        <small>Duplikate</small>
                    </div>
                </div>
                <hr>
                <button class="btn btn-success btn-block" id="goToSessionBtn">
                    <i class="fas fa-arrow-right"></i> Zuordnungen pruefen
                </button>
            </div>
        </div>

        <div class="card card-outline card-info">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-info-circle"></i> Unterstuetzte Formate</h3>
            </div>
            <div class="card-body">
                <dl>
                    <dt><i class="fas fa-file-code text-primary"></i> MT940 (SWIFT)</dt>
                    <dd>Standard-Format aller deutschen Banken. Dateiendung: .sta, .mt940</dd>
                    <dt class="mt-2"><i class="fas fa-file-code text-success"></i> CAMT.053 (ISO 20022)</dt>
                    <dd>Modernes XML-Format. Wird von immer mehr Banken angeboten.</dd>
                    <dt class="mt-2"><i class="fas fa-file-csv text-warning"></i> CSV</dt>
                    <dd>Frei konfigurierbares Spalten-Mapping. Funktioniert mit jedem Export.</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

{# ── Transaktions-Matching-Bereich ── #}
<div class="row" id="matchingSection" style="display:none;">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-exchange-alt"></i> Transaktionen zuordnen</h3>
                <div class="card-tools">
                    <span class="badge badge-warning" id="matchUnmatched">0</span> offen
                    <span class="badge badge-info ml-2" id="matchSuggested">0</span> vorgeschlagen
                    <span class="badge badge-success ml-2" id="matchConfirmed">0</span> bestaetigt
                    <button class="btn btn-sm btn-success ml-3" id="confirmAllBtn">
                        <i class="fas fa-check-double"></i> Alle Vorschlaege bestaetigen
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="matchingLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped table-sm table-hover">
                    <thead>
                        <tr>
                            <th style="width:90px;">Datum</th>
                            <th>Gegenkonto</th>
                            <th>Verwendungszweck</th>
                            <th class="text-right" style="width:100px;">Betrag</th>
                            <th style="width:180px;">Zuordnung</th>
                            <th style="width:80px;">Konfidenz</th>
                            <th style="width:140px;">Aktion</th>
                        </tr>
                    </thead>
                    <tbody id="matchingBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>

{# ══════════════════════════════════════════════════════════ #}
{#  TAB 2: FinTS/HBCI DIREKT-ABRUF                          #}
{# ══════════════════════════════════════════════════════════ #}
<div class="tab-pane fade" id="tabFints">
<div class="row">
    <div class="col-lg-6">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-university"></i> FinTS-Kontoabruf</h3>
            </div>
            <div class="card-body">
                <form id="fintsForm">
                    <div class="form-group">
                        <label>Bankkonto</label>
                        <select class="form-control" id="fintsAccount" required>
                            <option value="">-- Konto waehlen --</option>
                        </select>
                        <small class="text-muted">Nur Konten mit konfiguriertem FinTS-Zugang</small>
                    </div>
                    <div class="form-group">
                        <label>PIN</label>
                        <input type="password" class="form-control" id="fintsPin" required placeholder="Online-Banking PIN" autocomplete="off">
                        <small class="text-muted">Wird nicht gespeichert - nur fuer diese Sitzung</small>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Von</label>
                                <input type="date" class="form-control" id="fintsDateFrom">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Bis</label>
                                <input type="date" class="form-control" id="fintsDateTo" value="{{ "now"|date("Y-m-d") }}">
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" id="fintsFetchBtn">
                        <i class="fas fa-download"></i> Umsaetze abrufen
                    </button>
                </form>
            </div>
        </div>
    </div>

    {# TAN-Dialog #}
    <div class="col-lg-6">
        <div class="card" id="tanCard" style="display:none;">
            <div class="card-header bg-warning">
                <h3 class="card-title"><i class="fas fa-shield-alt"></i> TAN-Eingabe</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-info" id="tanChallenge"></div>
                <div id="tanImageContainer" style="display:none;" class="text-center mb-3">
                    <img id="tanImage" class="img-fluid" style="max-width:250px;">
                </div>
                <div class="form-group">
                    <label>TAN eingeben</label>
                    <input type="text" class="form-control form-control-lg text-center" id="tanInput" placeholder="TAN" autocomplete="off" maxlength="10">
                </div>
                <button class="btn btn-warning btn-block" id="tanSubmitBtn">
                    <i class="fas fa-check"></i> TAN bestaetigen
                </button>
                <small class="text-muted">TAN-Session laeuft in <span id="tanCountdown">300</span> Sekunden ab</small>
            </div>
        </div>

        {# FinTS-Ergebnis #}
        <div class="card" id="fintsResultCard" style="display:none;">
            <div class="card-header bg-success">
                <h3 class="card-title"><i class="fas fa-check-circle"></i> Abruf erfolgreich</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-3 text-center">
                        <h2 id="fintsTotal" class="text-primary">0</h2>
                        <small>Abgerufen</small>
                    </div>
                    <div class="col-3 text-center">
                        <h2 id="fintsNew" class="text-success">0</h2>
                        <small>Neu</small>
                    </div>
                    <div class="col-3 text-center">
                        <h2 id="fintsMatched" class="text-info">0</h2>
                        <small>Gematcht</small>
                    </div>
                    <div class="col-3 text-center">
                        <h2 id="fintsDupes" class="text-muted">0</h2>
                        <small>Duplikate</small>
                    </div>
                </div>
                <hr>
                <button class="btn btn-success btn-block" id="fintsGoToSessionBtn">
                    <i class="fas fa-arrow-right"></i> Zuordnungen pruefen
                </button>
            </div>
        </div>

        {# FinTS-Status/Info #}
        <div class="card card-outline card-info" id="fintsInfoCard">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-info-circle"></i> FinTS/HBCI</h3>
            </div>
            <div class="card-body">
                <p>Direkter Kontoabruf ueber das FinTS-Protokoll. Unterstuetzt ~3.000 deutsche Banken.</p>
                <ol>
                    <li>Bankkonto unter "Bankkonten" anlegen</li>
                    <li>FinTS-Zugangsdaten konfigurieren (BLZ, URL, Benutzer)</li>
                    <li>PIN eingeben und Umsaetze abrufen</li>
                    <li>TAN eingeben (SMS/photoTAN/pushTAN)</li>
                </ol>
                <p class="text-muted mb-0"><i class="fas fa-lock"></i> Die PIN wird nie gespeichert.</p>
            </div>
        </div>
    </div>
</div>
</div>

{# ══════════════════════════════════════════════════════════ #}
{#  TAB 3: BANKKONTEN VERWALTEN                              #}
{# ══════════════════════════════════════════════════════════ #}
<div class="tab-pane fade" id="tabAccounts">
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-piggy-bank"></i> Bankkonten</h3>
                <div class="card-tools">
                    <button class="btn btn-sm btn-primary" id="addAccountBtn">
                        <i class="fas fa-plus"></i> Neues Konto
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="accountsLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Kontoname</th>
                            <th>IBAN</th>
                            <th>Bank</th>
                            <th>FinTS</th>
                            <th>Letzte Sync</th>
                            <th style="width:120px;"></th>
                        </tr>
                    </thead>
                    <tbody id="accountsBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    {# Konto-Formular #}
    <div class="col-lg-4">
        <div class="card card-primary" id="accountFormCard">
            <div class="card-header">
                <h3 class="card-title" id="accountFormTitle">Neues Bankkonto</h3>
            </div>
            <div class="card-body">
                <form id="accountForm">
                    <input type="hidden" id="accountEditId" value="">
                    <div class="form-group">
                        <label>Kontoname *</label>
                        <input type="text" class="form-control" id="accName" required placeholder="z.B. Sparkasse Geschaeftskonto">
                    </div>
                    <div class="form-group">
                        <label>IBAN</label>
                        <input type="text" class="form-control" id="accIban" placeholder="DE89 3704 0044 0532 0130 00" maxlength="34">
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>BIC</label>
                                <input type="text" class="form-control" id="accBic" maxlength="11">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Bankname</label>
                                <input type="text" class="form-control" id="accBankName">
                            </div>
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="accDefault">
                        <label class="form-check-label" for="accDefault">Standard-Konto</label>
                    </div>

                    <hr>
                    <h5><i class="fas fa-university"></i> FinTS-Zugangsdaten</h5>
                    <div class="form-group">
                        <label>BLZ / Bank suchen</label>
                        <input type="text" class="form-control" id="accFintsSearch" placeholder="z.B. Sparkasse oder 70050000">
                        <div id="bankSearchResults" class="list-group mt-1" style="display:none; max-height:200px; overflow-y:auto;"></div>
                    </div>
                    <div class="form-group">
                        <label>FinTS-Server URL</label>
                        <input type="text" class="form-control" id="accFintsUrl" placeholder="https://banking.sparkasse.de/fints30">
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>BLZ</label>
                                <input type="text" class="form-control" id="accFintsBlz" maxlength="8">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Benutzerkennung</label>
                                <input type="text" class="form-control" id="accFintsUser" autocomplete="off">
                            </div>
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="accFintsEnabled">
                        <label class="form-check-label" for="accFintsEnabled">FinTS aktivieren</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block" id="saveAccountBtn">
                        <i class="fas fa-save"></i> Speichern
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

{# ══════════════════════════════════════════════════════════ #}
