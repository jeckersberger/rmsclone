                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="invoiceResultsBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════════════ #}
{#  JAVASCRIPT                                               #}
{# ══════════════════════════════════════════════════════════ #}
<script>
$(document).ready(function() {
    var currentSessionId = null;
    var fintsSessionId = null;
    var tanCountdownTimer = null;

    // ═══ Hilfsfunktionen ═══
    function formatMoney(v) {
        var n = parseFloat(v || 0);
        var cls = n >= 0 ? 'text-success' : 'text-danger';
        return '<span class="' + cls + '">' + n.toFixed(2).replace('.', ',') + ' &euro;</span>';
    }

    function formatDate(d) {
        if (!d) return '-';
        var parts = d.split('-');
        return parts[2] + '.' + parts[1] + '.' + parts[0];
    }

    function confidenceBadge(conf, method) {
        if (!conf) return '';
        var cls = conf >= 90 ? 'success' : (conf >= 70 ? 'info' : 'warning');
        var label = method === 'manual' ? 'Manuell' : conf + '%';
        return '<span class="badge badge-' + cls + '">' + label + '</span>';
    }

    function statusBadge(status) {
        var map = {
            'unmatched': '<span class="badge badge-warning">Offen</span>',
            'suggested': '<span class="badge badge-info">Vorschlag</span>',
            'confirmed': '<span class="badge badge-success">Bestaetigt</span>',
            'ignored':   '<span class="badge badge-secondary">Ignoriert</span>'
        };
        return map[status] || status;
    }

    // ═══ Bankkonten laden ═══
    function loadAccounts() {
        ajaxcall('bankImport/accounts.php', null, function(data) {
            var accounts = data.response.accounts || [];
            var html = '';
            var selectHtml = '<option value="">-- Kein Konto --</option>';
            var fintsHtml = '<option value="">-- Konto waehlen --</option>';

            accounts.forEach(function(a) {
                var fintsStatus = a.fints_enabled == 1
                    ? '<span class="badge badge-success">Aktiv</span>'
                    : '<span class="badge badge-secondary">Aus</span>';
                var lastSync = a.fints_last_sync ? formatDate(a.fints_last_sync.substring(0, 10)) : '-';

                html += '<tr>';
                html += '<td><strong>' + (a.account_name || '') + '</strong>';
                if (a.is_default == 1) html += ' <span class="badge badge-primary">Standard</span>';
                html += '</td>';
                html += '<td><code>' + (a.iban || '-') + '</code></td>';
                html += '<td>' + (a.bank_name || '-') + '</td>';
                html += '<td>' + fintsStatus + '</td>';
                html += '<td>' + lastSync + '</td>';
                html += '<td>';
                html += '<button class="btn btn-xs btn-outline-primary editAccountBtn" data-id="' + a.id + '"><i class="fas fa-edit"></i></button> ';
                html += '<button class="btn btn-xs btn-outline-danger deleteAccountBtn" data-id="' + a.id + '"><i class="fas fa-trash"></i></button>';
                html += '</td></tr>';

                selectHtml += '<option value="' + a.id + '">' + a.account_name + (a.iban ? ' (' + a.iban + ')' : '') + '</option>';

                if (a.fints_enabled == 1) {
                    fintsHtml += '<option value="' + a.id + '">' + a.account_name + '</option>';
                }
            });

            if (!html) html = '<tr><td colspan="6" class="text-center text-muted">Noch keine Bankkonten angelegt</td></tr>';

            $('#accountsBody').html(html);
            $('#importAccount').html(selectHtml);
            $('#fintsAccount').html(fintsHtml);
            $('#accountsLoading').hide();
        }, false);
    }

    // ═══ Upload ═══
    $('#importFormat').change(function() {
        $('#csvMappingSection').toggle($(this).val() === 'csv');
    });

    $('#importFile').change(function() {
        var name = this.files[0] ? this.files[0].name : 'Datei auswaehlen...';
        $(this).next('.custom-file-label').text(name);
    });

    $('#uploadForm').submit(function(e) {
        e.preventDefault();
        var formData = new FormData();
        formData.append('file', $('#importFile')[0].files[0]);
        formData.append('format', $('#importFormat').val());
        formData.append('account_id', $('#importAccount').val());

        if ($('#importFormat').val() === 'csv') {
            formData.append('csv_mapping', JSON.stringify({
                date: parseInt($('#csvDate').val()),
                amount: parseInt($('#csvAmount').val()),
                reference: parseInt($('#csvReference').val()),
                counterpart_name: parseInt($('#csvName').val()),
                delimiter: $('#csvDelimiter').val(),
                date_format: $('#csvDateFormat').val(),
                decimal_separator: ',',
                skip_rows: 1
            }));
        }

        $('#uploadBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Importiere...');

        var csrfToken = $('meta[name="csrf-token"]').attr('content') || '';
        $.ajax({
            url: '{{ CONFIG.ROOTURL }}/api/bankImport/upload.php',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: { 'X-CSRF-Token': csrfToken },
            success: function(result) {
                $('#uploadBtn').prop('disabled', false).html('<i class="fas fa-upload"></i> Importieren');
                if (result.result) {
                    var r = result.response;
                    currentSessionId = r.session_id;
                    $('#resultNew').text(r.transactions);
                    $('#resultMatched').text(r.matched);
                    $('#resultDuplicates').text(r.duplicates);
                    $('#importResultCard').show();
                } else {
                    bootbox.alert('Fehler: ' + (result.error ? result.error.message : 'Unbekannt'));
                }
            },
            error: function() {
                $('#uploadBtn').prop('disabled', false).html('<i class="fas fa-upload"></i> Importieren');
                bootbox.alert('Verbindungsfehler');
            }
        });
    });

    // ═══ Session-Transaktionen laden ═══
    function loadSessionTransactions(sessionId) {
        currentSessionId = sessionId;
        $('#matchingSection').show();
        $('#matchingLoading').show();

        ajaxcall('bankImport/transactions.php', { session_id: sessionId }, function(data) {
            var txs = data.response.transactions || [];
            var stats = data.response.stats || {};
            var html = '';

            txs.forEach(function(tx) {
                var amountClass = parseFloat(tx.amount) >= 0 ? 'text-success' : 'text-danger';
                html += '<tr class="' + (tx.match_status === 'confirmed' ? 'table-success' : (tx.match_status === 'ignored' ? 'table-secondary' : '')) + '">';
                html += '<td>' + formatDate(tx.transaction_date) + '</td>';
                html += '<td>' + (tx.counterpart_name || '-') + '</td>';
                html += '<td><small>' + (tx.reference || '').substring(0, 60) + '</small></td>';
                html += '<td class="text-right ' + amountClass + '"><strong>' + parseFloat(tx.amount).toFixed(2).replace('.', ',') + '</strong></td>';

                // Zuordnung
                if (tx.doc_number) {
                    html += '<td><a href="#">' + tx.doc_number + '</a><br><small>' + (tx.invoice_client || '') + '</small></td>';
                } else {
                    html += '<td class="text-muted">-</td>';
                }

                html += '<td>' + confidenceBadge(tx.match_confidence, tx.match_method) + '</td>';

                // Aktionen
                html += '<td>';
                if (tx.match_status === 'unmatched') {
                    html += '<button class="btn btn-xs btn-outline-primary matchBtn" data-id="' + tx.id + '" data-amount="' + tx.amount + '"><i class="fas fa-link"></i></button> ';
                    html += '<button class="btn btn-xs btn-outline-secondary ignoreBtn" data-id="' + tx.id + '"><i class="fas fa-ban"></i></button>';
                } else if (tx.match_status === 'suggested') {
                    html += '<button class="btn btn-xs btn-success confirmBtn" data-id="' + tx.id + '"><i class="fas fa-check"></i></button> ';
                    html += '<button class="btn btn-xs btn-outline-primary matchBtn" data-id="' + tx.id + '" data-amount="' + tx.amount + '"><i class="fas fa-edit"></i></button>';
                } else {
                    html += statusBadge(tx.match_status);
                }
                html += '</td></tr>';
            });

            if (!html) html = '<tr><td colspan="7" class="text-center text-muted">Keine Transaktionen</td></tr>';

            $('#matchingBody').html(html);
            $('#matchUnmatched').text(stats.unmatched || 0);
            $('#matchSuggested').text(stats.suggested || 0);
            $('#matchConfirmed').text(stats.confirmed || 0);
            $('#matchingLoading').hide();

            // Scroll zu Matching
            $('html, body').animate({ scrollTop: $('#matchingSection').offset().top - 60 }, 300);
        }, false);
    }

    $('#goToSessionBtn').click(function() { loadSessionTransactions(currentSessionId); });
    $('#fintsGoToSessionBtn').click(function() {
        // Zum Import-Tab wechseln und Session laden
        $('a[href="#tabImport"]').tab('show');
        loadSessionTransactions(currentSessionId);
    });

    // ═══ Einzelne Transaktion bestaetigen ═══
    $(document).on('click', '.confirmBtn', function() {
        var txId = $(this).data('id');
        ajaxcall('bankImport/confirm.php', { transaction_id: txId }, function() {
            loadSessionTransactions(currentSessionId);
        });
    });

    // ═══ Alle bestaetigen ═══
    $('#confirmAllBtn').click(function() {
        if (!currentSessionId) return;
        bootbox.confirm('Alle vorgeschlagenen Zuordnungen bestaetigen und Zahlungen verbuchen?', function(ok) {
            if (!ok) return;
            ajaxcall('bankImport/confirm.php', { session_id: currentSessionId }, function(data) {
                var r = data.response;
                bootbox.alert(r.confirmed + ' Zuordnungen bestaetigt' + (r.failed ? ', ' + r.failed + ' fehlgeschlagen' : ''));
                loadSessionTransactions(currentSessionId);
            });
        });
    });

    // ═══ Ignorieren ═══
    $(document).on('click', '.ignoreBtn', function() {
        var txId = $(this).data('id');
        ajaxcall('bankImport/ignore.php', { transaction_id: txId }, function() {
            loadSessionTransactions(currentSessionId);
        });
    });

    // ═══ Manuelles Matching ═══
    $(document).on('click', '.matchBtn', function() {
        $('#matchTxId').val($(this).data('id'));
        $('#invoiceSearch').val('');
        $('#invoiceResults').hide();
        $('#searchInvoiceModal').modal('show');
    });

    $('#searchInvoiceBtn').click(function() {
        ajaxcall('bankImport/searchInvoices.php', {
            q: $('#invoiceSearch').val(),
            amount: '' // Could pass tx amount for sorting
        }, function(data) {
            var invoices = data.response.invoices || data.response || [];
            var html = '';
            invoices.forEach(function(inv) {
                html += '<tr>';
                html += '<td><strong>' + (inv.doc_number || '') + '</strong></td>';
                html += '<td>' + (inv.clients_name || '') + '</td>';
                html += '<td>' + (inv.projects_name || '') + '</td>';
                html += '<td class="text-right">' + parseFloat(inv.remaining || 0).toFixed(2).replace('.', ',') + '</td>';
                html += '<td class="text-right">' + parseFloat(inv.gross_amount || 0).toFixed(2).replace('.', ',') + '</td>';
                html += '<td>' + formatDate(inv.due_date) + '</td>';
                html += '<td><button class="btn btn-sm btn-success selectInvoiceBtn" data-id="' + inv.id + '"><i class="fas fa-check"></i></button></td>';
                html += '</tr>';
            });
            if (!html) html = '<tr><td colspan="7" class="text-center text-muted">Keine offenen Rechnungen gefunden</td></tr>';
            $('#invoiceResultsBody').html(html);
            $('#invoiceResults').show();
        }, false);
    });

    $(document).on('click', '.selectInvoiceBtn', function() {
        var docId = $(this).data('id');
        var txId = $('#matchTxId').val();
        ajaxcall('bankImport/match.php', { transaction_id: txId, document_lifecycle_id: docId }, function() {
            $('#searchInvoiceModal').modal('hide');
            loadSessionTransactions(currentSessionId);
        });
    });

    // ═══ FinTS ═══
    $('#fintsForm').submit(function(e) {
        e.preventDefault();
        var accountId = $('#fintsAccount').val();
        var pin = $('#fintsPin').val();
        if (!accountId || !pin) return;

        $('#fintsFetchBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Verbinde...');

        ajaxcall('bankImport/fintsConnect.php', {
            account_id: accountId,
            pin: pin,
            action: 'fetch_transactions',
            date_from: $('#fintsDateFrom').val(),
            date_to: $('#fintsDateTo').val()
        }, function(data) {
            $('#fintsFetchBtn').prop('disabled', false).html('<i class="fas fa-download"></i> Umsaetze abrufen');
            var r = data.response;
            fintsSessionId = r.session_id;

            if (r.needs_tan) {
                // TAN-Dialog anzeigen
                $('#tanChallenge').text(r.challenge || 'Bitte TAN eingeben');
                if (r.challenge_image) {
                    $('#tanImage').attr('src', 'data:image/png;base64,' + r.challenge_image);
                    $('#tanImageContainer').show();
                } else {
                    $('#tanImageContainer').hide();
                }
                $('#tanCard').show();
                $('#fintsInfoCard').hide();
                $('#tanInput').val('').focus();
                startTanCountdown();
            } else {
                // Direkt-Ergebnis
                showFintsResult(r.result);
            }
        }, false);
    });

    $('#tanSubmitBtn').click(function() {
        var tan = $('#tanInput').val();
        var pin = $('#fintsPin').val();
        if (!tan) return;

        $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Pruefe...');

        ajaxcall('bankImport/fintsSubmitTan.php', {
            session_id: fintsSessionId,
            tan: tan,
            pin: pin
        }, function(data) {
            $('#tanSubmitBtn').prop('disabled', false).html('<i class="fas fa-check"></i> TAN bestaetigen');
            var r = data.response;

            if (r.needs_tan) {
                $('#tanChallenge').text(r.challenge || 'Bitte weitere TAN eingeben');
                $('#tanInput').val('').focus();
            } else {
                $('#tanCard').hide();
                clearInterval(tanCountdownTimer);
                showFintsResult(r.result);
            }
        }, false);
    });

    function showFintsResult(result) {
        currentSessionId = result.import_session_id;
        $('#fintsTotal').text(result.total_fetched);
        $('#fintsNew').text(result.new_transactions);
        $('#fintsMatched').text(result.auto_matched);
        $('#fintsDupes').text(result.duplicates);
        $('#fintsResultCard').show();
        // PIN loeschen
        $('#fintsPin').val('');
    }

    function startTanCountdown() {
        var remaining = 300;
        clearInterval(tanCountdownTimer);
        tanCountdownTimer = setInterval(function() {
            remaining--;
            $('#tanCountdown').text(remaining);
            if (remaining <= 0) {
                clearInterval(tanCountdownTimer);
                $('#tanCard').hide();
                bootbox.alert('TAN-Session abgelaufen. Bitte erneut starten.');
            }
        }, 1000);
    }

    // ═══ Bankkonten CRUD ═══
    $('#addAccountBtn').click(function() {
        $('#accountEditId').val('');
        $('#accountForm')[0].reset();
        $('#accountFormTitle').text('Neues Bankkonto');
    });

    $('#accountForm').submit(function(e) {
        e.preventDefault();
        var editId = $('#accountEditId').val();
        var data = {
            account_name: $('#accName').val(),
            iban: $('#accIban').val(),
            bic: $('#accBic').val(),
            bank_name: $('#accBankName').val(),
            is_default: $('#accDefault').is(':checked') ? 1 : 0
        };

        // FinTS-Felder
        if ($('#accFintsUrl').val()) {
            data.fints_url = $('#accFintsUrl').val();
            data.fints_blz = $('#accFintsBlz').val();
            data.fints_username = $('#accFintsUser').val();
            data.fints_enabled = $('#accFintsEnabled').is(':checked') ? 1 : 0;
        }

        if (editId) {
            // Update - accounts.php erwartet PUT mit account_id
            var csrfToken = $('meta[name="csrf-token"]').attr('content') || '';
            data.account_id = editId;
            $.ajax({
                url: '{{ CONFIG.ROOTURL }}/api/bankImport/accounts.php',
                type: 'PUT',
                data: $.param(data),
                headers: { 'X-CSRF-Token': csrfToken },
                success: function() {
                    loadAccounts();
                    $('#accountForm')[0].reset();
                    $('#accountEditId').val('');
                    $('#accountFormTitle').text('Neues Bankkonto');
                }
            });

            // FinTS separat konfigurieren
            if (data.fints_url) {
                ajaxcall('bankImport/fintsConfigure.php', {
                    account_id: editId,
                    fints_url: data.fints_url,
                    fints_blz: data.fints_blz,
                    fints_username: data.fints_username,
                    fints_enabled: data.fints_enabled
                }, function() {}, false);
            }
        } else {
            ajaxcall('bankImport/accounts.php', data, function() {
                loadAccounts();
                $('#accountForm')[0].reset();
            });
        }
    });

    $(document).on('click', '.deleteAccountBtn', function() {
        var id = $(this).data('id');
        bootbox.confirm('Bankkonto wirklich loeschen?', function(ok) {
            if (!ok) return;
            var csrfToken = $('meta[name="csrf-token"]').attr('content') || '';
            $.ajax({
                url: '{{ CONFIG.ROOTURL }}/api/bankImport/accounts.php?account_id=' + id,
                type: 'DELETE',
                headers: { 'X-CSRF-Token': csrfToken },
                success: function() { loadAccounts(); }
            });
        });
    });

    // ═══ Banksuche (fuer FinTS-Konfiguration) ═══
    var searchTimeout = null;
    $('#accFintsSearch').on('input', function() {
        var q = $(this).val();
        clearTimeout(searchTimeout);
        if (q.length < 2) { $('#bankSearchResults').hide(); return; }

        searchTimeout = setTimeout(function() {
            var csrfToken = $('meta[name="csrf-token"]').attr('content') || '';
            $.ajax({
                url: '{{ CONFIG.ROOTURL }}/api/bankImport/fintsConfigure.php?query=' + encodeURIComponent(q),
                type: 'GET',
                headers: { 'X-CSRF-Token': csrfToken },
                success: function(result) {
                    if (!result.result) return;
                    var banks = result.response.banks || [];
                    var html = '';
                    banks.forEach(function(b) {
                        html += '<a href="#" class="list-group-item list-group-item-action bankSelectItem" data-url="' + b.url + '" data-blz="' + b.blz + '" data-name="' + b.name + '">';
                        html += '<strong>' + b.name + '</strong> <small class="text-muted">BLZ: ' + b.blz + '</small>';
                        html += '</a>';
                    });
                    if (!html) html = '<div class="list-group-item text-muted">Keine Treffer</div>';
                    $('#bankSearchResults').html(html).show();
                }
            });
        }, 300);
    });

    $(document).on('click', '.bankSelectItem', function(e) {
        e.preventDefault();
        $('#accFintsUrl').val($(this).data('url'));
        $('#accFintsBlz').val($(this).data('blz'));
        $('#accBankName').val($(this).data('name'));
        $('#bankSearchResults').hide();
        $('#accFintsSearch').val($(this).data('name'));
    });

    // ═══ Verlauf laden ═══
    function loadHistory() {
        ajaxcall('bankImport/sessions.php', null, function(data) {
            var sessions = data.response.sessions || data.response || [];
            var html = '';

            sessions.forEach(function(s) {
                var format = s.format === 'fints' ? '<span class="badge badge-primary">FinTS</span>' :
                             '<span class="badge badge-secondary">' + (s.format || '').toUpperCase() + '</span>';
                var status = s.confirmed == 1 ? '<span class="badge badge-success">Bestaetigt</span>' : '<span class="badge badge-warning">Offen</span>';

                html += '<tr>';
                html += '<td>' + formatDate((s.created_at || '').substring(0, 10)) + '</td>';
                html += '<td>' + format + '</td>';
                html += '<td>' + (s.account_name || '-') + '</td>';
                html += '<td>' + (s.filename || '-') + '</td>';
                html += '<td class="text-right">' + (s.transaction_count || 0) + '</td>';
                html += '<td class="text-right">' + (s.matched_count || 0) + '</td>';
                html += '<td>' + status + '</td>';
                html += '<td><button class="btn btn-xs btn-outline-primary viewSessionBtn" data-id="' + s.id + '"><i class="fas fa-eye"></i></button></td>';
                html += '</tr>';
            });

            if (!html) html = '<tr><td colspan="8" class="text-center text-muted">Noch keine Imports</td></tr>';
            $('#historyBody').html(html);
            $('#historyLoading').hide();
        }, false);
    }

    $(document).on('click', '.viewSessionBtn', function() {
        $('a[href="#tabImport"]').tab('show');
        loadSessionTransactions($(this).data('id'));
    });

    // ═══ Init ═══
    loadAccounts();
    loadHistory();

    // Tab-Wechsel: Daten nachladen
    $('a[data-toggle="tab"]').on('shown.bs.tab', function(e) {
        if (e.target.hash === '#tabHistory') loadHistory();
        if (e.target.hash === '#tabAccounts') loadAccounts();
    });
});
</script>
{% endblock %}
