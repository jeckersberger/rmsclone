            </div>
            <div class="card-body p-0">
                <div class="overlay" id="historyLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>Datum</th>
