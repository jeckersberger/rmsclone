{% extends "assets/template.twig" %}
{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-exclamation-triangle"></i> {{ t('dunning_overview') }}</h3>
                <div class="card-tools">
                    <a href="{{ CONFIG.ROOTURL }}/instances/configuration/dunning-levels.php" class="btn btn-sm btn-outline-secondary mr-1"><i class="fas fa-cog"></i> Mahnstufen</a>
                    <button class="btn btn-sm btn-outline-success" id="exportDunningBtn"><i class="fas fa-file-csv"></i> CSV Export</button>
                </div>
            </div>
            <div class="card-body">
                <div class="row" id="dunningStats">
                    <div class="col-md-3">
                        <div class="info-box bg-warning">
                            <span class="info-box-icon"><i class="fas fa-clock"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">{{ t('overdue_invoices') }}</span>
                                <span class="info-box-number" id="statOverdueCount">-</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box bg-danger">
                            <span class="info-box-icon"><i class="fas fa-euro-sign"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">{{ t('overdue_amount') }}</span>
                                <span class="info-box-number" id="statOverdueAmount">-</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box bg-info">
                            <span class="info-box-icon"><i class="fas fa-envelope"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">{{ t('dunnings_sent') }}</span>
                                <span class="info-box-number" id="statDunningSent">-</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box bg-success">
                            <span class="info-box-icon"><i class="fas fa-check"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">{{ t('dunnings_resolved') }}</span>
                                <span class="info-box-number" id="statDunningResolved">-</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ t('overdue_invoices') }}</h3>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="dunningLoadingOverlay"><i class="fas fa-sync fa-spin fa-3x"></i></div>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>{{ t('doc_number') }}</th>
                            <th>{{ t('project') }}</th>
                            <th>{{ t('client') }}</th>
                            <th>{{ t('gross_amount') }}</th>
                            <th>Zahlungsstatus</th>
                            <th>{{ t('due_date') }}</th>
                            <th>{{ t('days_overdue') }}</th>
                            <th>{{ t('dunning_level') }}</th>
                            <th>Mahnsperre</th>
                            <th>{{ t('actions') }}</th>
                        </tr>
                    </thead>
                    <tbody id="dunningTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    var levelLabels = {
        0: '{{ t("no_dunning") }}',
        1: '{{ t("payment_reminder") }}',
        2: '{{ t("first_dunning") }}',
        3: '{{ t("second_dunning") }}',
        4: '{{ t("final_dunning") }}'
    };
    var levelBadges = {0: 'secondary', 1: 'info', 2: 'warning', 3: 'danger', 4: 'dark'};

    function loadDunning() {
        ajaxcall('dunning/overview.php', {}, function(data) {
            if (!data.response) return;

            // Stats
            if (data.response.stats) {
                var s = data.response.stats;
                $('#statOverdueCount').text(s.overdue_count || 0);
                $('#statOverdueAmount').text(formatMoney(s.overdue_amount));
                $('#statDunningSent').text(s.dunnings_this_month || 0);
                $('#statDunningResolved').text(s.resolved_this_month || 0);
            }

            // Table
            var html = '';
            if (data.response.invoices && data.response.invoices.length > 0) {
                data.response.invoices.forEach(function(inv) {
                    var daysOverdue = Math.floor((Date.now() - new Date(inv.due_date).getTime()) / 86400000);
                    var level = inv.dunning_level || 0;
                    var isPaused = inv.last_dunning && inv.last_dunning.dunning_history_paused == 1;
                    var pauseReason = (inv.last_dunning && inv.last_dunning.dunning_history_pauseReason) || '';

                    html += '<tr' + (isPaused ? ' class="table-secondary"' : '') + '>';
                    html += '<td>' + (inv.doc_number || '-') + '</td>';
                    html += '<td>' + (inv.projects_name || '-') + '</td>';
                    html += '<td>' + (inv.clients_name || '-') + '</td>';

                    // Bruttobetrag mit Zahlungsinfo
                    var amountHtml = formatMoney(inv.gross_amount);
                    if (parseFloat(inv.paid_amount || 0) > 0) {
                        var remaining = parseFloat(inv.gross_amount) - parseFloat(inv.paid_amount);
                        amountHtml += '<br><small class="text-success">Bezahlt: ' + formatMoney(inv.paid_amount) + '</small>';
                        amountHtml += '<br><small class="text-danger">Offen: ' + formatMoney(remaining) + '</small>';
                    }
                    html += '<td>' + amountHtml + '</td>';

                    // Zahlungsstatus
                    var payStatus = inv.document_exports_paymentStatus || 'unpaid';
                    var payBadges = {'unpaid': 'danger', 'partial': 'warning', 'paid': 'success'};
                    var payLabels = {'unpaid': 'Unbezahlt', 'partial': 'Teilbezahlt', 'paid': 'Bezahlt'};
                    html += '<td><span class="badge badge-' + (payBadges[payStatus] || 'secondary') + '"><i class="fas fa-coins"></i> ' + (payLabels[payStatus] || payStatus) + '</span></td>';

                    html += '<td>' + (inv.due_date || '-') + '</td>';
                    html += '<td><span class="badge badge-' + (daysOverdue > 30 ? 'danger' : 'warning') + '">' + daysOverdue + ' {{ t("days") }}</span></td>';
                    html += '<td><span class="badge badge-' + (levelBadges[level] || 'secondary') + '">' + (levelLabels[level] || '-') + '</span></td>';

                    // Mahnsperre-Spalte
                    html += '<td>';
                    if (isPaused) {
                        html += '<span class="badge badge-info" title="' + pauseReason + '"><i class="fas fa-pause-circle"></i> Pausiert</span>';
                        html += '<br><small class="text-muted">' + pauseReason + '</small>';
                    } else {
                        html += '<span class="badge badge-light"><i class="fas fa-play-circle"></i> Aktiv</span>';
                    }
                    html += '</td>';

                    // Aktionen
                    html += '<td>';
                    html += '<div class="btn-group btn-group-sm">';
                    if (!isPaused) {
                        html += '<button class="btn btn-warning createDunningBtn" data-id="' + inv.id + '" title="{{ t("create_dunning") }}"><i class="fas fa-envelope"></i></button>';
                    }
                    html += '<button class="btn btn-info aiDunningBtn" data-id="' + inv.id + '" data-doc="' + (inv.doc_number || '') + '" data-client="' + (inv.clients_name || '') + '" data-amount="' + (inv.gross_amount || 0) + '" data-email="' + (inv.clients_email || '') + '" title="KI-Mahnung generieren"><i class="fas fa-robot"></i></button>';
                    if (inv.last_dunning && inv.last_dunning.id) {
                        html += '<button class="btn btn-secondary generateLetterBtn" data-dunning-id="' + inv.last_dunning.id + '" title="PDF erzeugen"><i class="fas fa-file-pdf"></i></button>';
                    }
                    html += '<button class="btn btn-success markPaidBtn" data-id="' + inv.id + '" title="{{ t("mark_paid") }}"><i class="fas fa-check"></i></button>';
                    // Mahnsperre umschalten
                    if (inv.document_exports_id) {
                        if (isPaused) {
                            html += '<button class="btn btn-outline-success togglePauseBtn" data-exports-id="' + inv.document_exports_id + '" data-paused="0" title="Mahnverfahren fortsetzen"><i class="fas fa-play"></i></button>';
                        } else {
                            html += '<button class="btn btn-outline-warning togglePauseBtn" data-exports-id="' + inv.document_exports_id + '" data-paused="1" title="Mahnverfahren pausieren"><i class="fas fa-pause"></i></button>';
                        }
                    }
                    html += '</div>';
                    html += '</td>';
                    html += '</tr>';
                });
            } else {
                html = '<tr><td colspan="10" class="text-center text-muted">{{ t("no_overdue_invoices") }}</td></tr>';
            }
            $('#dunningTableBody').html(html);
            $('#dunningLoadingOverlay').hide();
        }, false);
    }

    function formatMoney(val) {
        return parseFloat(val || 0).toFixed(2).replace('.', ',') + ' \u20AC';
    }

    loadDunning();

    // Create dunning - suggestion only, user confirms manually
    $(document).on('click', '.createDunningBtn', function() {
        var docId = $(this).data('id');
        var row = $(this).closest('tr');
        var docNumber = row.find('td:first').text().trim();
        var clientName = row.find('td:eq(2)').text().trim();
        var amount = row.find('td:eq(3)').text().trim();
        var daysText = row.find('td:eq(5) .badge').text().trim();
        var level = row.find('td:eq(6) .badge').text().trim();

        bootbox.dialog({
            title: '<i class="fas fa-bell"></i> {{ t("dunning_suggestion_title") }}',
            message: '<div class="alert alert-info"><i class="fas fa-info-circle"></i> ' +
                '<strong>{{ t("dunning_suggestion_hint") }}</strong></div>' +
                '<table class="table table-sm table-borderless">' +
                '<tr><td><strong>{{ t("doc_number") }}:</strong></td><td>' + docNumber + '</td></tr>' +
                '<tr><td><strong>{{ t("client") }}:</strong></td><td>' + clientName + '</td></tr>' +
                '<tr><td><strong>{{ t("gross_amount") }}:</strong></td><td>' + amount + '</td></tr>' +
                '<tr><td><strong>{{ t("days_overdue") }}:</strong></td><td>' + daysText + '</td></tr>' +
                '<tr><td><strong>{{ t("dunning_level") }}:</strong></td><td>' + level + '</td></tr>' +
                '</table>' +
                '<hr><p class="text-muted"><small>{{ t("dunning_suggestion_desc") }}</small></p>',
            buttons: {
                cancel: { label: '{{ t("cancel") }}', className: 'btn-default' },
                confirm: {
                    label: '<i class="fas fa-envelope"></i> {{ t("create_dunning") }}',
                    className: 'btn-warning',
                    callback: function() {
                        ajaxcall('dunning/create.php', {doc_id: docId}, function() {
                            loadDunning();
                        });
                    }
                }
            }
        });
    });

    // AI Dunning - generate and preview AI draft
    $(document).on('click', '.aiDunningBtn', function() {
        var btn = $(this);
        var docId = btn.data('id');
        var docNumber = btn.data('doc');
        var clientName = btn.data('client');
        var amount = parseFloat(btn.data('amount') || 0).toFixed(2).replace('.', ',') + ' \u20AC';
        var clientEmail = btn.data('email');

        if (!clientEmail) {
            bootbox.alert('{{ t("no_client_email") }}');
            return;
        }

        btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

        ajaxcall('ai/emailDraft.php', {
            context: 'Zahlungserinnerung fuer Rechnung ' + docNumber + ', Kunde: ' + clientName + ', Betrag: ' + amount,
            subject: 'Zahlungserinnerung - Rechnung ' + docNumber,
            type: 'dunning'
        }, function(data) {
            btn.html('<i class="fas fa-robot"></i>').prop('disabled', false);
            var draft = (data.response && data.response.draft) ? data.response.draft : '';

            bootbox.dialog({
                title: '<i class="fas fa-robot"></i> KI-Mahnung: ' + docNumber,
                message: '<div class="form-group">' +
                    '<label>An: <strong>' + clientEmail + '</strong> (' + clientName + ')</label>' +
                    '</div>' +
                    '<div class="form-group">' +
                    '<label>Betreff</label>' +
                    '<input type="text" class="form-control" id="aiDunningSubject" value="Zahlungserinnerung - Rechnung ' + docNumber + '">' +
                    '</div>' +
                    '<div class="form-group">' +
                    '<label>Nachricht (kann bearbeitet werden)</label>' +
                    '<textarea class="form-control" id="aiDunningBody" rows="10">' + draft + '</textarea>' +
                    '</div>',
                buttons: {
                    cancel: { label: '{{ t("cancel") }}', className: 'btn-default' },
                    send: {
                        label: '<i class="fas fa-paper-plane"></i> Senden',
                        className: 'btn-warning',
                        callback: function() {
                            ajaxcall('emailInbox/compose.php', {
                                to: clientEmail,
                                to_name: clientName,
                                subject: $('#aiDunningSubject').val(),
                                body: $('#aiDunningBody').val()
                            }, function() {
                                // Also create dunning entry
                                ajaxcall('dunning/create.php', {doc_id: docId}, function() {
                                    bootbox.alert('<i class="fas fa-check text-success"></i> Mahnung gesendet und protokolliert.');
                                    loadDunning();
                                });
                            });
                        }
                    }
                }
            });
        }, function() {
            btn.html('<i class="fas fa-robot"></i>').prop('disabled', false);
            bootbox.alert('KI-Entwurf konnte nicht generiert werden.');
        });
    });

    // CSV Export
    $('#exportDunningBtn').on('click', function() {
        ajaxcall('reports/export.php', {type: 'dunning'}, function(data) {
            if (!data.response || !data.response.csv) { bootbox.alert('Export fehlgeschlagen.'); return; }
            var blob = new Blob([atob(data.response.csv)], {type: 'text/csv;charset=utf-8;'});
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url; a.download = data.response.filename || 'mahnungen.csv';
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            URL.revokeObjectURL(url);
        });
    });

    // Mark as paid
    $(document).on('click', '.markPaidBtn', function() {
        var docId = $(this).data('id');
        bootbox.prompt('{{ t("enter_paid_amount") }}', function(amount) {
            if (amount) {
                ajaxcall('documentLifecycle/changeStatus.php', {doc_id: docId, status: 'paid'}, function() {
                    loadDunning();
                });
            }
        });
    });

    // Mahnsperre manuell umschalten
    $(document).on('click', '.togglePauseBtn', function() {
        var exportsId = $(this).data('exports-id');
        var paused = $(this).data('paused');
        var btn = $(this);

        if (paused == 1) {
            // Pausieren: Grund abfragen
            bootbox.prompt({
                title: '<i class="fas fa-pause-circle"></i> Mahnverfahren pausieren',
                message: '<p>Geben Sie einen Grund fuer die Mahnsperre an:</p>',
                value: 'Manuell pausiert',
                callback: function(reason) {
                    if (reason === null) return;
                    btn.prop('disabled', true);
                    ajaxcall('payments/toggleDunningPause.php', {
                        document_exports_id: exportsId,
                        paused: 1,
                        reason: reason
                    }, function() {
                        loadDunning();
                    });
                }
            });
        } else {
            // Fortsetzen
            bootbox.confirm('Mahnverfahren wirklich fortsetzen?', function(ok) {
                if (!ok) return;
                btn.prop('disabled', true);
                ajaxcall('payments/toggleDunningPause.php', {
                    document_exports_id: exportsId,
                    paused: 0,
                    reason: ''
                }, function() {
                    loadDunning();
                });
            });
        }
    });

    // PDF erzeugen (Mahnbrief)
    $(document).on('click', '.generateLetterBtn', function() {
        var btn = $(this);
        var dunningId = btn.data('dunning-id');
        btn.html('<i class="fas fa-spinner fa-spin"></i> PDF...').prop('disabled', true);

        ajaxcall('dunning/generateLetter.php', {dunning_id: dunningId}, function(data) {
            btn.html('<i class="fas fa-file-pdf"></i> PDF').prop('disabled', false);
            if (data.result && data.response) {
                var downloadUrl = data.response.download_url;
                var filename = data.response.filename || 'Mahnbrief.pdf';
                bootbox.dialog({
                    title: '<i class="fas fa-file-pdf text-danger"></i> Mahnbrief erstellt',
                    message: '<p>Der Mahnbrief <strong>' + filename + '</strong> wurde erfolgreich erzeugt.</p>' +
                        (downloadUrl ? '<a href="' + downloadUrl + '" target="_blank" class="btn btn-primary"><i class="fas fa-download"></i> PDF herunterladen</a>' : ''),
                    buttons: {
                        ok: { label: 'Schliessen', className: 'btn-default' }
                    }
                });
            } else {
                bootbox.alert('<i class="fas fa-exclamation-triangle text-danger"></i> Mahnbrief konnte nicht erzeugt werden.');
            }
        }, function() {
            btn.html('<i class="fas fa-file-pdf"></i> PDF').prop('disabled', false);
            bootbox.alert('Fehler beim Erzeugen des Mahnbriefs.');
        });
    });
});
</script>
{% endblock %}
