{% extends "assets/template.twig" %}
{% block content %}
{# ── Period Filter ── #}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-line"></i> {{ t('profit_dashboard') }}</h3>
                <div class="card-tools">
                    <div class="input-group input-group-sm" style="width:150px; display:inline-flex;">
                        <input type="date" class="form-control" id="profitDateFrom" value="{{ "now"|date("Y") }}-01-01">
                    </div>
                    <div class="input-group input-group-sm ml-1" style="width:150px; display:inline-flex;">
                        <input type="date" class="form-control" id="profitDateTo" value="{{ "now"|date("Y-m-d") }}">
                    </div>
                    <button class="btn btn-sm btn-primary ml-1" id="loadProfitBtn"><i class="fas fa-search"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── Summary Cards ── #}
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3 id="totalRevenue">-</h3>
                <p>{{ t('total_revenue') }}</p>
            </div>
            <div class="icon"><i class="fas fa-euro-sign"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3 id="totalCosts">-</h3>
                <p>{{ t('total_costs') }}</p>
            </div>
            <div class="icon"><i class="fas fa-minus-circle"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="totalProfit">-</h3>
                <p>{{ t('profit') }}</p>
            </div>
            <div class="icon"><i class="fas fa-chart-line"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3 id="totalMargin">-</h3>
                <p>{{ t('margin') }}</p>
            </div>
            <div class="icon"><i class="fas fa-percentage"></i></div>
        </div>
    </div>
</div>

{# ── Project Profit Table ── #}
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-list"></i> {{ t('profit_by_project') }}</h3>
            </div>
            <div class="card-body p-0">
                <div class="overlay" id="profitLoading"><i class="fas fa-sync fa-spin fa-2x"></i></div>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>{{ t('project') }}</th>
                            <th class="text-right">{{ t('revenue') }}</th>
                            <th class="text-right">{{ t('costs') }}</th>
                            <th class="text-right">{{ t('profit') }}</th>
                            <th class="text-right">{{ t('margin') }}</th>
                        </tr>
                    </thead>
                    <tbody id="profitBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Revenue Forecast ── #}
    <div class="col-lg-4">
        <div class="card card-outline card-info">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-binoculars"></i> {{ t('revenue_forecast') }}</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>{{ t('month') }}</th>
                            <th class="text-right">{{ t('projects') }}</th>
                            <th class="text-right">{{ t('estimated_revenue') }}</th>
                        </tr>
                    </thead>
                    <tbody id="forecastBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    function formatMoney(v) {
        return parseFloat(v || 0).toFixed(2).replace('.', ',') + ' \u20AC';
    }

    function loadProfit() {
        ajaxcall('profit/period.php', {
            date_from: $('#profitDateFrom').val(),
            date_to: $('#profitDateTo').val()
        }, function(data) {
            if (!data.response) return;
            var r = data.response;
            var t = r.totals;

            $('#totalRevenue').text(formatMoney(t.revenue));
            $('#totalCosts').text(formatMoney(t.costs));
            $('#totalProfit').text(formatMoney(t.profit));
            $('#totalMargin').text(t.margin_pct + '%');

            var html = '';
            if (r.projects && r.projects.length > 0) {
                r.projects.forEach(function(p) {
                    var profitClass = p.profit.profit >= 0 ? 'text-success' : 'text-danger';
                    html += '<tr>';
                    html += '<td><a href="{{ CONFIG.ROOTURL }}/project/?id=' + p.projects_id + '">' + p.projects_name + '</a></td>';
                    html += '<td class="text-right">' + formatMoney(p.profit.revenue.total) + '</td>';
                    html += '<td class="text-right">' + formatMoney(p.profit.costs.total) + '</td>';
                    html += '<td class="text-right ' + profitClass + '"><strong>' + formatMoney(p.profit.profit) + '</strong></td>';
                    html += '<td class="text-right">' + p.profit.margin_pct + '%</td>';
                    html += '</tr>';
                });
            } else {
                html = '<tr><td colspan="5" class="text-center text-muted">{{ t("no_data") }}</td></tr>';
            }
            $('#profitBody').html(html);
            $('#profitLoading').hide();
        }, false);
    }

    function loadForecast() {
        ajaxcall('profit/forecast.php', {months: 3}, function(data) {
            if (!data.response) return;
            var html = '';
            (data.response.forecast || []).forEach(function(f) {
                html += '<tr>';
                html += '<td>' + f.month + '</td>';
                html += '<td class="text-right">' + f.project_count + '</td>';
                html += '<td class="text-right"><strong>' + formatMoney(f.estimated_revenue) + '</strong></td>';
                html += '</tr>';
            });
            if (!html) html = '<tr><td colspan="3" class="text-center text-muted">{{ t("no_data") }}</td></tr>';
            $('#forecastBody').html(html);
        }, false);
    }

    loadProfit();
    loadForecast();

    $('#loadProfitBtn').click(loadProfit);
});
</script>
{% endblock %}
