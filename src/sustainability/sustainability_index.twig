{# Sustainability Reporting & ESG Module Template #}
{% extends 'layout.twig' %}

{% block title %}Nachhaltigkeitsreporting & ESG{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h1 class="mb-2">
                <i class="fas fa-leaf"></i> Nachhaltigkeitsreporting & ESG
            </h1>
        </div>
    </div>

    {# Tab Navigation #}
    <div class="card">
        <div class="card-header p-0 pt-1" role="tablist">
            <ul class="nav nav-tabs" id="sustainabilityTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="dashboard-tab" data-toggle="pill" href="#dashboard" role="tab">
                        <i class="fas fa-chart-line"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="byproject-tab" data-toggle="pill" href="#byproject" role="tab">
                        <i class="fas fa-project-diagram"></i> Nach Projekt
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="byclient-tab" data-toggle="pill" href="#byclient" role="tab">
                        <i class="fas fa-users"></i> Nach Kunde
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="reports-tab" data-toggle="pill" href="#reports" role="tab">
                        <i class="fas fa-file-pdf"></i> Berichte
                    </a>
                </li>
                {% if "SUSTAINABILITY:CONFIGURE"|instancePermissions %}
                <li class="nav-item">
                    <a class="nav-link" id="settings-tab" data-toggle="pill" href="#settings" role="tab">
                        <i class="fas fa-cog"></i> Einstellungen
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>

        <div class="card-body">
            <div class="tab-content">

                {# ========== DASHBOARD TAB ========== #}
                <div class="tab-pane fade show active" id="dashboard" role="tabpanel">
                    <div class="row">
                        {# Main CO2 Metric #}
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="info-box bg-success">
                                <span class="info-box-icon"><i class="fas fa-cloud"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">CO₂ diesen Monat</span>
                                    <span class="info-box-number" id="thisMonthCo2">0 kg</span>
                                    <div class="progress">
                                        <div class="progress-bar" style="width: 70%"></div>
                                    </div>
                                    <span class="progress-description" id="yoyComparison">
                                        <small id="yoyText">0% YoY</small>
                                    </span>
                                </div>
                            </div>
                        </div>

                        {# Transport vs Energy #}
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="info-box bg-info">
                                <span class="info-box-icon"><i class="fas fa-truck"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Transport</span>
                                    <span class="info-box-number" id="transportCo2">0 kg</span>
                                    <span class="progress-description" id="transportPercent">0%</span>
                                </div>
                            </div>
                        </div>

                        {# Energy #}
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="info-box bg-warning">
                                <span class="info-box-icon"><i class="fas fa-bolt"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Energie</span>
                                    <span class="info-box-number" id="energyCo2">0 kg</span>
                                    <span class="progress-description" id="energyKwh">0 kWh</span>
                                </div>
                            </div>
                        </div>

                        {# Projects #}
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="info-box bg-danger">
                                <span class="info-box-icon"><i class="fas fa-leaf"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Projekte</span>
                                    <span class="info-box-number" id="projectCount">0</span>
                                    <span class="progress-description" id="greenestProject">
                                        <small>Nachhaltigster Projekt</small>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        {# Trend Chart #}
                        <div class="col-12 col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">
                                        <i class="fas fa-chart-area"></i> CO₂-Trend (12 Monate)
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <canvas id="trendChart" style="height: 250px;"></canvas>
                                </div>
                            </div>
                        </div>

                        {# Split Chart #}
                        <div class="col-12 col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">
                                        <i class="fas fa-pie-chart"></i> Transport vs. Energie
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <canvas id="splitChart" style="height: 250px;"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ========== BY PROJECT TAB ========== #}
                <div class="tab-pane fade" id="byproject" role="tabpanel">
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="form-inline">
                                <label class="mr-2">Zeitraum:</label>
                                <input type="date" id="projectFromDate" class="form-control mr-2" />
                                <input type="date" id="projectToDate" class="form-control mr-2" />
                                <button class="btn btn-primary" onclick="loadProjectEmissions()">
                                    <i class="fas fa-sync"></i> Aktualisieren
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">CO₂-Emissionen nach Projekt</h3>
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th>Projektname</th>
                                                <th class="text-right">Transport (kg CO₂)</th>
                                                <th class="text-right">Energie (kg CO₂)</th>
                                                <th class="text-right">Gesamt (kg CO₂)</th>
                                                <th class="text-center">Bewertung</th>
                                            </tr>
                                        </thead>
                                        <tbody id="projectEmissionsTable">
                                            <tr>
                                                <td colspan="5" class="text-center text-muted">Lädt...</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ========== BY CLIENT TAB ========== #}
                <div class="tab-pane fade" id="byclient" role="tabpanel">
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="form-group">
                                <label>Kunde wählen:</label>
                                <select id="clientSelect" class="form-control select2bs4" onchange="loadClientEmissions()">
                                    <option value="">-- Bitte wählen --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-4">
                            <div class="info-box">
                                <span class="info-box-icon bg-info"><i class="fas fa-cloud"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Gesamt CO₂</span>
                                    <span class="info-box-number" id="clientTotalCo2">0 kg</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="info-box">
                                <span class="info-box-icon bg-warning"><i class="fas fa-truck"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Transport</span>
                                    <span class="info-box-number" id="clientTransportCo2">0 kg</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="info-box">
                                <span class="info-box-icon bg-success"><i class="fas fa-bolt"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Energie</span>
                                    <span class="info-box-number" id="clientEnergyCo2">0 kg</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="callout callout-info">
                                <p id="clientMessage">
                                    Wählen Sie einen Kunden aus, um seine Nachhaltigkeitsdaten anzuzeigen.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                {# ========== REPORTS TAB ========== #}
                <div class="tab-pane fade" id="reports" role="tabpanel">
                    <div class="row mb-3">
                        {% if "SUSTAINABILITY:CONFIGURE"|instancePermissions %}
                        <div class="col-12">
                            <button class="btn btn-primary" data-toggle="modal" data-target="#generateReportModal">
                                <i class="fas fa-plus"></i> Neuer Bericht
                            </button>
                        </div>
                        {% endif %}
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Generierte Berichte</h3>
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Typ</th>
                                                <th>Zeitraum</th>
                                                <th>Erstellt am</th>
                                                <th class="text-center">Aktionen</th>
                                            </tr>
                                        </thead>
                                        <tbody id="reportsTable">
                                            <tr>
                                                <td colspan="5" class="text-center text-muted">Lädt...</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ========== SETTINGS TAB ========== #}
                {% if "SUSTAINABILITY:CONFIGURE"|instancePermissions %}
                <div class="tab-pane fade" id="settings" role="tabpanel">
                    <form id="configForm" onsubmit="saveConfiguration(event)">
                        <div class="row">
                            <div class="col-12 col-md-6">
                                <div class="card">
                                    <div class="card-header">
                                        <h3 class="card-title">
                                            <i class="fas fa-truck"></i> Emissionsfaktoren (kg CO₂ / km)
                                        </h3>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-group">
                                            <label>Van</label>
                                            <input type="number" step="0.01" id="emissionVan" class="form-control" placeholder="0.21" />
                                        </div>
                                        <div class="form-group">
                                            <label>Lastwagen (Truck)</label>
                                            <input type="number" step="0.01" id="emissionTruck" class="form-control" placeholder="0.35" />
                                        </div>
                                        <div class="form-group">
                                            <label>Auto (Car)</label>
                                            <input type="number" step="0.01" id="emissionCar" class="form-control" placeholder="0.15" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="card">
                                    <div class="card-header">
                                        <h3 class="card-title">
                                            <i class="fas fa-bolt"></i> Energieeinstellungen
                                        </h3>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-group">
                                            <label>Durchschnittspreis Strom (€ / kWh)</label>
                                            <input type="number" step="0.0001" id="kwhPrice" class="form-control" placeholder="0.30" />
                                        </div>
                                        <div class="form-group">
                                            <label>CO₂-Emissionen Strom (kg CO₂ / kWh)</label>
                                            <input type="number" step="0.0001" id="co2PerKwh" class="form-control" placeholder="0.42" />
                                        </div>
                                        <div class="form-group">
                                            <label>
                                                <input type="checkbox" id="enableClientReports" />
                                                Kundenbergichte aktivieren
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-save"></i> Speichern
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
                {% endif %}

            </div>
        </div>
    </div>
</div>

{# ========== MODALS ========== #}

{# Generate Report Modal #}
<div class="modal fade" id="generateReportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Neuen Bericht erstellen</h4>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form id="reportForm" onsubmit="generateReport(event)">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Berichttyp</label>
                        <select id="reportType" class="form-control" required>
                            <option value="">-- Bitte wählen --</option>
                            <option value="monthly">Monatlich</option>
                            <option value="quarterly">Quartalsweise</option>
                            <option value="annual">Jährlich</option>
                            <option value="project">Projektbezogen</option>
                            <option value="client">Kundenbezogen</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Startdatum</label>
                        <input type="date" id="reportStart" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Enddatum</label>
                        <input type="date" id="reportEnd" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-file-pdf"></i> Erstellen
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{# Report Detail Modal #}
<div class="modal fade" id="reportDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="reportDetailTitle">Berichtsdetails</h4>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body" id="reportDetailContent">
                Lädt...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Schließen</button>
                <button type="button" class="btn btn-primary" id="downloadPdfBtn">
                    <i class="fas fa-download"></i> PDF herunterladen
                </button>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
const CONFIG_ROOT = "{{ CONFIG.ROOTURL }}";
let trendChart, splitChart;

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    loadDashboard();
    loadReports();
    loadProjectEmissions();
    loadConfiguration();
    loadClients();
});

// ========== DASHBOARD ==========
function loadDashboard() {
    fetch(`${CONFIG_ROOT}/api/sustainability/dashboard.php`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                updateDashboard(data.data);
                loadTrend();
            }
        })
        .catch(err => console.error('Dashboard error:', err));
}

function updateDashboard(stats) {
    document.getElementById('thisMonthCo2').textContent = stats.this_month_co2_kg.toFixed(2) + ' kg';
    document.getElementById('transportCo2').textContent = stats.this_month_transport_kg.toFixed(2) + ' kg';
    document.getElementById('energyCo2').textContent = stats.this_month_energy_kg.toFixed(2) + ' kg';
    document.getElementById('energyKwh').textContent = stats.total_kwh_this_month.toFixed(2) + ' kWh';
    document.getElementById('projectCount').textContent = stats.this_month_projects;

    // YoY comparison
    const yoyText = document.getElementById('yoyText');
    yoyText.textContent = (stats.yoy_growth_percent >= 0 ? '+' : '') + stats.yoy_growth_percent.toFixed(1) + '% YoY';
    yoyText.className = stats.yoy_growth_percent <= 0 ? 'text-success' : 'text-danger';

    // Transport percentage
    document.getElementById('transportPercent').textContent = stats.transport_split_percent.toFixed(1) + '%';

    // Greenest project
    if (stats.greenest_project) {
        document.getElementById('greenestProject').innerHTML =
            '<small>' + stats.greenest_project.project_name + '</small>';
    }
}

function loadTrend() {
    fetch(`${CONFIG_ROOT}/api/sustainability/trend.php?months=12`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                updateTrendChart(data.data);
                updateSplitChart();
            }
        })
        .catch(err => console.error('Trend error:', err));
}

function updateTrendChart(trendData) {
    const ctx = document.getElementById('trendChart').getContext('2d');

    if (trendChart) trendChart.destroy();

    trendChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: Object.keys(trendData),
            datasets: [{
                label: 'CO₂ (kg)',
                data: Object.values(trendData),
                borderColor: '#28a745',
                backgroundColor: 'rgba(40, 167, 69, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top'
                }
            },
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
}

function updateSplitChart() {
    fetch(`${CONFIG_ROOT}/api/sustainability/emissions.php?period=month`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const ctx = document.getElementById('splitChart').getContext('2d');

                if (splitChart) splitChart.destroy();

                splitChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Transport', 'Energie'],
                        datasets: [{
                            data: [
                                data.data.transport_co2_kg,
                                data.data.energy_co2_kg
                            ],
                            backgroundColor: [
                                '#ffc107',
                                '#17a2b8'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            }
        });
}

// ========== BY PROJECT ==========
function loadProjectEmissions() {
    const from = document.getElementById('projectFromDate').value || new Date(new Date().setMonth(new Date().getMonth() - 1)).toISOString().split('T')[0];
    const to = document.getElementById('projectToDate').value || new Date().toISOString().split('T')[0];

    document.getElementById('projectFromDate').value = from;
    document.getElementById('projectToDate').value = to;

    const params = new URLSearchParams({from, to});
    fetch(`${CONFIG_ROOT}/api/sustainability/by_project.php?${params}`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                updateProjectTable(data.data);
            }
        })
        .catch(err => console.error('Project emissions error:', err));
}

function updateProjectTable(projects) {
    const tbody = document.getElementById('projectEmissionsTable');

    if (!projects || projects.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Keine Daten</td></tr>';
        return;
    }

    tbody.innerHTML = projects.map(p => {
        let badgeClass = 'badge-success';
        if (p.total_co2_kg > 1000) badgeClass = 'badge-danger';
        else if (p.total_co2_kg > 500) badgeClass = 'badge-warning';

        return `
            <tr>
                <td><strong>${p.project_name}</strong></td>
                <td class="text-right">${p.transport_co2_kg.toFixed(2)}</td>
                <td class="text-right">${p.energy_co2_kg.toFixed(2)}</td>
                <td class="text-right"><strong>${p.total_co2_kg.toFixed(2)}</strong></td>
                <td class="text-center">
                    <span class="badge ${badgeClass}">${p.total_co2_kg.toFixed(0)} kg</span>
                </td>
            </tr>
        `;
    }).join('');
}

// ========== BY CLIENT ==========
function loadClients() {
    // This would load from a clients API endpoint
    const clientSelect = document.getElementById('clientSelect');
    // Populate with actual clients from your system
}

function loadClientEmissions() {
    const clientId = document.getElementById('clientSelect').value;
    if (!clientId) {
        document.getElementById('clientMessage').textContent = 'Wählen Sie einen Kunden aus, um seine Nachhaltigkeitsdaten anzuzeigen.';
        return;
    }

    const params = new URLSearchParams({client_id: clientId});
    fetch(`${CONFIG_ROOT}/api/sustainability/by_client.php?${params}`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById('clientTotalCo2').textContent = data.data.total_co2_kg.toFixed(2) + ' kg';
                document.getElementById('clientTransportCo2').textContent = data.data.transport_co2_kg.toFixed(2) + ' kg';
                document.getElementById('clientEnergyCo2').textContent = data.data.energy_co2_kg.toFixed(2) + ' kg';

                document.getElementById('clientMessage').innerHTML = `
                    <strong>${data.data.total_co2_kg.toFixed(2)} kg CO₂</strong> wurden durch
                    <strong>${data.data.project_count}</strong> Projekt(e) für diesen Kunden verursacht.
                `;
            }
        })
        .catch(err => console.error('Client emissions error:', err));
}

// ========== REPORTS ==========
function loadReports() {
    fetch(`${CONFIG_ROOT}/api/sustainability/reports.php`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                updateReportsTable(data.data);
            }
        })
        .catch(err => console.error('Reports error:', err));
}

function updateReportsTable(reports) {
    const tbody = document.getElementById('reportsTable');

    if (!reports || reports.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Keine Berichte vorhanden</td></tr>';
        return;
    }

    tbody.innerHTML = reports.map(r => `
        <tr>
            <td><strong>${r.name}</strong></td>
            <td><span class="badge badge-primary">${r.report_type}</span></td>
            <td>${r.period_start} bis ${r.period_end}</td>
            <td>${new Date(r.created_at).toLocaleDateString('de-DE')}</td>
            <td class="text-center">
                <button class="btn btn-sm btn-info" onclick="viewReport(${r.id})">
                    <i class="fas fa-eye"></i>
                </button>
                ${r.pdf_path ? `
                    <a href="${CONFIG_ROOT}/${r.pdf_path}" class="btn btn-sm btn-danger">
                        <i class="fas fa-download"></i>
                    </a>
                ` : ''}
            </td>
        </tr>
    `).join('');
}

function generateReport(e) {
    e.preventDefault();

    const reportType = document.getElementById('reportType').value;
    const periodStart = document.getElementById('reportStart').value;
    const periodEnd = document.getElementById('reportEnd').value;

    fetch(`${CONFIG_ROOT}/api/sustainability/reports.php`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({report_type: reportType, period_start: periodStart, period_end: periodEnd})
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert('Bericht erfolgreich erstellt!');
            document.getElementById('reportForm').reset();
            $('#generateReportModal').modal('hide');
            loadReports();
        } else {
            alert('Fehler: ' + (data.error || 'Unbekannter Fehler'));
        }
    })
    .catch(err => {
        console.error('Report generation error:', err);
        alert('Fehler beim Erstellen des Berichts');
    });
}

function viewReport(reportId) {
    fetch(`${CONFIG_ROOT}/api/sustainability/report_get.php?id=${reportId}`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const report = data.data;
                document.getElementById('reportDetailTitle').textContent = report.name;

                const reportData = JSON.parse(report.data_json);
                document.getElementById('reportDetailContent').innerHTML = `
                    <dl class="row">
                        <dt class="col-sm-3">Zeitraum</dt>
                        <dd class="col-sm-9">${report.period_start} bis ${report.period_end}</dd>

                        <dt class="col-sm-3">Gesamt CO₂</dt>
                        <dd class="col-sm-9"><strong>${reportData.summary.total_co2_kg}</strong> kg</dd>

                        <dt class="col-sm-3">Transport</dt>
                        <dd class="col-sm-9">${reportData.summary.transport_co2_kg} kg (${reportData.summary.transport_percentage}%)</dd>

                        <dt class="col-sm-3">Energie</dt>
                        <dd class="col-sm-9">${reportData.summary.energy_co2_kg} kg</dd>

                        <dt class="col-sm-3">Projekte</dt>
                        <dd class="col-sm-9">${reportData.summary.projects_count}</dd>
                    </dl>
                `;

                $('#reportDetailModal').modal('show');
            }
        })
        .catch(err => console.error('Report detail error:', err));
}

// ========== CONFIGURATION ==========
function loadConfiguration() {
    fetch(`${CONFIG_ROOT}/api/sustainability/config.php`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const config = data.data;
                document.getElementById('emissionVan').value = config.emission_factors?.van_per_km || 0.21;
                document.getElementById('emissionTruck').value = config.emission_factors?.truck_per_km || 0.35;
                document.getElementById('emissionCar').value = config.emission_factors?.car_per_km || 0.15;
                document.getElementById('kwhPrice').value = config.kwh_price_eur || 0.30;
                document.getElementById('co2PerKwh').value = config.co2_per_kwh || 0.42;
                document.getElementById('enableClientReports').checked = config.enable_client_reports ? true : false;
            }
        })
        .catch(err => console.error('Config load error:', err));
}

function saveConfiguration(e) {
    e.preventDefault();

    const config = {
        emission_factors: {
            van_per_km: parseFloat(document.getElementById('emissionVan').value),
            truck_per_km: parseFloat(document.getElementById('emissionTruck').value),
            car_per_km: parseFloat(document.getElementById('emissionCar').value)
        },
        kwh_price_eur: parseFloat(document.getElementById('kwhPrice').value),
        co2_per_kwh: parseFloat(document.getElementById('co2PerKwh').value),
        enable_client_reports: document.getElementById('enableClientReports').checked
    };

    fetch(`${CONFIG_ROOT}/api/sustainability/config.php`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(config)
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert('Konfiguration gespeichert!');
            loadDashboard();
        } else {
            alert('Fehler: ' + (data.error || 'Unbekannter Fehler'));
        }
    })
    .catch(err => {
        console.error('Config save error:', err);
        alert('Fehler beim Speichern der Konfiguration');
    });
}
</script>
{% endblock %}
