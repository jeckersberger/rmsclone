{% extends "layout.twig" %}

{% block title %}AI Learning System - {{ instance_name }}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="h2">
                <i class="fas fa-brain"></i> AI Learning System
            </h1>
            <p class="text-muted">Monitor AI performance, gather feedback, and improve prompts</p>
        </div>
    </div>

    {# Key Metrics #}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Acceptance Rate (30d)</p>
                            <h3 class="mb-0">{{ (stats.acceptance_rate_30 * 100)|round(1) }}%</h3>
                        </div>
                        <div class="badge" style="background-color: {% if stats.trend_direction == 'up' %}#28a745{% elif stats.trend_direction == 'down' %}#dc3545{% else %}#6c757d{% endif %};">
                            {% if stats.trend_direction == 'up' %}
                                <i class="fas fa-arrow-up"></i> {{ (stats.trend_change_pct)|round(1) }}%
                            {% elseif stats.trend_direction == 'down' %}
                                <i class="fas fa-arrow-down"></i> {{ (stats.trend_change_pct)|round(1) }}%
                            {% else %}
                                <i class="fas fa-minus"></i> Flat
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="text-muted small mb-1">Feedback (30d)</p>
                    <h3 class="mb-2">{{ stats.total_30_days }}</h3>
                    <div class="progress" style="height: 6px;">
                        {% set positive_pct = (stats.by_rating.positive / stats.total_30_days * 100)|round(0) %}
                        {% set negative_pct = (stats.by_rating.negative / stats.total_30_days * 100)|round(0) %}
                        <div class="progress-bar bg-success" role="progressbar" style="width: {{ positive_pct }}%"></div>
                        <div class="progress-bar bg-danger" role="progressbar" style="width: {{ negative_pct }}%"></div>
                        <div class="progress-bar bg-warning" role="progressbar" style="width: {{ 100 - positive_pct - negative_pct }}%"></div>
                    </div>
                    <small class="text-muted">
                        <i class="fas fa-thumbs-up text-success"></i> {{ stats.by_rating.positive }}
                        <i class="fas fa-thumbs-down text-danger"></i> {{ stats.by_rating.negative }}
                        <i class="fas fa-hand-paper text-warning"></i> {{ stats.by_rating.neutral }}
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="text-muted small mb-1">Task Types</p>
                    <h3 class="mb-0">{{ stats.task_types|length }}</h3>
                    <small class="text-muted">Active AI task types</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="text-muted small mb-1">Profile Learnings</p>
                    <h3 class="mb-0">{{ learning_profile|length }}</h3>
                    <small class="text-muted">Patterns detected</small>
                </div>
            </div>
        </div>
    </div>

    {# Acceptance Rate Trend Chart #}
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Acceptance Rate Trend (Last 6 Months)</h5>
                </div>
                <div class="card-body">
                    <div id="acceptanceChart" style="height: 300px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        {# Top Improvements #}
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-arrow-trend-up text-success"></i> Top Improvements
                    </h5>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    {% if improvements|length > 0 %}
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Task Type</th>
                                    <th class="text-end">Improvement</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for improvement in improvements %}
                                    <tr>
                                        <td>
                                            <small>{{ improvement.task_type }}</small>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-success">+{{ improvement.improvement_pct }}%</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="text-muted small mb-0">No improvements detected yet</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Areas Needing Attention #}
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-circle text-danger"></i> Areas Needing Attention
                    </h5>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    {% if needs_attention|length > 0 %}
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Task Type</th>
                                    <th class="text-end">Acceptance</th>
                                    <th class="text-end">Top Issue</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in needs_attention %}
                                    <tr>
                                        <td>
                                            <small>{{ item.task_type }}</small>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-danger">{{ (item.acceptance_rate * 100)|round(0) }}%</span>
                                        </td>
                                        <td class="text-end">
                                            <small class="text-muted">{{ item.top_issue }}</small>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="text-muted small mb-0">All task types performing well!</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        {# Few-Shot Examples Library #}
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Few-Shot Examples Library</h5>
                    {% if perms.hasPerm('AI:CONFIGURE') %}
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addExampleModal">
                            <i class="fas fa-plus"></i> Add Example
                        </button>
                    {% endif %}
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Task Type</th>
                                <th>Input Preview</th>
                                <th>Status</th>
                                <th class="text-center">Votes</th>
                                <th class="text-center">Usage</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="examplesTableBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="fas fa-spinner fa-spin"></i> Loading examples...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        {# Prompt Version History #}
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Prompt Version History</h5>
                    {% if perms.hasPerm('AI:CONFIGURE') %}
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createPromptModal">
                            <i class="fas fa-plus"></i> Create Version
                        </button>
                    {% endif %}
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Task Type</th>
                                <th>Version</th>
                                <th>Source</th>
                                <th class="text-end">Acceptance</th>
                                <th class="text-end">Uses</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="promptsTableBody">
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="fas fa-spinner fa-spin"></i> Loading versions...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        {# Learning Profile Display #}
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-pie"></i> Learned User Preferences
                    </h5>
                </div>
                <div class="card-body">
                    {% if learning_profile|length > 0 %}
                        <div class="row">
                            {% for profile in learning_profile %}
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex justify-content-between align-items-center p-2 border-bottom">
                                        <div>
                                            <strong>{{ profile.profile_key|replace('_', ' ')|capitalize }}</strong>
                                            <br>
                                            <small class="text-muted">{{ profile.profile_value }}</small>
                                        </div>
                                        <div class="text-end">
                                            <div class="progress" style="width: 80px; height: 6px;">
                                                <div class="progress-bar bg-info" role="progressbar" style="width: {{ (profile.confidence * 100)|round(0) }}%"></div>
                                            </div>
                                            <small class="text-muted">{{ (profile.confidence * 100)|round(0) }}%</small>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">No patterns detected yet. More feedback will help us learn your preferences.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# Modals #}
{% if perms.hasPerm('AI:CONFIGURE') %}
    <!-- Add Few-Shot Example Modal -->
    <div class="modal fade" id="addExampleModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Few-Shot Example</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="addExampleForm">
                        <div class="mb-3">
                            <label for="exampleTaskType" class="form-label">Task Type</label>
                            <input type="text" class="form-control" id="exampleTaskType" placeholder="email_draft, invoice_scan, etc." required>
                        </div>
                        <div class="mb-3">
                            <label for="exampleInput" class="form-label">Input Context</label>
                            <textarea class="form-control" id="exampleInput" rows="3" placeholder="The input/prompt for this example" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="exampleOutput" class="form-label">Output Example</label>
                            <textarea class="form-control" id="exampleOutput" rows="3" placeholder="The desired output for this input" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="submitExampleBtn">Add Example</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Create Prompt Version Modal -->
    <div class="modal fade" id="createPromptModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Prompt Version</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="createPromptForm">
                        <div class="mb-3">
                            <label for="promptTaskType" class="form-label">Task Type</label>
                            <input type="text" class="form-control" id="promptTaskType" placeholder="email_draft, invoice_scan, etc." required>
                        </div>
                        <div class="mb-3">
                            <label for="promptText" class="form-label">System Prompt</label>
                            <textarea class="form-control" id="promptText" rows="5" placeholder="Enter the system prompt..." required></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="promptReason" class="form-label">Change Reason</label>
                            <input type="text" class="form-control" id="promptReason" placeholder="Why are you creating this version?" required>
                        </div>
                        <div class="mb-3">
                            <label for="promptSource" class="form-label">Source</label>
                            <select class="form-select" id="promptSource" required>
                                <option value="">Select source...</option>
                                <option value="manual">Manual</option>
                                <option value="automatic">Automatic Optimization</option>
                                <option value="ab_test">A/B Test</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="submitPromptBtn">Create Version</button>
                </div>
            </div>
        </div>
    </div>
{% endif %}

<script>
// Load few-shot examples
async function loadExamples() {
    try {
        const response = await fetch('/api/ai/few_shot_examples?task_type=email_draft&limit=20');
        const data = await response.json();

        if (data.success && data.examples) {
            const tbody = document.getElementById('examplesTableBody');
            tbody.innerHTML = data.examples.map(ex => `
                <tr>
                    <td>${ex.task_type}</td>
                    <td><small>${(ex.input_context).substring(0, 50)}...</small></td>
                    <td>${ex.is_active ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>'}</td>
                    <td class="text-center">
                        <i class="fas fa-thumbs-up text-success"></i> ${ex.positive_votes}
                        <i class="fas fa-thumbs-down text-danger"></i> ${ex.negative_votes}
                    </td>
                    <td class="text-center">${ex.usage_count}</td>
                    <td class="text-center">
                        <button class="btn btn-xs btn-outline-primary" title="Vote positive">+1</button>
                        <button class="btn btn-xs btn-outline-danger" title="Vote negative">-1</button>
                    </td>
                </tr>
            `).join('');
        }
    } catch (error) {
        console.error('Error loading examples:', error);
    }
}

// Load prompt versions
async function loadPrompts() {
    try {
        const response = await fetch('/api/ai/prompt_versions?task_type=email_draft');
        const data = await response.json();

        if (data.success && data.versions) {
            const tbody = document.getElementById('promptsTableBody');
            tbody.innerHTML = data.versions.map(v => `
                <tr>
                    <td>${v.task_type}</td>
                    <td>v${v.version}</td>
                    <td><small class="badge bg-info">${v.change_source}</small></td>
                    <td class="text-end">${v.acceptance_rate ? (v.acceptance_rate * 100).toFixed(1) + '%' : 'N/A'}</td>
                    <td class="text-end">${v.total_uses}</td>
                    <td>${v.is_active ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>'}</td>
                    <td class="text-center">
                        ${!v.is_active ? `<button class="btn btn-xs btn-success" title="Activate">Activate</button>` : ''}
                    </td>
                </tr>
            `).join('');
        }
    } catch (error) {
        console.error('Error loading prompts:', error);
    }
}

// Load data on page load
document.addEventListener('DOMContentLoaded', function() {
    loadExamples();
    loadPrompts();

    // Chart initialization (requires chart library)
    const chartData = {{ trend_data|json_encode|raw }};
    if (typeof Chart !== 'undefined' && chartData.length > 0) {
        const ctx = document.getElementById('acceptanceChart')?.getContext('2d');
        if (ctx) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: chartData.map(d => d.week),
                    datasets: [{
                        label: 'Acceptance Rate',
                        data: chartData.map(d => d.rate * 100),
                        borderColor: '#007bff',
                        backgroundColor: 'rgba(0, 123, 255, 0.1)',
                        tension: 0.4,
                        fill: true,
                        pointRadius: 3,
                        pointBackgroundColor: '#007bff',
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true, position: 'top' }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: { callback: value => value + '%' }
                        }
                    }
                }
            });
        }
    }

    // Add example submission
    document.getElementById('submitExampleBtn')?.addEventListener('click', async function() {
        const form = document.getElementById('addExampleForm');
        const data = {
            task_type: document.getElementById('exampleTaskType').value,
            input_context: document.getElementById('exampleInput').value,
            output_example: document.getElementById('exampleOutput').value,
        };

        try {
            const response = await fetch('/api/ai/few_shot_examples', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });

            if (response.ok) {
                alert('Example added successfully!');
                form.reset();
                bootstrap.Modal.getInstance(document.getElementById('addExampleModal')).hide();
                loadExamples();
            }
        } catch (error) {
            alert('Error adding example');
        }
    });

    // Create prompt submission
    document.getElementById('submitPromptBtn')?.addEventListener('click', async function() {
        const data = {
            task_type: document.getElementById('promptTaskType').value,
            system_prompt: document.getElementById('promptText').value,
            change_reason: document.getElementById('promptReason').value,
            change_source: document.getElementById('promptSource').value,
        };

        try {
            const response = await fetch('/api/ai/prompt_versions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });

            if (response.ok) {
                alert('Prompt version created!');
                document.getElementById('createPromptForm').reset();
                bootstrap.Modal.getInstance(document.getElementById('createPromptModal')).hide();
                loadPrompts();
            }
        } catch (error) {
            alert('Error creating prompt');
        }
    });
});
</script>
{% endblock %}
