{% extends "assets/template.twig" %}
{% block content %}
<div class="row">
    <div class="col-md-12 col-lg-8 offset-lg-2">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-download mr-2"></i>System-Update</h3>
                <div class="card-tools">
                    <span class="badge badge-info" id="currentBranch">--</span>
                </div>
            </div>
            <div class="card-body">
                <div id="statusArea">
                    <div class="text-center py-4">
                        <i class="fas fa-sync fa-spin fa-2x text-muted"></i>
                        <p class="mt-2 text-muted">Prüfe auf Updates...</p>
                    </div>
                </div>

                <div id="upToDate" style="display:none;">
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-3x text-success"></i>
                        <h5 class="mt-3">System ist aktuell</h5>
                        <p class="text-muted">
                            Aktuelle Version: <code id="currentCommitOk">--</code>
                        </p>
                    </div>
                </div>

                <div id="updateAvailable" style="display:none;">
                    <div class="callout callout-info">
                        <h5><i class="fas fa-info-circle mr-1"></i> Update verfügbar</h5>
                        <p>
                            Aktuell: <code id="currentCommitUpdate">--</code> &rarr;
                            Neu: <code id="remoteCommit">--</code>
                            (<span id="commitCount">0</span> neue Commits)
                        </p>
                    </div>

                    <div id="updateWarnings"></div>

                    <h6>Neue Änderungen:</h6>
                    <div class="card card-outline card-secondary">
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush" id="commitList"></ul>
                        </div>
                    </div>

                    <button class="btn btn-primary btn-block mt-3" id="pullButton">
                        <i class="fas fa-download mr-1"></i> Update jetzt installieren
                    </button>
                </div>

                <div id="updateRunning" style="display:none;">
                    <div class="text-center py-4">
                        <i class="fas fa-cog fa-spin fa-2x text-primary"></i>
                        <h5 class="mt-3" id="updateRunningTitle">Update wird installiert...</h5>
                        <p class="text-muted" id="updateRunningSubtitle">Bitte warten und die Seite nicht verlassen.</p>
                        <div class="mt-3" id="updateSteps"></div>
                    </div>
                </div>

                <div id="updateSuccess" style="display:none;">
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-3x text-success"></i>
                        <h5 class="mt-3">Update erfolgreich installiert & Anwendung neu gestartet!</h5>
                        <p class="text-muted">
                            Neue Version: <code id="newCommit">--</code>
                        </p>
                    </div>
                    <div class="mt-3">
                        <h6>Durchgeführte Schritte:</h6>
                        <ul class="list-group" id="stepResults"></ul>
                    </div>
                    <div class="text-center mt-3">
                        <button class="btn btn-primary" onclick="location.reload();">
                            <i class="fas fa-redo mr-1"></i> Seite neu laden
                        </button>
                    </div>
                </div>

                <div id="updateError" style="display:none;">
                    <div class="text-center py-4">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                        <h5 class="mt-3">Update fehlgeschlagen</h5>
                        <p class="text-danger" id="errorMessage"></p>
                        <button class="btn btn-default mt-3" onclick="location.reload();">
                            <i class="fas fa-redo mr-1"></i> Erneut versuchen
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-footer text-muted text-sm">
                <i class="fas fa-info-circle mr-1"></i>
                Das Update zieht Aenderungen vom konfigurierten Git-Remote (<code>{{ CONFIG.UPDATE_GIT_REMOTE|default('origin') }}</code> / <code>{{ CONFIG.UPDATE_GIT_BRANCH|default('main') }}</code>), fuehrt Composer-Install, Datenbank-Migrationen und einen Apache-Neustart automatisch durch.
                <br>
                <small>Version: <code id="versionInfo">-</code> | Remote/Branch konfigurierbar unter Server-Admin &rarr; Konfiguration &rarr; Updates</small>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    checkForUpdates();

    function checkForUpdates() {
        ajaxcall("server/update.php", {"action": "check"}, function(data) {
            var r = data.response;
            $("#statusArea").hide();
            $("#currentBranch").text(r.currentBranch);
            if (r.currentVersion) $("#versionInfo").text(r.currentVersion + ' (' + r.currentCommit + ')');

            if (r.updateAvailable) {
                $("#currentCommitUpdate").text(r.currentCommit);
                $("#remoteCommit").text(r.remoteCommit);
                $("#commitCount").text(r.commitCount);

                // Show warnings for migrations/composer changes
                var warnings = '';
                if (r.hasMigrations) {
                    warnings += '<div class="callout callout-warning"><i class="fas fa-database mr-1"></i> Dieses Update enthält <b>Datenbank-Migrationen</b>. Diese werden automatisch ausgeführt.</div>';
                }
                if (r.hasComposerChanges) {
                    warnings += '<div class="callout callout-warning"><i class="fas fa-box mr-1"></i> Dieses Update enthält <b>Abhängigkeits-Änderungen</b> (composer.lock). Composer install wird automatisch ausgeführt.</div>';
                }
                if (warnings) {
                    $("#updateWarnings").html(warnings);
                }

                var list = $("#commitList");
                list.empty();
                for (var i = 0; i < r.newCommits.length; i++) {
                    var parts = r.newCommits[i].split(' ');
                    var hash = parts.shift();
                    var msg = parts.join(' ');
                    list.append(
                        '<li class="list-group-item">' +
                            '<code class="mr-2">' + hash + '</code>' +
                            '<span>' + $('<span>').text(msg).html() + '</span>' +
                        '</li>'
                    );
                }
                $("#updateAvailable").show();
            } else {
                $("#currentCommitOk").text(r.currentCommit);
                $("#upToDate").show();
            }
        }, false);
    }

    function showStep(text, icon) {
        $("#updateSteps").append(
            '<div class="text-muted text-sm mb-1"><i class="fas ' + icon + ' mr-1"></i> ' + text + '</div>'
        );
    }

    $("#pullButton").click(function() {
        bootbox.confirm({
            title: "Update installieren?",
            message: "Das System wird vom konfigurierten Git-Remote aktualisiert.<br><br>" +
                     "<b>Folgende Schritte werden automatisch durchgeführt:</b>" +
                     "<ol class='mt-2'>" +
                     "<li>Lokale Änderungen sichern (git stash)</li>" +
                     "<li>Neue Version herunterladen (git pull)</li>" +
                     "<li>PHP-Abhängigkeiten aktualisieren (composer install)</li>" +
                     "<li>Datenbank-Migrationen ausführen</li>" +
                     "<li>Caches leeren (OPcache & Twig)</li>" +
                     "<li>Apache neu starten</li>" +
                     "</ol>",
            buttons: {
                confirm: { label: '<i class="fas fa-download mr-1"></i> Update starten', className: 'btn-primary' },
                cancel: { label: 'Abbrechen', className: 'btn-default' }
            },
            callback: function(result) {
                if (result) {
                    $("#updateAvailable").hide();
                    $("#updateRunning").show();

                    showStep("Lokale Änderungen werden gesichert...", "fa-archive");
                    showStep("Code wird heruntergeladen...", "fa-download");

                    ajaxcall("server/update.php", {"action": "pull"}, function(data) {
                        var r = data.response;

                        // Show pull results
                        showStep("Code aktualisiert auf " + r.newCommit, "fa-check text-success");
                        showStep("Abhängigkeiten & Migrationen abgeschlossen", "fa-check text-success");
                        showStep("Caches geleert", "fa-check text-success");

                        // Now restart Apache
                        $("#updateRunningTitle").text("Anwendung wird neu gestartet...");
                        $("#updateRunningSubtitle").text("Apache wird neu geladen...");
                        showStep("Apache Neustart wird ausgelöst...", "fa-sync fa-spin");

                        ajaxcall("server/update.php", {"action": "restart"}, function(restartData) {
                            $("#updateRunning").hide();
                            $("#newCommit").text(r.newCommit);

                            // Show step results
                            var stepList = $("#stepResults");
                            if (r.steps) {
                                for (var i = 0; i < r.steps.length; i++) {
                                    var isOk = r.steps[i].indexOf("OK") !== -1 ||
                                               r.steps[i].indexOf("geleert") !== -1 ||
                                               r.steps[i].indexOf("Already") !== -1;
                                    stepList.append(
                                        '<li class="list-group-item">' +
                                            '<i class="fas ' + (isOk ? 'fa-check-circle text-success' : 'fa-info-circle text-info') + ' mr-2"></i>' +
                                            '<span>' + $('<span>').text(r.steps[i]).html() + '</span>' +
                                        '</li>'
                                    );
                                }
                            }
                            stepList.append(
                                '<li class="list-group-item">' +
                                    '<i class="fas fa-check-circle text-success mr-2"></i>' +
                                    '<span>Apache neu gestartet</span>' +
                                '</li>'
                            );

                            $("#updateSuccess").show();
                        }, false);
                    }, false);
                }
            }
        });
    });
});
</script>
{% endblock %}
