# ==============================================================================
# RMS Clone - Synology DiskStation Konfiguration
# ==============================================================================
# Kopiere diese Datei:  cp .env.synology.example .env.synology
# Dann die Werte anpassen!
# ==============================================================================

# --- Ports (müssen sich von der Originalversion unterscheiden!) --------------
# App-Port (Original nutzt vermutlich 80/443, wir nehmen 8090)
APP_PORT=8090
# DB-Port extern (Original nutzt vermutlich 3306, wir nehmen 3307)
DB_EXTERNAL_PORT=3307

# --- URL ---------------------------------------------------------------------
# Wenn du den Synology Reverse Proxy nutzt mit eigener Domain:
#   ROOT_URL=https://rmsclone.deine-domain.de
# Sonst einfach die NAS-IP mit Port:
ROOT_URL=http://DEINE-NAS-IP:8090

# --- Projekt-Name ------------------------------------------------------------
CONFIG_PROJECT_NAME=RMS Clone
CONFIG_TIMEZONE=Europe/Berlin

# --- Datenbank ---------------------------------------------------------------
# WICHTIG: Andere Namen als die Originalversion verwenden!
DB_DATABASE=rmsclone
DB_USERNAME=rmsclone
DB_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN
MYSQL_ROOT_PASSWORD=HIER_ROOT_PASSWORT_EINTRAGEN

# --- Authentifizierung -------------------------------------------------------
# JWT-Key generieren mit: openssl rand -hex 32
CONFIG_AUTH_JWTKey=HIER_KEY_GENERIEREN

# --- Dateien -----------------------------------------------------------------
CONFIG_FILES_ENABLED=Enabled

# --- E-Mail (optional, kann auch deaktiviert bleiben) ------------------------
CONFIG_EMAILS_ENABLED=Disabled
# CONFIG_EMAILS_PROVIDER=SMTP
# CONFIG_EMAILS_FROMEMAIL=noreply@example.com
# CONFIG_EMAILS_SMTP_SERVER=smtp.example.com
# CONFIG_EMAILS_SMTP_PORT=587

# --- Telemetrie --------------------------------------------------------------
CONFIG_TELEMETRY_NANOID=synology_clone
