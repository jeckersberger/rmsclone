# ==============================================================================
# MyRMS - Cloudflare Tunnel Deployment
# ==============================================================================
# Erreichbar unter: https://dash.je-soundulight
#
# Setup: bash scripts/setup-cloudflare.sh
# Start: docker compose -f docker-compose.cloudflare.yml --env-file .env.cloudflare up -d
# ==============================================================================

# --- Cloudflare Tunnel -------------------------------------------------------
# Token aus dem Cloudflare Zero Trust Dashboard:
# https://one.dash.cloudflare.com → Zero Trust → Networks → Tunnels
# Tunnel erstellen → Token kopieren
CLOUDFLARE_TUNNEL_TOKEN=DEIN_TUNNEL_TOKEN_HIER

# --- Domain ------------------------------------------------------------------
APP_DOMAIN=dash.je-soundulight
ROOT_URL=https://dash.je-soundulight
CORS_ALLOWED_ORIGIN=https://dash.je-soundulight

# --- Projekt -----------------------------------------------------------------
CONFIG_PROJECT_NAME=MyRMS
CONFIG_TIMEZONE=Europe/Berlin

# --- Datenbank ---------------------------------------------------------------
DB_HOSTNAME=db
DB_DATABASE=myrms
DB_USERNAME=myrms
DB_PASSWORD=WIRD_AUTOMATISCH_GENERIERT
DB_PORT=3306
MYSQL_ROOT_PASSWORD=WIRD_AUTOMATISCH_GENERIERT

# --- Authentifizierung -------------------------------------------------------
# JWT-Schlüssel (wird automatisch generiert vom Setup-Script)
CONFIG_AUTH_JWTKey=WIRD_AUTOMATISCH_GENERIERT

# --- Datei-Speicher ----------------------------------------------------------
CONFIG_FILES_ENABLED=Enabled
LOCAL_STORAGE_PATH=/var/www/html/storage

# --- E-Mail / SMTP -----------------------------------------------------------
CONFIG_EMAILS_ENABLED=Enabled
CONFIG_EMAILS_PROVIDER=SMTP
CONFIG_EMAILS_FROMEMAIL=noreply@je-soundulight
CONFIG_EMAILS_SMTP_SERVER=smtp.example.com
CONFIG_EMAILS_SMTP_PORT=587
# CONFIG_EMAILS_SMTP_USERNAME=
# CONFIG_EMAILS_SMTP_PASSWORD=

# --- Telemetrie --------------------------------------------------------------
CONFIG_TELEMETRY_NANOID=cloudflare_prod
