# ==============================================================================
# MyRMS - Production Environment Variables
# ==============================================================================
# Copy this file to .env.prod and fill in the values for your environment.
# This file is used by docker-compose.prod.yml.
# ==============================================================================

# --- Domain / URLs -----------------------------------------------------------
# The public domain name where MyRMS will be reachable (no trailing slash)
APP_DOMAIN=rms.example.com
ROOT_URL=https://rms.example.com
CORS_ALLOWED_ORIGIN=https://rms.example.com

# --- Project Branding --------------------------------------------------------
CONFIG_PROJECT_NAME=MyRMS
CONFIG_TIMEZONE=Europe/Berlin

# --- Database ----------------------------------------------------------------
DB_HOSTNAME=db
DB_DATABASE=myrms
DB_USERNAME=myrms
DB_PASSWORD=CHANGE_ME_secure_password_here
DB_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_here

# --- Authentication ----------------------------------------------------------
# 64-character hex key used for JWT signing (generate with: openssl rand -hex 32)
CONFIG_AUTH_JWTKey=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- File Storage ------------------------------------------------------------
CONFIG_FILES_ENABLED=Enabled
LOCAL_STORAGE_PATH=/var/www/html/storage

# Optional: S3-compatible object storage (leave blank to use local storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_BUCKET=myrms-files
# AWS_ENDPOINT=                # For MinIO / Wasabi / other S3-compatible services

# --- Email / SMTP ------------------------------------------------------------
CONFIG_EMAILS_ENABLED=Enabled
CONFIG_EMAILS_PROVIDER=SMTP
CONFIG_EMAILS_FROMEMAIL=noreply@example.com
CONFIG_EMAILS_SMTP_SERVER=smtp.example.com
CONFIG_EMAILS_SMTP_PORT=587
# CONFIG_EMAILS_SMTP_USERNAME=
# CONFIG_EMAILS_SMTP_PASSWORD=
# CONFIG_EMAILS_SMTP_ENCRYPTION=tls

# Alternative providers (uncomment the one you use):
# CONFIG_EMAILS_PROVIDER=Sendgrid
# CONFIG_EMAILS_SENDGRID_APIKEY=

# CONFIG_EMAILS_PROVIDER=Mailgun
# CONFIG_EMAILS_MAILGUN_APIKEY=
# CONFIG_EMAILS_MAILGUN_DOMAIN=

# CONFIG_EMAILS_PROVIDER=Postmark
# CONFIG_EMAILS_POSTMARK_SERVERTOKEN=

# --- Error Reporting (Sentry) ------------------------------------------------
# Leave blank to disable
# CONFIG_ERRORS_PROVIDERS_SENTRY=https://xxx@sentry.io/yyy

# --- Telemetry ---------------------------------------------------------------
CONFIG_TELEMETRY_NANOID=prod_instance_01

# --- Monitoring / Alerting ---------------------------------------------------
# Email address to receive health-monitor alerts
ALERT_EMAIL=admin@example.com

# --- Backup ------------------------------------------------------------------
# Number of days to keep local database backups (default: 30)
BACKUP_RETENTION_DAYS=30

# Optional: S3 bucket for off-site backups
# BACKUP_S3_BUCKET=myrms-backups
# BACKUP_S3_REGION=eu-central-1

# --- SSL (Let's Encrypt) -----------------------------------------------------
# Email used for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=admin@example.com
